{
  "name": "vitalcv",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "design:guard": "node scripts/design-guard.js",
    "build:web": "pnpm --filter web build",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=1 run typecheck",
    "lint": "pnpm design:guard && turbo lint",
    "test": "turbo test",
    "build": "pnpm design:guard && pnpm turbo build",
    "load:test": "node scripts/loadTest.js",
    "profile:load": "node --inspect scripts/loadTest.js",
    "report:public-copy": "node scripts/report-public-entry-copy-sources.js",
    "test:backend:db": "bash scripts/backend-test-db.sh"
  },
  "devDependencies": {
    "@types/node": "^20",
    "next": "15.2.8",
    "turbo": "^2.7.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    }
  }
}
