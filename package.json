{
  "name": "vitalcv",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:web": "pnpm --filter web build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "build": "turbo build",
    "test:backend:db": "bash scripts/backend-test-db.sh"
  },
  "devDependencies": {
    "@types/node": "^20",
    "next": "15.2.8",
    "turbo": "^2.7.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    }
  }
}
