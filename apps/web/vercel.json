{
  "framework": "nextjs",
  "installCommand": "npm install -g pnpm@10.6.1 && cd ../.. && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@vitalcv/web...",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/api/deploy-info",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
