# apps/web — environment variables for Railway deployment.
#
# Required: Clerk only. Everything else is optional with sensible
# defaults. Copy to .env.local for development; set in the Railway
# service dashboard for production.
#
# See apps/web/lib/env.ts for the canonical schema.

# ── REQUIRED ─────────────────────────────────────────────────────────

# Clerk auth. Get keys from https://dashboard.clerk.com/.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Receipt issuer ES256 keypair. REQUIRED in production
# (NODE_ENV=production); the issuer fails closed and refuses to mint
# an ephemeral dev keypair on a production runtime. Without these,
# every issuer-chain route (/.well-known/jwks.json, did.json,
# trust-register, /trust, /trust/doctrine) returns 500.
#
# Generate ONCE with: node scripts/generate-receipt-keypair.mjs
# Paste both lines into the Railway service Variables tab.
# Treat the private JWK as a secret; never commit to git.
RECEIPT_KID=
RECEIPT_PRIVATE_KEY_JWK=

# ── RAILWAY RUNTIME ─────────────────────────────────────────────────

# PORT is injected by Railway automatically. Do NOT set this.
# PORT=

# Set NODE_ENV=production in the Railway service dashboard.
# NODE_ENV=production

# ── OPTIONAL ────────────────────────────────────────────────────────

# Canonical app URL (used by share-link generators + OAuth callbacks).
# Falls back to request origin when unset.
# NEXT_PUBLIC_APP_URL=https://vitalcv.com

# Backend API origin. REQUIRED on Railway: set to
# https://api.vitalcv.com. The Dockerfile bakes this default in via
# ARG NEXT_PUBLIC_API_BASE, but Railway uses Nixpacks (not Docker)
# and does NOT inherit Dockerfile ARGs. Without this var,
# server-side proxy routes + 3 client components fall through to
# http://localhost:4000.
NEXT_PUBLIC_API_BASE=https://api.vitalcv.com

# External API base URL (advisory). When unset, internal /api/* is used.
# NEXT_PUBLIC_API_URL=

# Backend service URL (e.g. the Railway API service). The pilot
# funnel uses this when set; otherwise a local fallback.
# NEXT_PUBLIC_BACKEND_URL=
# BACKEND_URL=

# Custom Clerk routes (defaults to Clerk hosted UI).
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sentry build-time + runtime instrumentation. When unset, Sentry
# is skipped entirely; the build does not require it.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ── AI (optional) ───────────────────────────────────────────────────
# AI features are OFF unless ANTHROPIC_API_KEY is set. When unset,
# every AI path degrades honestly (the cover-letter drafter returns
# { configured: false } and the UI shows "AI drafting isn't enabled
# here"); matching runs fully on the deterministic engine regardless.
# Setting this key is the ONLY step to turn AI on — no code change.
# Single gate: apps/web/lib/ai/anthropic.ts. Create a key at
# https://console.anthropic.com/ and set it in the Railway web service.
# ANTHROPIC_API_KEY=
# Optional model override for the cover-letter drafter (default claude-opus-4-8).
# COVER_LETTER_MODEL=

# Prisma. The web app prisma schema is read-only (generates the
# typed client). DATABASE_URL is only required if any runtime
# code path actually executes a Prisma query. For a public-only
# launch, leave unset; Prisma client generation does NOT require
# a reachable database.
# DATABASE_URL=

# Issuer host (used by /.well-known/did.json and openid-credential-
# issuer routes for per-request host canonicalization). When
# unset, the request Host header is used.
# VCV_ISSUER_HOST=vitalcv.com

# Vercel-specific env vars (VERCEL_GIT_COMMIT_SHA, VERCEL_ENV, etc.)
# are read defensively by the runtime-health route and return null
# when unset. Railway does NOT need to set them.
