# ── API Connection ────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are embedded into the client bundle at build time.
# Change these BEFORE building, not at runtime.
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ── Feature Flags ─────────────────────────────────────────────────────
NEXT_PUBLIC_ENTERPRISE_MODE=false
# NEXT_PUBLIC_DEMO_MODE=true

# ── Clerk Authentication ──────────────────────────────────────────────
# Get these from https://dashboard.clerk.com
# Production keys use pk_live_ / sk_live_ prefixes.
# Dev/staging keys use pk_test_ / sk_test_ prefixes.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Route paths — must match Clerk dashboard "Paths" configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Post-auth redirect destinations (role-based landing handled by middleware)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Observability (optional) ──────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
