// apps/web Prisma schema — web-app-facing subset only.
//
// This schema mirrors the models that the web app reads directly.
// Migrations are managed by apps/api/backend/prisma; these model
// definitions must stay in sync with that schema. The tables are
// shared — there is one database.
//
// Truth-contract CHECK constraints live in the apps/api/backend
// migrations and are NOT duplicated here:
//   * ReceiptCandidate.decisionGrade = FALSE
//   * ReceiptCandidate.proofTier IS NULL OR = 'receipt_candidate'
//   * ReceiptCandidate.recordedBy IN ('demo','review_surface','system')
// See apps/api/backend/prisma/migrations/20260504000000_issuer_persistence_scaffold/migration.sql
// (landed in PR #221). The web schema is read-only for type generation;
// it cannot weaken those database-level invariants.
//
// Run `pnpm --filter @vitalcv/web exec prisma generate` after
// any model change here to regenerate the typed client.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IssuerRequest {
  id              String    @id @default(uuid()) @db.Uuid
  requestId       String    @unique
  claimType       String
  claimSummary    String
  issuerCandidate Json
  route           Json
  consent         Json
  status          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  receiptCandidates ReceiptCandidate[]

  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

model ReceiptCandidate {
  id          String         @id @default(uuid()) @db.Uuid
  candidateId String         @unique
  requestId   String?
  request     IssuerRequest? @relation(fields: [requestId], references: [requestId])

  basis                  String
  agentName              String?
  sourceOrganizationName String

  attributionStatus String

  decisionGrade Boolean @default(false)
  proofTier     String?

  notes              String?
  limitationNote     String?
  responseStatus     String?
  responseSummary    String?
  responseReceivedAt DateTime?
  reviewState        String?

  recordedBy String @default("demo")

  signedReceiptJwt String?

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([requestId])
  @@index([reviewState])
  @@index([createdAt])
}

// MATCHA career preferences / Career DNA — mirror of the backend model (one
// shared DB; migration + source of truth live in apps/api/backend/prisma).
// The web app reads/writes this table directly via an auth-scoped route, keyed
// by the authenticated Clerk user id. `data` is the sanitized MatchaPreferences
// bag (self-stated, editable preferences — never credentials or evidence).
model MatchaPreference {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId])
}

// Wave Q — durable commercial lead capture (mirror of the backend model;
// migration lives in apps/api/backend/prisma/migrations/20260705120000_pilot_leads).
// One row per submitted pilot request / pilot intake, paired with an
// AuditEvent at insert. Operational CRM-lite, never evidence.
model PilotLead {
  id             String   @id @default(uuid()) @db.Uuid
  source         String // pilot_request | pilot_intake
  persona        String?
  organization   String
  contactName    String?
  email          String
  message        String?
  workflowTarget String?
  sourceContext  String?
  payload        Json
  slackDelivered Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([email])
}

// Wave K — clinician Save / Connect / Decline decisions on MATCHA
// opportunities (mirror of the backend model; migrations live in
// apps/api/backend/prisma/migrations/20260705000000_opportunity_actions and
// .../20260717000000_opportunity_signal_fields).
// Append-only: every decision (including clearing one back to "new") is a
// NEW row; current state = latest row per (clerkUserId, opportunityId).
// These are the clinician's own workflow decisions — never credentials,
// never verification state.
//
// PR J2 — MATCHA Discover (the swipe deck) writes here too, so a role saved
// on the board is the same role the deck shows as decided. Read the log
// through apps/web/lib/matcha/opportunitySignals.ts (canonical vocabulary +
// current-state derivation), never by casting `action` at a call site.
model OpportunityAction {
  id            String   @id @default(uuid()) @db.Uuid
  clerkUserId   String
  npi           String?
  opportunityId String
  action        String
  source        String   @default("web")
  createdAt     DateTime @default(now())
  // PR J2 fields — additive + nullable, so every pre-deck row stays valid.
  surface            String   @default("board")
  opportunityVersion String?
  recommendationId   String?
  sessionId          String?
  reason             String?
  clientSignalId     String?  @unique

  @@index([clerkUserId, opportunityId, createdAt])
  @@index([opportunityId])
  @@index([createdAt])
  @@index([clerkUserId, surface, createdAt])
}

// Mirror of the backend AuditEvent model (one shared DB; migrations owned by
// apps/api/backend/prisma). The web app APPENDS audit rows for the mutations
// it owns (audit-first rule) — it never updates or deletes them, and never
// anchors (anchored/merkleRoot are written by backend anchoring jobs only).
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  type           String
  hash           String
  referenceId    String?
  clinicianId    String?
  metadata       Json?
  createdAt      DateTime @default(now())
  organizationId String?
  anchored       Boolean  @default(false)
  merkleRoot     String?

  @@index([type, createdAt])
  @@index([clinicianId])
  @@index([referenceId])
  @@index([organizationId])
  @@index([anchored])
  @@index([merkleRoot])
}

/// D4 — probe-observed availability ledger. MIRROR of the backend model.
///
/// apps/web/prisma/schema.prisma has NO migrations directory: railway.toml runs
/// `prisma migrate deploy` against apps/api/backend ONLY. Both schemas point at
/// the same DATABASE_URL, so every model here is a client-side VIEW of a table
/// the backend migration created. Adding a model here alone would generate a
/// client for a table that does not exist.
///
/// Keep in sync with apps/api/backend/prisma/schema.prisma → AvailabilitySample
/// and migration 20260727000000_availability_samples.
model AvailabilitySample {
  id          String   @id @default(uuid()) @db.Uuid
  laneId      String   @map("lane_id")
  ok          Boolean
  state       String
  latencyMs   Int?     @map("latency_ms")
  probeSource String   @map("probe_source")
  observedAt  DateTime @map("observed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([laneId, observedAt])
  @@index([observedAt])
  @@map("availability_samples")
}

// FOUNDER WAVE A0 — Start Agent telemetry (mirror of the backend models;
// migration lives in apps/api/backend/prisma/migrations/20260807000000_agent_telemetry).
// The web app writes these from apps/web/lib/agent/telemetry/agent-run-store.ts,
// paired with an AuditEvent append in the same transaction. Append-only from
// web: runs and events are never updated or deleted here. Structured plan
// payloads carry evidence REFS and template text only — never raw credential
// values (see the privacy notes on the backend models).
model AgentRun {
  id                 String           @id @default(uuid()) @db.Uuid
  planId             String           @map("plan_id")
  /// A2.1 — what caused this run. `event` is reserved for A2.2+.
  trigger            String           @default("interactive")
  /// A2.2 — the prior run this one was diffed against. Added WITH its writer.
  deltaFromRunId     String?          @map("delta_from_run_id") @db.Uuid
  /// A2.2 — decision-relevant projection, the only thing deltas compare.
  decisionProjection Json?            @map("decision_projection")
  /// A2.2 — hash of the DECISION content only (no clocks, no observedAt).
  decisionFingerprint String?         @map("decision_fingerprint")
  /// A2.0 — who ran it, and how much they could see.
  actor              String           @default("clinician_session")
  completeness       String           @default("full")
  /// Shadow runs record everything and act on nothing.
  mode               String           @default("live")
  subjectRef         String           @map("subject_ref")
  npi                String?
  contextClass       String           @map("context_class")
  contextFingerprint String           @map("context_fingerprint")
  policyVersion      String           @map("policy_version")
  toolsetVersion     String           @map("toolset_version")
  modelVersion       String?          @map("model_version")
  blockers           Json             @default("[]")
  candidateActions   Json             @default("[]") @map("candidate_actions")
  rankedActionIds    Json             @default("[]") @map("ranked_action_ids")
  selectedActionId   String?          @map("selected_action_id")
  confidence         Float?
  inputGaps          Json             @default("[]") @map("input_gaps")
  generatedAt        DateTime         @map("generated_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  actions            AgentRunAction[]
  events             AgentEvent[]

  @@index([subjectRef, createdAt])
  @@index([planId])
  @@index([policyVersion, createdAt])
  @@map("agent_runs")
}

model AgentRunAction {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  actionId   String   @map("action_id")
  actionType String   @map("action_type")
  owner      String
  permission String
  status     String
  priority   Int
  rankTier   Int      @map("rank_tier")
  createdAt  DateTime @default(now()) @map("created_at")
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, priority])
  @@index([actionType, createdAt])
  @@map("agent_run_actions")
}

model AgentEvent {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String?   @map("run_id") @db.Uuid
  planId      String    @map("plan_id")
  subjectRef  String    @map("subject_ref")
  actionId    String?   @map("action_id")
  eventType   String    @map("event_type")
  owner       String?
  outcome     String?
  elapsedMs   Int?      @map("elapsed_ms")
  relatedKind String?   @map("related_kind")
  relatedRef  String?   @map("related_ref")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@index([eventType, createdAt])
  @@index([subjectRef, createdAt])
  @@index([relatedKind, relatedRef])
  @@map("agent_events")
}

// FOUNDER WAVE A1 — agent consent ledger (mirror of the backend model;
// migration lives in apps/api/backend/prisma/migrations/20260807120000_agent_consents).
// Append-only granted/revoked events written ONLY through
// apps/web/lib/agent/consent/consent-store.ts, audit-first in one
// transaction. Current state = the highest-`seq` event per
// (subjectRef, scope); the unique constraint on (subjectRef, scope, seq)
// is what serializes concurrent transitions. Never updated or deleted.
model AgentConsentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  subjectRef String   @map("subject_ref")
  scope      String
  kind       String
  seq        Int
  eventHash  String   @map("event_hash")
  /// A2.5 — `point` (approve once, runs now) or `standing` (keep doing this).
  consentKind String  @default("point") @map("consent_kind")
  /// Mandatory for `standing`; null for `point`. Enforced at read time.
  expiresAt  DateTime? @map("expires_at")
  actionId   String?  @map("action_id")
  planId     String?  @map("plan_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([subjectRef, scope, seq])
  @@index([subjectRef, scope, seq])
  @@index([createdAt])
  @@map("agent_consent_events")
}

// A2.1 — per-subject scheduling state for the background agent loop.
//
// Row existence IS the cohort allowlist. A subject is only ever reachable by
// the scheduler because someone explicitly enrolled them; there is no
// predicate that could silently widen the cohort as data changes, which is
// the failure mode cohort gating exists to prevent.
//
// Claiming: a tick claims a subject by MOVING nextDueAt FORWARD in a
// compare-and-set (`updateMany` where the row is still due), claimed iff
// count === 1. Same discipline as revocationOutboxWorker, and the reason a
// retried or concurrent tick finds nothing to claim rather than double-running.
//
// Migration owned by apps/api/backend/prisma/migrations/
// 20260808120000_agent_subject_schedule.
model AgentSubjectSchedule {
  id                  String    @id @default(uuid()) @db.Uuid
  subjectRef          String    @unique @map("subject_ref")
  npi                 String?
  /// Pause without un-enrolling. A disabled row is never claimed.
  enabled             Boolean   @default(true)
  /// When this subject next becomes claimable.
  nextDueAt           DateTime  @map("next_due_at")
  /// Cadence between scheduled runs for this subject, in minutes.
  intervalMinutes     Int       @default(1440) @map("interval_minutes")
  lastClaimedAt       DateTime? @map("last_claimed_at")
  lastRunAt           DateTime? @map("last_run_at")
  lastRunId           String?   @map("last_run_id") @db.Uuid
  /// Consecutive tick failures; a backoff input, never a truth signal.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastError           String?   @map("last_error")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([enabled, nextDueAt])
  @@map("agent_subject_schedules")
}

// A2.2 — plan-level deltas: what changed about what this clinician should do.
//
// Complementary to the fact-level detectors (watchtowerEngine,
// drift-engine), never a replacement: those record what changed in the
// world, these record what changed about the recommended next step.
//
// `material` is load-bearing. Most rows will be
// `observation_refreshed_no_change` — recorded for the learning loop,
// never surfaced to a human. Recording is unconditional; materiality is
// what a future notification layer filters on.
//
// Migration owned by apps/api/backend/prisma/migrations/
// 20260808180000_agent_plan_deltas.
model AgentPlanDelta {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  priorRunId  String?  @map("prior_run_id") @db.Uuid
  subjectRef  String   @map("subject_ref")
  planId      String   @map("plan_id")
  kind        String
  material    Boolean
  owner       String?
  /// Blocker id, action id, or lane id this delta is about.
  ref         String
  detail      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([subjectRef, createdAt])
  @@index([runId])
  @@index([kind, material, createdAt])
  @@map("agent_plan_deltas")
}
