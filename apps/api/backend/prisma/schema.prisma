// ── Wave A (Phase 1 Hardening): Decision Capsule Infrastructure ──────────────

/// Immutable audit record of an operational decision (hiring, privileging,
/// deployment, renewal) with a cryptographic snapshot of the credential
/// bundle that supported it. Status transitions record revocation cascade
/// impact: VALID → AT_RISK → INVALID.
model DecisionCapsule {
  id String @id @default(uuid()) @db.Uuid

  /// Decentralized Identifier of the clinician subject
  subjectDid String

  /// 10-digit NPI of the clinician subject
  subjectNpi String

  /// HIRING | PRIVILEGING | DEPLOYMENT | RENEWAL
  decisionType String

  /// When the decision was made (immutable after creation)
  decisionTimestamp DateTime

  /// IDs of VerificationArtifacts that supported this decision
  credentialIds String[]

  /// IDs of trusted issuers involved in this decision
  issuerIds String[]

  /// SHA-256 hash of the full credential bundle snapshot at decision time
  artifactHash String

  /// Evaluation methodology version (e.g. "CRS_v1.0")
  methodology String @default("CRS_v1.0")

  /// VALID | AT_RISK | INVALID
  status String @default("VALID")

  /// Arbitrary context: employerId, deploymentRef, notes
  metadata Json @default("{}") @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectNpi])
  @@index([subjectDid])
  @@index([status])
  @@index([decisionType])
  @@index([decisionTimestamp])
  @@index([subjectNpi, status])
}

// ── Wave 184: Unified Search Index & Content Graph ───────────────────────────

/// Object type classifications for the search index
enum SearchObjectType {
  PUBLIC_PAGE
  EMPLOYER_PROFILE
  OPPORTUNITY
  ISSUER_PROFILE
  TRUST_STATE_SUMMARY
  AUDIT_EVENT_SUMMARY
  FAQ_DOC
  CONNECTED_RECORD
}

/// ACL visibility levels
enum SearchAclLevel {
  PUBLIC // anyone can see
  AUTHENTICATED // any logged-in user
  HOLDER // clinician workspace only
  VERIFIER // verifier/employer workspace only
  ADMIN // internal only
}

/// Indexed search object — the core retrieval unit
model SearchObject {
  id          String           @id @default(uuid()) @db.Uuid
  type        SearchObjectType
  title       String
  /// Plain-text body — used for BM25 keyword search
  body        String
  /// Source URL or internal path
  sourceUrl   String?
  /// External reference id (opportunity id, issuer id, etc.)
  referenceId String?
  /// ACL gate
  aclLevel    SearchAclLevel   @default(PUBLIC)
  /// JSON metadata (specialty, state, pay, etc.)
  metadata    Json             @default("{}") @db.JsonB
  /// Embedding vector stored as float array (pgvector-ready)
  embedding   Float[]
  /// ISO timestamp of source freshness
  indexedAt   DateTime         @default(now())
  freshAt     DateTime?
  active      Boolean          @default(true)

  acl SearchObjectACL[]

  @@index([type])
  @@index([aclLevel])
  @@index([active])
  @@index([type, active])
  @@index([referenceId])
}

/// Fine-grained ACL: which role/org can access which search object
model SearchObjectACL {
  id             String       @id @default(uuid()) @db.Uuid
  searchObjectId String       @db.Uuid
  searchObject   SearchObject @relation(fields: [searchObjectId], references: [id], onDelete: Cascade)
  /// If set, only users with this role can see the object
  roleRequired   String?
  /// If set, only members of this org can see the object
  orgId          String?      @db.Uuid
  createdAt      DateTime     @default(now())

  @@index([searchObjectId])
  @@index([orgId])
}

/// Index job run log
model SearchIndexRun {
  id           String    @id @default(uuid()) @db.Uuid
