// ---- TRUST-PERSIST-1 — Issuer-verification persistence scaffold (schema-only) ----
//
// Adds the database tables that mirror the issuer-verification TypeScript
// types (apps/web/lib/issuer-verification/types.ts). No writer is wired
// in this PR. Default behavior is unchanged: existing demo renders
// continue to render with `recordedBy: 'demo'` and no row is inserted.
// A subsequent PR introduces the feature flag and the Postgres writer
// that fills these tables.
//
// Truth invariants enforced at the database level (CHECK constraints in
// the migration):
//   - ReceiptCandidate.decisionGrade is the literal `false` in TS;
//     the SQL CHECK enforces decision_grade = false.
//   - ReceiptCandidate.proofTier when present is the literal
//     'receipt_candidate'; the SQL CHECK enforces this.
//   - ReceiptCandidate.recordedBy is one of 'demo' | 'review_surface'
//     | 'system' (mirrors ReceiptCandidateAuditMetadata.recordedBy).
model IssuerRequest {
  id              String    @id @default(uuid()) @db.Uuid
  requestId       String    @unique
  claimType       String
  claimSummary    String
  issuerCandidate Json
  route           Json
  consent         Json
  status          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  receiptCandidates ReceiptCandidate[]

  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

model ReceiptCandidate {
  id          String         @id @default(uuid()) @db.Uuid
  candidateId String         @unique
  requestId   String?
  request     IssuerRequest? @relation(fields: [requestId], references: [requestId])

  basis                  String
  agentName              String?
  sourceOrganizationName String

  attributionStatus String

  decisionGrade Boolean @default(false)
  proofTier     String?

  notes              String?
  limitationNote     String?
  responseStatus     String?
  responseSummary    String?
  responseReceivedAt DateTime?
  reviewState        String?

  recordedBy String @default("demo")

  signedReceiptJwt String?

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([requestId])
  @@index([reviewState])
  @@index([createdAt])
}

/// ISSUER-10 — the promoted PSV receipt, contract-aligned.
///
/// NOT the legacy `PsvReceipt` model above: that one stores the pre-issuer-chain
/// PsvReceiptSnapshot shape (receiptId / sourceAuthority / ttlSeconds) and drops
/// every field the issuer truth contract depends on. Both exist; only this one
/// may be read as an issuer-chain PSVReceipt.
///
/// The four nested contract objects are stored whole as JSONB rather than
/// flattened into columns, because flattening is what lost them last time:
/// `sourceBasis` collapsed to a `source_authority` string erases the
/// contracted-agent / source-of-record distinction, and `attributedResponder`
/// collapsed to an `attestorId` erases attributionMethod. A partial write is a
/// structural failure, not a silent rewrite — the repository asserts every one
/// of them round-trips.
///
/// Truth-contract CHECK constraints (proofTier = 'psv_receipt', decisionGrade =
/// TRUE, globalCredentialTruth = FALSE, limitations is a JSON array) live in
/// migration 20260809120000_issuer10_psv_receipt_persistence and cannot be
/// weakened from here. `db push` does not create them — see the migration header.
model IssuerPsvReceipt {
  id                  String   @id @default(uuid()) @db.Uuid
  psvReceiptId        String   @unique
  psvCandidateId      String
  receiptCandidateId  String
  requestId           String
  claimId             String
  claimType           String
  promotedAt          DateTime
  /// PolicyReviewActor — actorId / displayName / role.
  promotedBy          Json
  /// SourceBasis — agent and source of record stay distinct.
  sourceBasis         Json
  /// AttributedResponder — carries attributionMethod, never just a name.
  attributedResponder Json
  /// PSVReceiptScope — covers / doesNotCover bound the claim.
  scope               Json
  /// PSVReceiptLimitation[] — may be empty, never absent.
  limitations         Json
  /// FreshnessPolicy — ttlDays / issuedAt / staleAfter.
  freshness           Json

  proofTier             String  @default("psv_receipt")
  decisionGrade         Boolean @default(true)
  globalCredentialTruth Boolean @default(false)

  recordedBy String @default("demo")

  correlationId  String
  /// Caller-supplied write key. Unique, so a retried write is one row.
  idempotencyKey String? @unique
  notes          String?

  createdAt DateTime @default(now())

  @@index([psvReceiptId])
  @@index([psvCandidateId])
  @@index([requestId])
  @@index([claimId])
  @@index([createdAt])
}

/// ISSUER-10 — IssuerAuditEventRecord rows (ISSUER-7 contract).
///
/// `payloadHash` is NOT NULL with no default and the writer copies it verbatim:
/// the record type permits the empty-string placeholder and forbids fabricating
/// a hash, so a default here would invent one.
model IssuerAuditEvent {
  id                String   @id @default(uuid()) @db.Uuid
  eventId           String   @unique
  correlationId     String
  requestId         String
  subjectId         String?
  /// IssuerRequestLifecycleActor, stored whole.
  actor             Json
  /// Mirror of actor.role, as the TS record carries both.
  actorRole         String
  eventType         String
  occurredAt        DateTime
  source            String
  payloadHash       String
  limitationNote    String?
  relatedArtifactId String?
  recordedBy        String   @default("system")
  createdAt         DateTime @default(now())

  @@index([correlationId])
  @@index([requestId])
  @@index([eventType, occurredAt])
  @@index([createdAt])
}

/// D4 — probe-observed availability ledger.
///
/// One row per source lane per probe tick. Exists because the source-health
/// store is an in-memory Map that empties on every cold start, so the platform
/// forgot its own health on each deploy and `/status` could only say "we do not
/// publish uptime figures we have not measured".
///
/// The honesty grammar this table encodes:
///   - The denominator is SAMPLES TAKEN, never wall-clock. A gap between probe
///     ticks is unmeasured time; it counts neither for nor against a lane.
///   - `probeSource` distinguishes a scheduled tick from a post-deploy or manual
///     one, so a burst of deploy probes can never be mistaken for steady
///     observation.
///   - Per lane only. There is deliberately no global "uptime" column: a blanket
///     figure would repeat the lane-flattening that produced the "read live"
///     overclaim.
model AvailabilitySample {
  id          String   @id @default(uuid()) @db.Uuid
  laneId      String   @map("lane_id")
  ok          Boolean
  state       String
  latencyMs   Int?     @map("latency_ms")
  probeSource String   @map("probe_source")
  observedAt  DateTime @map("observed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([laneId, observedAt])
  @@index([observedAt])
  @@map("availability_samples")
}

/// FOUNDER WAVE A0 — Start Agent run telemetry.
///
/// One row per generated StartPlan. The learning chain this family preserves:
///   plan version -> action -> owner -> outcome -> elapsed time
/// and, via (relatedKind, relatedRef) on AgentEvent, future hiring outcomes
/// (application / interview / offer / accepted offer / start) join the same
/// chain without those systems existing yet.
///
/// Privacy contract: blockers/candidateActions store the structured plan
/// objects, which by construction carry evidence REFS (opaque ids) and
/// agent-authored template text only — never raw credential values, secrets,
/// or document blobs. planId is a deterministic content hash (plan_<hex>),
/// NOT a uuid — do not move it into a @db.Uuid column.
model AgentRun {
  id                 String           @id @default(uuid()) @db.Uuid
  planId             String           @map("plan_id")
  /// A2.1 — what caused this run. `event` is reserved for A2.2+.
  trigger            String           @default("interactive")
  /// A2.2 — the prior run this one was diffed against. Added WITH its writer.
  deltaFromRunId     String?          @map("delta_from_run_id") @db.Uuid
  /// A2.2 — decision-relevant projection, the only thing deltas compare.
  decisionProjection Json?            @map("decision_projection")
  /// A2.2 — hash of the DECISION content only (no clocks, no observedAt).
  decisionFingerprint String?         @map("decision_fingerprint")
  /// A2.0 — who ran it, and how much they could see.
  actor              String           @default("clinician_session")
  completeness       String           @default("full")
  /// Shadow runs record everything and act on nothing.
  mode               String           @default("live")
  subjectRef         String           @map("subject_ref")
  npi                String?
  contextClass       String           @map("context_class")
  contextFingerprint String           @map("context_fingerprint")
  policyVersion      String           @map("policy_version")
  toolsetVersion     String           @map("toolset_version")
  modelVersion       String?          @map("model_version")
  blockers           Json             @default("[]")
  candidateActions   Json             @default("[]") @map("candidate_actions")
  rankedActionIds    Json             @default("[]") @map("ranked_action_ids")
  selectedActionId   String?          @map("selected_action_id")
  confidence         Float?
  inputGaps          Json             @default("[]") @map("input_gaps")
  generatedAt        DateTime         @map("generated_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  actions            AgentRunAction[]
  events             AgentEvent[]

  @@index([subjectRef, createdAt])
  @@index([planId])
  @@index([policyVersion, createdAt])
  @@map("agent_runs")
}

/// One row per ranked/candidate action in a run — the queryable join target
/// for outcome learning (which owners/permissions/types actually move
/// clinicians forward). Mirrors the plan's AgentAction fields that matter for
/// analysis; full structured actions live in AgentRun.candidateActions.
model AgentRunAction {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  actionId   String   @map("action_id")
  actionType String   @map("action_type")
  owner      String
  permission String
  status     String
  priority   Int
  rankTier   Int      @map("rank_tier")
  createdAt  DateTime @default(now()) @map("created_at")
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, priority])
  @@index([actionType, createdAt])
  @@map("agent_run_actions")
}

/// Outcome events for the learning loop (agent_plan_generated,
/// agent_action_presented/accepted/dismissed/completed/failed/blocked,
/// agent_human_override, agent_plan_superseded — vocabulary enforced in
/// apps/web/lib/agent/telemetry/events.ts, not the DB). Append-only.
/// (relatedKind, relatedRef) is the forward foreign-reference pattern for
/// downstream hiring outcomes.
model AgentEvent {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String?   @map("run_id") @db.Uuid
  planId      String    @map("plan_id")
  subjectRef  String    @map("subject_ref")
  actionId    String?   @map("action_id")
  eventType   String    @map("event_type")
  owner       String?
  outcome     String?
  elapsedMs   Int?      @map("elapsed_ms")
  relatedKind String?   @map("related_kind")
  relatedRef  String?   @map("related_ref")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@index([eventType, createdAt])
  @@index([subjectRef, createdAt])
  @@index([relatedKind, relatedRef])
  @@map("agent_events")
}

/// Singleton row backing the W3C Bitstring Status List v1.0 revocation
/// registry (`services/ledger/statusListManager.ts`, Wave 40).
///
/// This model was referenced by the manager from the day it was written but
/// never existed in the schema or in any migration, so `prisma.statusListState`
/// was `undefined` and every DB path in the manager threw at runtime —
/// `getStatusListCredential()`, `setRevoked()`, `assignStatusIndex()`,
/// `isRevoked()`. `// @ts-nocheck` at the top of the manager is why the
/// compiler never reported it. Launch blocker #14(a).
///
///   - `id` is always the literal `'singleton'`; there is exactly one row.
///   - `encoded` is the base64url of the GZIP-compressed bitstring (§4.1), not
///     the raw bits. At the 131,072-bit minimum size an empty list compresses
///     to a few hundred bytes.
///   - `version` increments on every bit flip and drives both the ETag served
///     to verifiers and the in-memory cache invalidation.
///   - `nextIndex` is the assignment cursor. The final bit is reserved for the
///     demo credential (`DEMO_STATUS_LIST_INDEX`) and is never handed out.
model StatusListState {
  id        String   @id
  encoded   String   @db.Text
  version   Int      @default(0)
  sizeBits  Int      @map("size_bits")
  nextIndex Int      @default(0) @map("next_index")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("status_list_state")
}

/// FOUNDER WAVE A1 — agent consent ledger (the authorization layer).
///
/// Append-only granted/revoked events. Current state is the highest-`seq`
/// event per (subject_ref, scope) — ordering is DB-enforced by the unique
/// constraint on (subject_ref, scope, seq), never by created_at (ms ties are
/// real) or uuid order (arbitrary). Revocation is a state, never a deletion,
/// and re-grant after revoke is a NEW event (event_hash covers the event id
/// and seq, so the cycle is representable — deliberately unlike
/// ConsentGrant's content-addressed grant_hash).
///
/// This ledger answers "may the agent run this?". The immutable disclosure
/// record for an EXERCISED share remains the canonical ConsentGrant, minted
/// by the canonical capability (e.g. the apply-intent seal transaction) at
/// execution time; agent events reference it in metadata. Revoking a scope
/// here gates future agent execution only — it does not recall a share that
/// already ran (that remains the BundleShareEvent revocation surface).
model AgentConsentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  subjectRef String   @map("subject_ref")
  scope      String
  kind       String
  seq        Int
  eventHash  String   @map("event_hash")
  /// A2.5 — `point` (approve once, runs now) or `standing` (keep doing this).
  consentKind String  @default("point") @map("consent_kind")
  /// Mandatory for `standing`; null for `point`. Enforced at read time.
  expiresAt  DateTime? @map("expires_at")
  actionId   String?  @map("action_id")
  planId     String?  @map("plan_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([subjectRef, scope, seq])
  @@index([subjectRef, scope, seq])
  @@index([createdAt])
  @@map("agent_consent_events")
}

/// A2.1 — per-subject scheduling state for the background agent loop.
///
/// Row existence IS the cohort allowlist: a subject is reachable by the
/// scheduler only because someone explicitly enrolled them. There is no
/// predicate that could silently widen the cohort as data changes.
///
/// Claiming moves `next_due_at` FORWARD in a compare-and-set, so a retried or
/// concurrent tick finds nothing to claim rather than double-running.
///
/// Written by apps/web (lib/agent/schedule/); the backend owns the migration.
model AgentSubjectSchedule {
  id                  String    @id @default(uuid()) @db.Uuid
  subjectRef          String    @unique @map("subject_ref")
  npi                 String?
  enabled             Boolean   @default(true)
  nextDueAt           DateTime  @map("next_due_at")
  intervalMinutes     Int       @default(1440) @map("interval_minutes")
  lastClaimedAt       DateTime? @map("last_claimed_at")
  lastRunAt           DateTime? @map("last_run_at")
  lastRunId           String?   @map("last_run_id") @db.Uuid
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastError           String?   @map("last_error")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([enabled, nextDueAt])
  @@map("agent_subject_schedules")
}

/// A2.2 — plan-level deltas: what changed about what this clinician should do.
///
/// Complementary to the fact-level detectors (watchtowerEngine,
/// drift-engine), never a replacement: those record what changed in the
/// world, these record what changed about the recommended next step.
///
/// `material` is load-bearing. Most rows will be
/// `observation_refreshed_no_change` — recorded for the learning loop,
/// never surfaced to a human. Recording is unconditional; materiality is
/// what a future notification layer filters on.
///
/// Migration owned by apps/api/backend/prisma/migrations/
/// 20260808180000_agent_plan_deltas.
model AgentPlanDelta {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  priorRunId  String?  @map("prior_run_id") @db.Uuid
  subjectRef  String   @map("subject_ref")
  planId      String   @map("plan_id")
  kind        String
  material    Boolean
  owner       String?
  //// Blocker id, action id, or lane id this delta is about.
  ref         String
  detail      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([subjectRef, createdAt])
  @@index([runId])
  @@index([kind, material, createdAt])
  @@map("agent_plan_deltas")
}

/// N1 — clinician contact consent (append-only authorization ledger).
///
/// Until this existed, VitalCV emailed a clinician's EMPLOYERS and an ops
/// inbox when their credential neared expiry, and never told the clinician.
/// Closing that gap needs permission, and permission needs a record.
///
/// `PersonProfile.verifiedEmail` is NOT that record: it is an OTP possession
/// proof established to corroborate NPI→person binding. Using it as a
/// notification destination is a purpose expansion, so contacting a clinician
/// requires an explicit grant here.
///
/// Append-only granted/revoked events; current state is the highest-`seq`
/// event per (clinician_npi, channel), serialized by the unique constraint
/// exactly as the agent consent ledger is. Revocation is a state, never a
/// deletion, and re-grant after revoke is a new event.
model ClinicianContactConsentEvent {
  id           String   @id @default(uuid()) @db.Uuid
  clinicianNpi String   @map("clinician_npi")
  channel      String
  kind         String
  seq          Int
  eventHash    String   @map("event_hash")
  /// How the grant was captured, e.g. `holder_settings`. Never inferred.
  grantSource  String?  @map("grant_source")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([clinicianNpi, channel, seq])
  @@index([clinicianNpi, channel, seq])
  @@index([createdAt])
  @@map("clinician_contact_consent_events")
}

/// N1 — clinician notification preferences.
///
/// Deliberately mirrors the shape `Watchlist` already established for
/// org-scoped alerting (channels + severity floor + suppression window)
/// rather than inventing a second vocabulary. A preference is not a consent:
/// muting everything below CRITICAL is a routing choice, while permission to
/// contact at all lives in ClinicianContactConsentEvent.
model ClinicianNotificationPreference {
  id                       String   @id @default(uuid()) @db.Uuid
  clinicianNpi             String   @unique @map("clinician_npi")
  channels                 String[] @default(["EMAIL"])
  severityFloor            String   @default("HIGH") @map("severity_floor")
  suppressionWindowMinutes Int      @default(1440) @map("suppression_window_minutes")
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("clinician_notification_preferences")
}
