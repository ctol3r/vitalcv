/// Canonical entity — the VCV representation of a real-world entity.
/// Entities exist independently of VCV user accounts.
/// Resolved from source artifacts (NPPES, OIG, PECOS, etc.).
model VcvEntity {
  id          String        @id @default(uuid()) @db.Uuid
  entityType  VcvEntityType @map("entity_type")
  /// Deterministic: sha256(entityType + primaryKey) — safe lookup key
  canonicalId String        @unique(map: "vcv_entities_canonical_uq") @map("canonical_id")
  displayName String        @map("display_name")
  npi         String?
  npiType     NpiType?      @map("npi_type")
  orgDid      String?       @map("org_did")
  /// Source system IDs that reference this entity (NPPES, OIG, etc.)
  sourceIds   String[]      @map("source_ids")
  verifiedAt  DateTime?     @map("verified_at")
  /// Free-form metadata: name parts, addresses, taxonomies, etc.
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  institution Institution?

  // SEAL training back-relations
  advisoryOutcomeEvents   AdvisoryOutcomeEvent[]   @relation("advisory_outcome_entity")
  blockerResolutionEvents BlockerResolutionEvent[] @relation("blocker_resolution_entity")
  issuedCredentials        VcvCredential[]         @relation("CredentialIssuer")
  employerDecisionEvents  EmployerDecisionEvent[]  @relation("employer_decision_entity")
  organizationContexts     VcvOrganizationContext[] @relation("org_context_requestor")
  startOutcomeEvents      StartOutcomeEvent[]      @relation("start_outcome_entity")

  @@index([npi])
  @@index([entityType], map: "vcv_entities_type_idx")
  @@index([entityType, npi], map: "vcv_entities_type_npi_idx")
  @@map("vcv_entities")
}

/// Time-bounded role assignment for an entity.
/// An entity may hold multiple roles simultaneously.
model VcvEntityRole {
  id         String        @id @default(uuid()) @db.Uuid
  entityId   String        @map("entity_id") @db.Uuid
  roleType   VcvRoleType   @map("role_type")
  /// Contextual qualifier: state of practice, specialty, program name
  context    String?
  validFrom  DateTime?     @map("valid_from")
  validUntil DateTime?     @map("valid_until")
  source     VcvRoleSource @default(INFERRED)
  /// Artifact or claim ID backing this role assignment
  evidenceId String?       @map("evidence_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([entityId, roleType], map: "vcv_entity_roles_entity_role_idx")
  @@index([roleType], map: "vcv_entity_roles_role_idx")
  @@map("vcv_entity_roles")
}

/// Typed, evidence-backed relationship between two entities.
/// subject → [relationshipType] → object
/// Example: person:NPI123 → LICENSED_BY → issuer_authority:CA_MEDICAL_BOARD
model VcvEntityRelationship {
  id               String              @id @default(uuid()) @db.Uuid
  subjectId        String              @map("subject_id") @db.Uuid
  objectId         String              @map("object_id") @db.Uuid
  relationshipType VcvRelationshipType @map("relationship_type")
  /// State context (e.g. for licensed_by, privileges_at)
  state            String?
  startDate        DateTime?           @map("start_date")
  endDate          DateTime?           @map("end_date")
  /// Source artifact backing this relationship
  artifactId       String?             @map("artifact_id") @db.Uuid
  /// Specific claim backing this relationship
  claimId          String?             @map("claim_id")
  confidence       Float               @default(0.5)
  tier             String              @default("SILVER")
  /// Extra metadata (dates, notes, program details)
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([objectId, relationshipType], map: "vcv_rel_object_type_idx")
  @@index([subjectId, objectId], map: "vcv_rel_pair_idx")
  @@index([subjectId, relationshipType], map: "vcv_rel_subject_type_idx")
  @@map("vcv_entity_relationships")
}

