enum IdentityDeltaType {
  CLAIM_ADDED
  CLAIM_CHANGED
  CLAIM_EXPIRED
  EXCLUSION_DETECTED
  LICENSE_STATUS_CHANGED
  NEW_SANCTION_HIT
  NEW_PAYMENT_RELATIONSHIP
