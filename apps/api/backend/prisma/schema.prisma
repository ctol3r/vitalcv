  rationale String?
  createdAt DateTime @default(now())

  @@index([npi])
  @@index([createdAt])
  @@map("action_log")
}

/// Lightweight operator-facing notification. Written by drift reaction
/// handlers and (future) other reaction paths. Not an audit record; pure
/// UI surface. acknowledged is flipped manually by operators.
model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  clinicianNpi String   @map("clinician_npi")
  eventType    String   @map("event_type")
  severity     String
  message      String
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clinicianNpi])
  @@index([acknowledged])
  @@index([createdAt])
  @@map("notification")
}

/// Persistent ingest-time record of source-state drift. Written when a
/// new sourceCheck for an (npi, source) pair carries a different value
/// than the previous one. Append-only — old artifacts and old
/// attestations are NEVER mutated; this table records WHAT changed and
/// WHEN, so historical decisions remain replayable against the data
/// that informed them.
model DriftEvent {
  id            String   @id @default(uuid()) @db.Uuid
  subjectNpi    String   @map("subject_npi")
  source        String
  previousValue Json?    @map("previous_value")
  newValue      Json     @map("new_value")
  /// Free-form descriptor (e.g. 'value_changed', 'status_flipped',
  /// 'verification_lost'). Lets reaction code subscribe by kind.
  driftType     String   @map("drift_type")
  detectedAt    DateTime @default(now()) @map("detected_at")

  @@index([subjectNpi])
  @@index([source])
  @@index([detectedAt])
  @@index([driftType])
  @@map("drift_event")
}

model DriftAlert {
  alertId    String   @id @default(uuid()) @db.Uuid @map("alert_id")
  subjectNpi String   @map("subject_npi")
  driftId    String   @unique @map("drift_id")
  severity   String
  createdAt  DateTime @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([subjectNpi, createdAt])
  @@index([subjectNpi, resolvedAt])
  @@index([severity])
  @@map("drift_alert")
}

/// Sidecar attestation of an employer action — captures the decision
/// state and the supporting evidence/trust snapshot at the moment the
/// action was recorded. NOT a replacement for Acceptance and NOT an
/// audit chain — a system-of-record that an action was taken with this
/// view of the world. Best-effort write; failures must not block the
/// action route.
model DecisionAttestation {
  id                String   @id @default(uuid()) @db.Uuid
  clinicianNpi      String   @map("clinician_npi")
  actionTaken       String   @map("action_taken")
  decisionState     String   @map("decision_state")
  decisionTimestamp DateTime @default(now()) @map("decision_timestamp")
  snapshot          Json
  // sha256 hex digest over the canonicalized attestation envelope.
  // Tamper-evident: clients can recompute and compare.
  hash              String
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([clinicianNpi])
  @@index([decisionTimestamp])
  @@index([hash])
  @@map("decision_attestation")
}

/// Sidecar activation record for the Start graph.
/// NOT a replacement for Start (which is the audit-grade attestation
/// event) and NOT FK-linked to Acceptance. acceptanceRef is a plain
/// string reference so this table never imposes relational constraints
/// on the existing Acceptance chain.
model StartActivation {
  id              String    @id @default(uuid()) @db.Uuid
  clinicianNpi    String    @map("clinician_npi")
  orgId           String?   @map("org_id")
  acceptanceRef   String    @map("acceptance_ref")
  activationState String    @map("activation_state")
  activatedAt     DateTime? @map("activated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([clinicianNpi])
  @@index([acceptanceRef])
  @@index([createdAt])
  @@map("start_activation")
}

/// Sidecar snapshot of decision + trust state at the moment an accept
/// action was recorded. NOT a replacement for Acceptance and NOT an
/// audit record — a system-memory snapshot for replayability. Kept
/// independent so Acceptance audit chains remain pristine.
model AcceptanceSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  clinicianNpi         String   @map("clinician_npi")
  decisionState        String   @map("decision_state")
  trustSignalsSnapshot Json     @map("trust_signals_snapshot")
  role                 String?
  createdAt            DateTime @default(now()) @map("created_at")
  // Optional future linkage to a realized Acceptance row.
  acceptanceId         String?  @map("acceptance_id")

  @@index([clinicianNpi])
  @@index([createdAt])
  @@index([acceptanceId])
  @@map("acceptance_snapshot")
}

/// Generic graph node representing any entity in the AKG.
/// entityType discriminates the kind (CLINICIAN, ISSUER, CREDENTIAL, POLICY, FACILITY).
/// entityId references the primary key in the source-of-truth table.
/// attributes stores denormalized metadata as JSON for fast graph queries.
model KnowledgeNode {
  id         String          @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  label      String
  attributes Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  outEdges   AuthorityEdge[] @relation("EdgeSource")
  inEdges    AuthorityEdge[] @relation("EdgeTarget")

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityId])
}

/// Directed edge in the AKG representing an authority relationship.
/// relationType encodes the semantic meaning (VERIFIED_BY, ISSUED_TO, COMPLIES_WITH, REQUIRED_BY, ATTESTED_BY).
/// cryptographicProof optionally stores a hash or signature anchoring this edge to the trust ledger.
model AuthorityEdge {
  id                 String        @id @default(uuid()) @db.Uuid
  sourceNodeId       String        @db.Uuid
  targetNodeId       String        @db.Uuid
  relationType       String
  weight             Float         @default(1.0)
  cryptographicProof String?
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now())
  source             KnowledgeNode @relation("EdgeSource", fields: [sourceNodeId], references: [id])
  target             KnowledgeNode @relation("EdgeTarget", fields: [targetNodeId], references: [id])

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([relationType])
  @@index([sourceNodeId, relationType])
}

/// Immutable audit record of an operational decision (hiring, privileging,
/// deployment, renewal) with a cryptographic snapshot of the credential
/// bundle that supported it. Status transitions record revocation cascade
/// impact: VALID → AT_RISK → INVALID.
model DecisionCapsule {
  id                   String   @id @default(uuid()) @db.Uuid
  /// Decentralized Identifier of the clinician subject
  subjectDid           String
  /// 10-digit NPI of the clinician subject
  subjectNpi           String
  /// HIRING | PRIVILEGING | DEPLOYMENT | RENEWAL
  decisionType         String
  /// When the decision was made (immutable after creation)
  decisionTimestamp    DateTime
  /// IDs of VerificationArtifacts that supported this decision
  credentialIds        String[]
  /// IDs of trusted issuers involved in this decision
  issuerIds            String[]
  /// SHA-256 hash of the full credential bundle snapshot at decision time
  artifactHash         String
  /// Evaluation methodology version (e.g. "CRS_v1.0")
  methodology          String   @default("CRS_v1.0")
  /// VALID | AT_RISK | INVALID
  status               String   @default("VALID")
  /// Arbitrary context: employerId, deploymentRef, notes
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
