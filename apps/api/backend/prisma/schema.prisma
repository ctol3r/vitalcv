// Prisma schema for Chai VC Platform with database seeding support
// Defines User, Credential, and Job models for comprehensive GraphQL operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  passwordHash String?
  credentials Credential[]
  jobs        Job[]
}

model Credential {
  id       Int      @id @default(autoincrement())
  name     String
  issuer   String
  issuedAt DateTime @default(now())
  expiresAt DateTime?
  renewalWindowDays Int?
  authorityId String?
  user     User     @relation(fields: [userId], references: [id])
  userId   Int
}

model AuditEvent {
  id           Int      @id @default(autoincrement())
  type         String
  hash         String
  credentialId String?
  userId       Int?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Job {
  id     Int    @id @default(autoincrement())
  title  String
  user   User   @relation(fields: [userId], references: [id])
  userId Int
}

model DiscoverItem {
  id                   Int      @id @default(autoincrement())
  clinicianId          String
  publicationId        String?
  impactType           String
  impactedCredentialIds Json?
  impactedJobIds       Json?
  createdAt            DateTime @default(now())
}

model PubMedPublication {
  id            Int      @id @default(autoincrement())
  publicationId String   @unique
  clinicianId   String
  title         String?
  createdAt     DateTime @default(now())
}

model PubMedEvidence {
  id            Int      @id @default(autoincrement())
  publicationId String
  clinicianId   String
  credentialId  String?
  jobId         String?
  createdAt     DateTime @default(now())
}
