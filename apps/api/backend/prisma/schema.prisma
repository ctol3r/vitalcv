model Application {
  id            String            @id @default(uuid()) @db.Uuid
  opportunityId String            @map("opportunity_id") @db.Uuid
  clerkUserId   String            @map("clerk_user_id")
  npi           String?
  coverNote     String?           @map("cover_note")
  status        ApplicationStatus @default(PENDING)
  price          Decimal?          @db.Decimal(10, 2)
  artifacts     Json              @default("[]")
  timeline      Json              @default("[]")
  reviewedBy    String?           @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNote    String?           @map("review_note")
  /// Wave 0 (Seal): version of the immutable disclosure packet captured at
  /// submission. NULL = legacy application submitted before packets existed —
  /// rendered with an explicit legacy label, never a fabricated packet.
  sealedPacketVersion Int?        @map("sealed_packet_version")
  packets       ApplicationPacket[]
  activationRequirements ActivationRequirement[]
  externalReferences ApplicationExternalReference[]
  integrationInboxEvents IntegrationInboxEvent[]
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([opportunityId, clerkUserId])
  @@index([opportunityId])
  @@index([clerkUserId])
  @@index([status])
  @@map("applications")
}

/// Wave 0 (Seal): the immutable evidence disclosure a clinician shared at
/// submission. NEVER updated after seal — refreshed disclosure creates a NEW
/// version row; `supersededByPacketId` links forward and revocation is a
/// state, not a deletion. Identifiers are FROZEN STRINGS (not relations to
/// mutable rows) so the packet replays without rereading current state.
model ApplicationPacket {
  id                   String    @id @default(uuid()) @db.Uuid
  applicationId        String    @map("application_id") @db.Uuid
  packetVersion        Int       @map("packet_version")
  clerkUserId          String    @map("clerk_user_id")
  clinicianNpi         String    @map("clinician_npi")
  opportunityId        String    @map("opportunity_id") @db.Uuid
  employerOrgId        String    @map("employer_org_id")
  purpose              String
  recipient            String
  /// string[] — section identifiers the clinician chose to disclose
  selectedSections     Json      @map("selected_sections")
  /// PacketFieldEntry[] — per-field value, evidence state, source id,
  /// source observation time, freshness horizon, artifact/receipt ids
  fields               Json
  /// PacketSectionAbsence[] — one entry per selected section that produced NO
  /// field, with the evidence state and the reason nothing was found. Covered
  /// by the seal hash. Three distinct values, none interchangeable:
  ///   NULL = legacy packet sealed before absences existed; replays with the
  ///          key OMITTED so its original hash still verifies.
  ///   []   = every selected section contributed evidence (a positive claim).
  ///   [..] = the sections that produced nothing, and why.
  /// Without this, `selected_sections` naming a section with no field reads to
  /// an employer as "checked and clean" when nothing was found at all.
  sectionAbsences      Json?     @map("section_absences")
  clinicianNote        String?   @map("clinician_note")
  methodologyVersion   String    @map("methodology_version")
  consentAt            DateTime  @map("consent_at")
  consentReceiptId     String    @map("consent_receipt_id")
  /// First-class consent binding for packets sealed after Start Mission Phase 1.
  /// NULL means the legacy packet predates ConsentGrant and MUST be omitted from
  /// canonical replay bytes, exactly like a legacy opportunityVersion.
  consentGrantId       String?   @map("consent_grant_id") @db.Uuid
  /// PR J5b — the opportunity version (updatedAt at seal time) the application
  /// was sealed against. Additive + nullable: NULL = legacy packet sealed
  /// before this column existed, which replays with the field OMITTED from the
  /// canonical content so its original hash still verifies (never write NULL
  /// for a new packet). Covered by the seal hash for new packets.
  opportunityVersion   String?   @map("opportunity_version")
  /// sha256 over the canonical (key-sorted) packet content — the seal
  packetHash           String    @unique @map("packet_hash")
  createdAt            DateTime  @default(now()) @map("created_at")
  supersededByPacketId String?   @map("superseded_by_packet_id") @db.Uuid
  revokedAt            DateTime? @map("revoked_at")
  revokedReason        String?   @map("revoked_reason")

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, packetVersion])
  @@index([clerkUserId])
  @@index([opportunityId])
  @@index([employerOrgId])
  @@map("application_packets")
}

/// ACT-1.3 — the application-linked activation requirement ledger. One canonical
/// record per remaining step to a qualified start; drives both the clinician and
/// employer views. Instantiated only after an employer decision. Status/necessity
/// vocabulary is enforced in the requirementLifecycle state machine, not the DB.
model ActivationRequirement {
  id                  String    @id @default(uuid()) @db.Uuid
  applicationId       String    @map("application_id") @db.Uuid
  organizationId      String    @map("organization_id")
  sourceRequirementId String?   @map("source_requirement_id")
  category            String
  label               String
  necessity           String    @default("required")
  status              String    @default("not_started")
  owner               String    @default("system")
  evidenceRule        String?   @map("evidence_rule")
  dependencyIds       String[]  @map("dependency_ids")
  dueAt               DateTime? @map("due_at")
  resolvedBy          String?   @map("resolved_by")
  resolvedAt          DateTime? @map("resolved_at")
  policyVersion       String?   @map("policy_version")
  /// Operational status received from an external system. This is never
  /// promoted into clinician evidence or treated as institutional approval.
  externalSourceSystem String?  @map("external_source_system")
  externalObjectType   String?  @map("external_object_type")
  externalIdentifier   String?  @map("external_identifier")
  externalObservedAt   DateTime? @map("external_observed_at")
  externalLimitation   String?  @map("external_limitation")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([organizationId])
  @@index([status])
  @@map("activation_requirements")
}

/// Durable mapping between a VitalCV application and the corresponding object
/// in an ATS, credentialing platform, HRIS, or other partner system. A mapping
/// is organization-scoped; an external id supplied by one tenant can never bind
/// an application owned by another tenant.
model ApplicationExternalReference {
  id                 String   @id @default(uuid()) @db.Uuid
  applicationId      String   @map("application_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  sourceSystem       String   @map("source_system")
