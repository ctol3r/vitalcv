model VerificationArtifact {
  id                     String    @id @default(uuid()) @db.Uuid
  npi                    String
  source                 String
  status                 String
  artifactType           String    @default("GENERIC") @map("artifact_type")
  parserVersion          String?   @map("parser_version")
  matchingStrategy       String?   @map("matching_strategy")
  trustTier              String?   @map("trust_tier")
  confidenceScore        Float?    @map("confidence_score")
  conflictReason         String?   @map("conflict_reason")
  mergeReason            String?   @map("merge_reason")
  sourceRunId            String?   @map("source_run_id") @db.Uuid
  sourceRecordId         String?   @map("source_record_id") @db.Uuid
  sourceUrl              String?   @map("source_url")
  fetchHeaders           Json?     @map("fetch_headers") @db.JsonB
  fetchedAt              DateTime? @map("fetched_at")
  observedAt             DateTime? @map("observed_at")
  generation             Int?
  supersededByArtifactId String?   @map("superseded_by_artifact_id") @db.Uuid
  supersedesArtifactId   String?   @map("supersedes_artifact_id") @db.Uuid
  rawPayload             Json?     @db.JsonB
  checksum               String
  merkleRoot             String?
  claimHashes            Json?
  lifecycleState         String    @default("active")
  revokedAt              DateTime?
  suspendedAt            DateTime?
  revocationReason       String?
  statusLastChecked      DateTime  @default(now())
  psvWindowStart         DateTime?
  psvWindowDeadline      DateTime?
  psvWindowCompliant     Boolean?
  verifiedAt             DateTime
  expiresAt              DateTime?
  monitoring             Boolean   @default(false)
  organizationId         String?   @db.Uuid
  trustState             String    @default("needs_review")
  // Wave Y: Expiration forecasting
  daysUntilExpiration    Int?
  forecastRiskLevel      String? // low | medium | high
  // Wave 40: W3C Bitstring Status List bit assignment
  statusListIndex        Int?
  createdAt              DateTime  @default(now())

  sourceRun                   SourceRun?                   @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  sourceRecord                SourceRecord?                @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  supersededByArtifact        VerificationArtifact?        @relation("ArtifactSupersededBy", fields: [supersededByArtifactId], references: [id], onDelete: SetNull)
  supersedesArtifact          VerificationArtifact?        @relation("ArtifactSupersedes", fields: [supersedesArtifactId], references: [id], onDelete: SetNull)
  snapshots                   AuditSnapshot[]
  claimRecords                ClaimRecord[]                @relation("ArtifactClaimRecords")
  verificationReceiptRecords  VerificationReceiptRecord[]  @relation("ArtifactReceiptRecords")
  identityResolutionDecisions IdentityResolutionDecision[] @relation("ArtifactResolutionDecisions")
  identityClaimDeltas         IdentityClaimDelta[]
  trustAlertRecords           TrustAlertRecord[]
  supersededArtifacts         VerificationArtifact[]       @relation("ArtifactSupersedes")
  supersedesArtifacts         VerificationArtifact[]       @relation("ArtifactSupersededBy")

  @@index([npi])
  @@index([source])
  @@index([artifactType])
  @@index([parserVersion])
  @@index([matchingStrategy])
  @@index([trustTier])
  @@index([sourceRunId])
  @@index([sourceRecordId])
  @@index([supersededByArtifactId])
  @@index([supersedesArtifactId])
  @@index([monitoring])
  @@index([organizationId])
  @@index([lifecycleState])
  @@index([revokedAt])
  @@index([suspendedAt])
  @@index([trustState])
  @@index([statusLastChecked])
  @@index([createdAt])
  // Wave M: Performance indexes
  @@index([checksum])
  @@index([merkleRoot])
  // Wave Y: Forecast index
  @@index([forecastRiskLevel])
  // Wave 40: Status list index
  @@index([statusListIndex])
}

