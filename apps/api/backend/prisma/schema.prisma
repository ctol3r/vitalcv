// ═══════════════════════════════════════════════════════════════════════
// ENTITY-ROLE MODEL — Wave E1/E3/E4
// Canonical entity registry, role assignments, and relationship graph.
// Independent of VCV user accounts — entities exist because sources say so.
// ═══════════════════════════════════════════════════════════════════════

/// Canonical entity type — matches EntityType union in domain/entity/types.ts
enum VcvEntityType {
  PERSON
  ORGANIZATION
  FACILITY
  EDUCATIONAL_INSTITUTION
  TRAINING_PROGRAM
  ISSUER_AUTHORITY
  SOURCE_RECORD
}

/// Role type — matches RoleType union in domain/entity/types.ts
enum VcvRoleType {
  CLINICIAN
  EMPLOYER
  VERIFIER
  ISSUER
  COORDINATOR
  SPONSOR
  TRAINEE
  ADMIN_REVIEWER
}

/// Relationship type — matches RelationshipType union in domain/entity/types.ts
enum VcvRelationshipType {
  WORKS_FOR
  EMPLOYED_BY
  AFFILIATED_WITH
  PRIVILEGES_AT
  ENROLLED_WITH
  TRAINED_AT
  GRADUATED_FROM
  COMPLETED_RESIDENCY_AT
  COMPLETED_FELLOWSHIP_AT
  SPONSORS
  LICENSED_BY
  CERTIFIED_BY
  REGISTERED_WITH
  ISSUES
  VERIFIES
  REQUESTS_FROM
  SHARES_WITH
}

/// Role source — how a role was assigned
enum VcvRoleSource {
  NPPES_DERIVED
  USER_CLAIMED
  CLAIM_DERIVED
  ADMIN_ASSIGNED
  INFERRED
}

/// Canonical entity — the VCV representation of a real-world entity.
/// Entities exist independently of VCV user accounts.
/// Resolved from source artifacts (NPPES, OIG, PECOS, etc.).
model VcvEntity {
  id          String        @id @default(uuid()) @db.Uuid
  entityType  VcvEntityType @map("entity_type")
  /// Deterministic: sha256(entityType + primaryKey) — safe lookup key
  canonicalId String        @unique @map("canonical_id")
  displayName String        @map("display_name")
  npi         String?
  npiType     NpiType?      @map("npi_type")
  orgDid      String?       @map("org_did")
  /// Source system IDs that reference this entity (NPPES, OIG, etc.)
  sourceIds   String[]      @map("source_ids")
  verifiedAt  DateTime?     @map("verified_at")
  /// Free-form metadata: name parts, addresses, taxonomies, etc.
  metadata    Json          @default("{}") @db.JsonB
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  roles     VcvEntityRole[]
  asSubject VcvEntityRelationship[] @relation("rel_subject")
  asObject  VcvEntityRelationship[] @relation("rel_object")

  // S1/S4/S5 back-relations
  credentialsHeld        VcvCredential[]          @relation("cred_subject")
  credentialsIssued      VcvCredential[]          @relation("cred_issuer")
  educationAsSubject     VcvEducationRecord[]     @relation("edu_subject")
  educationAsInstitution VcvEducationRecord[]     @relation("edu_institution")
  orgContextsRequested   VcvOrganizationContext[] @relation("ctx_requestor")
  orgContextSubjects     VcvOrgContextSubject[]   @relation("ctx_subject")
  userClaims             VcvUserEntityClaim[]     @relation("entity_claims")
  bundleShareEvents      BundleShareEvent[]       @relation("bundle_share_subject")
  institution            Institution?

  // SEAL training back-relations
  advisoryOutcomeEvents   AdvisoryOutcomeEvent[]   @relation("advisory_outcome_entity")
  blockerResolutionEvents BlockerResolutionEvent[] @relation("blocker_resolution_entity")
  employerDecisionEvents  EmployerDecisionEvent[]  @relation("employer_decision_entity")
  startOutcomeEvents      StartOutcomeEvent[]      @relation("start_outcome_entity")

  @@index([npi])
  @@index([entityType])
  @@index([entityType, npi])
  @@map("vcv_entities")
}

/// Time-bounded role assignment for an entity.
/// An entity may hold multiple roles simultaneously.
model VcvEntityRole {
  id         String        @id @default(uuid()) @db.Uuid
  entityId   String        @map("entity_id") @db.Uuid
  entity     VcvEntity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  roleType   VcvRoleType   @map("role_type")
  /// Contextual qualifier: state of practice, specialty, program name
  context    String?
  validFrom  DateTime?     @map("valid_from")
  validUntil DateTime?     @map("valid_until")
  source     VcvRoleSource @default(INFERRED)
  /// Artifact or claim ID backing this role assignment
  evidenceId String?       @map("evidence_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([entityId, roleType])
  @@index([roleType])
  @@map("vcv_entity_roles")
}

/// Typed, evidence-backed relationship between two entities.
/// subject → [relationshipType] → object
/// Example: person:NPI123 → LICENSED_BY → issuer_authority:CA_MEDICAL_BOARD
model VcvEntityRelationship {
  id               String              @id @default(uuid()) @db.Uuid
  subjectId        String              @map("subject_id") @db.Uuid
  subject          VcvEntity           @relation("rel_subject", fields: [subjectId], references: [id], onDelete: Cascade)
  objectId         String              @map("object_id") @db.Uuid
  object           VcvEntity           @relation("rel_object", fields: [objectId], references: [id], onDelete: Cascade)
  relationshipType VcvRelationshipType @map("relationship_type")
  /// State context (e.g. for licensed_by, privileges_at)
  state            String?
  startDate        DateTime?           @map("start_date")
  endDate          DateTime?           @map("end_date")
  /// Source artifact backing this relationship
  artifactId       String?             @map("artifact_id") @db.Uuid
  /// Specific claim backing this relationship
  claimId          String?             @map("claim_id")
  confidence       Float               @default(0.5)
  tier             String              @default("SILVER") // GOLD | SILVER | BRONZE
  /// Extra metadata (dates, notes, program details)
  metadata         Json                @default("{}") @db.JsonB
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([subjectId, relationshipType])
  @@index([objectId, relationshipType])
  @@index([subjectId, objectId])
  @@map("vcv_entity_relationships")
}

// ──────────────────────────────────────────────────────────────
// Auth: Passkey Credentials (WebAuthn)
// ──────────────────────────────────────────────────────────────

model PasskeyCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  counter      BigInt   @default(0)
  deviceType   String   @default("platform") @map("device_type")
  backedUp     Boolean  @default(false) @map("backed_up")
  rpId         String   @map("rp_id")
  transports   String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("passkey_credentials")
}

// ──────────────────────────────────────────────────────────────
// Auth: NPI Ownership Claims
// ──────────────────────────────────────────────────────────────

model NpiOwnership {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  npi                String
  verifiedAt         DateTime? @map("verified_at")
  verificationMethod String    @default("CLAIMED") @map("verification_method")
  claimedAt          DateTime  @default(now()) @map("claimed_at")
  revokedAt          DateTime? @map("revoked_at")

  @@unique([userId, npi])
  @@index([npi])
  @@map("npi_ownership")
}

// ═══════════════════════════════════════════════════════════════════════
// CANONICAL SCHEMA — Waves S1/S4/S5
// VcvCredential, VcvEducationRecord, VcvOrganizationContext,
// VcvOrganizationContextSubject, VcvUserEntityClaim
// ═══════════════════════════════════════════════════════════════════════

// ── S1/S2 Enums ──────────────────────────────────────────────────────────────

/// Credential domain — the high-level subject area a credential belongs to.
enum VcvCredentialDomain {
  LICENSURE // state medical/nursing/pharmacy license
  BOARD_CERTIFICATION // ABMS, AOA, specialty board certs
  DEA_REGISTRATION // federal controlled substance registration
  MEDICARE_ENROLLMENT // CMS PECOS enrollment
  EXCLUSION_CHECK // OIG/LEIE, SAM.gov negative finding
  EDUCATION // medical degree, nursing degree
  TRAINING // residency, fellowship, CME
  MALPRACTICE // malpractice insurance coverage
  HOSPITAL_PRIVILEGE // clinical privileges at a facility
  EMPLOYMENT // employment/affiliation verification
  IDENTITY // NPI, SSN-4, biometric identity anchor
}

/// Verification level — how strongly a credential has been verified.
enum VcvVerificationLevel {
  SELF_REPORTED // asserted by the subject, not cross-checked
  SOURCE_MATCHED // matched against an authoritative source
  SOURCE_VERIFIED // confirmed via real-time API query
  CRYPTOGRAPHICALLY_SIGNED // issuer-signed SD-JWT or VC
  BIOMETRICALLY_CONFIRMED // subject confirmed with biometric
}

/// Organization context type — what the org is doing with the entity.
enum VcvOrgContextType {
  APPLICATION // clinician applying to work
  EMPLOYMENT_REVIEW // ongoing employment credentialing
  PRIVILEGING // hospital/facility privileges request
  CREDENTIALING // initial credentialing with payer/org
  RECREDENTIALING // periodic re-credentialing
  TRAINING_ENROLLMENT // enrolling in a training program
  ISSUER_REVIEW // issuer verifying credentials for cert
  MONITORING // ongoing passive monitoring
  COMPLIANCE_AUDIT // compliance or accreditation audit
}

/// Organization context status — lifecycle of the org context.
enum VcvOrgContextStatus {
  PENDING // initiated, awaiting subject response
  ACTIVE // subject has responded, review in progress
  COMPLETED // context resolved (approved/denied/enrolled)
  EXPIRED // context timed out without resolution
  REVOKED // explicitly revoked by either party
}

// ── VcvCredential — Wave S1 ───────────────────────────────────────────────────

/// A derived credential claim tied to a specific entity.
/// Separate from VerificationArtifact (raw source capture) —
/// this is the app-layer credential: "Entity X holds credential Y".
///
/// Every credential must trace to at least one VcvEntity (the subject)
/// and optionally one issuer entity (the authority that issued it).
model VcvCredential {
  id                  String     @id @default(uuid()) @db.Uuid
  subjectId           String     @map("subject_id") @db.Uuid
  subject             VcvEntity  @relation("cred_subject", fields: [subjectId], references: [id], onDelete: Cascade)
  issuerId            String?    @map("issuer_id") @db.Uuid
  issuer              VcvEntity? @relation("cred_issuer", fields: [issuerId], references: [id], onDelete: SetNull)
  credentialKey       String     @unique @map("credential_key")
  credentialFamilyKey String     @map("credential_family_key")

  domain            VcvCredentialDomain  @map("domain")
  credentialType    String               @map("credential_type") // e.g. "MD_LICENSE_CA", "ABIM_INTERNAL_MEDICINE"
  status            String               @default("ACTIVE") // ACTIVE | EXPIRED | SUSPENDED | REVOKED
  verificationLevel VcvVerificationLevel @default(SELF_REPORTED) @map("verification_level")

  /// Raw claim value — structured JSON (license number, state, dates, etc.)
  claimValue  Json     @default("{}") @map("claim_value") @db.JsonB
  /// Source artifact IDs that back this credential
  artifactIds String[] @default([]) @map("artifact_ids")
  /// Verification receipt IDs that justify this materialized credential
  receiptIds  String[] @default([]) @map("receipt_ids")
  /// The claim ID in the identity pipeline that produced this credential
  claimId     String?  @map("claim_id")

  issuedAt                 DateTime? @map("issued_at")
  expiresAt                DateTime? @map("expires_at")
  verifiedAt               DateTime? @map("verified_at")
  observedAt               DateTime? @map("observed_at")
  revokedAt                DateTime? @map("revoked_at")
  nextReverifyAt           DateTime? @map("next_reverify_at")
  trustTier                String?   @map("trust_tier")
  confidence               Float?
  supersededByCredentialId String?   @map("superseded_by_credential_id") @db.Uuid
  supersedesCredentialId   String?   @map("supersedes_credential_id") @db.Uuid

  /// State context (e.g. for state licenses: "CA", "NY")
  jurisdiction String?
  /// Free-form metadata
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  supersededByCredential VcvCredential?         @relation("CredentialSupersededBy", fields: [supersededByCredentialId], references: [id], onDelete: SetNull)
  supersedesCredential   VcvCredential?         @relation("CredentialSupersedes", fields: [supersedesCredentialId], references: [id], onDelete: SetNull)
  educationRecords       VcvEducationRecord[]   @relation("edu_credential")
  contextLinks           VcvOrgContextSubject[] @relation("ctx_credential")
  supersededCredentials  VcvCredential[]        @relation("CredentialSupersedes")
  supersedesCredentials  VcvCredential[]        @relation("CredentialSupersededBy")

  @@index([subjectId, domain])
  @@index([subjectId, status])
  @@index([issuerId])
  @@index([observedAt])
  @@index([credentialFamilyKey])
  @@index([credentialType, jurisdiction])
  @@index([expiresAt])
  @@map("vcv_credentials")
}

// ── VcvEducationRecord — Wave S4 ──────────────────────────────────────────────

/// Education and training record — first-class domain object.
/// Covers: medical degree, residency, fellowship, CME, internship.
/// Linked to a subject entity, optional institution entity,
/// and optionally a VcvCredential that represents its verified state.
model VcvEducationRecord {
  id            String         @id @default(uuid()) @db.Uuid
  subjectId     String         @map("subject_id") @db.Uuid
  subject       VcvEntity      @relation("edu_subject", fields: [subjectId], references: [id], onDelete: Cascade)
  institutionId String?        @map("institution_id") @db.Uuid
  institution   VcvEntity?     @relation("edu_institution", fields: [institutionId], references: [id], onDelete: SetNull)
  /// The verified credential this education record supports (optional)
  credentialId  String?        @map("credential_id") @db.Uuid
  credential    VcvCredential? @relation("edu_credential", fields: [credentialId], references: [id], onDelete: SetNull)

  recordType String @map("record_type")
  // MEDICAL_DEGREE | NURSING_DEGREE | ADVANCED_PRACTICE_CERT |
  // RESIDENCY_COMPLETION | FELLOWSHIP_COMPLETION | INTERNSHIP_COMPLETION |
  // CME_COMPLETION | TRAINING_PROGRAM_STATUS | CLINICAL_ROTATION

  degreeOrTitle     String?              @map("degree_or_title") // "MD", "DO", "Residency — Internal Medicine"
  specialty         String?
  programName       String?              @map("program_name")
  acgmeCode         String?              @map("acgme_code") // ACGME program code for residency/fellowship
  startYear         Int?                 @map("start_year")
  endYear           Int?                 @map("end_year")
  graduationDate    DateTime?            @map("graduation_date")
  completed         Boolean              @default(false)
  pgLevel           String?              @map("pg_level") // PGY-1, PGY-2, etc.
  countryCode       String               @default("US") @map("country_code")
  accredited        Boolean? // LCME / ACGME accreditation status
  verificationLevel VcvVerificationLevel @default(SELF_REPORTED) @map("verification_level")
  /// Raw source data (degree conferral letter, ACGME record, etc.)
  sourceData        Json                 @default("{}") @map("source_data") @db.JsonB
  metadata          Json                 @default("{}") @db.JsonB
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([subjectId, recordType])
  @@index([institutionId])
  @@index([acgmeCode])
  @@index([subjectId, completed])
  @@map("vcv_education_records")
}

// ── VcvOrganizationContext — Wave S5 ──────────────────────────────────────────

/// The canonical path for org-entity interactions.
/// Replaces ad-hoc application/review/monitoring flows with a
/// first-class typed context that carries its own lifecycle,
/// participants, credentials, and audit trail.
///
/// An org context always has:
///   - A requesting entity (the org/verifier/employer)
///   - One or more subject entities (the clinicians being reviewed)
///   - A context type (what is being done)
///   - A status (where in the lifecycle it is)
model VcvOrganizationContext {
  id          String    @id @default(uuid()) @db.Uuid
  requestorId String    @map("requestor_id") @db.Uuid
  requestor   VcvEntity @relation("ctx_requestor", fields: [requestorId], references: [id], onDelete: Cascade)

  contextType VcvOrgContextType   @map("context_type")
  status      VcvOrgContextStatus @default(PENDING) @map("status")
  title       String? // human-readable label: "Q2 Re-credentialing — Kaiser SF"
  description String?

  /// Deadline or expiration for this context
  dueAt         DateTime? @map("due_at")
  completedAt   DateTime? @map("completed_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  /// Structured outcome (decision, notes, credential IDs accepted)
  outcome         Json?    @db.JsonB
  /// Webhook URL to notify on status changes
  webhookUrl      String?  @map("webhook_url")
  /// Auth user who created this context (Clerk user ID)
  createdByUserId String?  @map("created_by_user_id")
  /// Org-level external reference ID (for correlation with requester's systems)
  externalRefId   String?  @map("external_ref_id")
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subjects          VcvOrgContextSubject[]
  statusEvents      VcvOrgContextStatusEvent[]
  bundleShareEvents BundleShareEvent[]

  // SEAL training back-relations
  advisoryOutcomeEvents  AdvisoryOutcomeEvent[]  @relation("advisory_outcome_org_ctx")
  employerDecisionEvents EmployerDecisionEvent[] @relation("employer_decision_org_ctx")
  startOutcomeEvents     StartOutcomeEvent[]     @relation("start_outcome_org_ctx")

  @@index([requestorId, contextType])
  @@index([status])
  @@index([contextType, status])
  @@index([createdByUserId])
  @@index([externalRefId])
  @@map("vcv_organization_contexts")
}

/// A subject (entity + optional credential set) participating in an org context.
/// Subject can be a clinician, trainee, or other entity being reviewed.
model VcvOrgContextSubject {
  id           String                 @id @default(uuid()) @db.Uuid
  contextId    String                 @map("context_id") @db.Uuid
  context      VcvOrganizationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  subjectId    String                 @map("subject_id") @db.Uuid
  subject      VcvEntity              @relation("ctx_subject", fields: [subjectId], references: [id], onDelete: Cascade)
  /// Specific credential(s) being reviewed in this context (nullable = all)
  credentialId String?                @map("credential_id") @db.Uuid
  credential   VcvCredential?         @relation("ctx_credential", fields: [credentialId], references: [id], onDelete: SetNull)

  subjectStatus String @default("PENDING") @map("subject_status")
  // PENDING | SUBMITTED | UNDER_REVIEW | APPROVED | DENIED | WITHDRAWN

  /// Subject's response or submission data
  submissionData   Json?     @map("submission_data") @db.JsonB
  /// Reviewer notes
  reviewNotes      String?   @map("review_notes")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  invitedAt        DateTime? @map("invited_at")
  respondedAt      DateTime? @map("responded_at")
  metadata         Json      @default("{}") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([contextId, subjectId])
  @@index([contextId])
  @@index([subjectId])
  @@index([subjectStatus])
  @@map("vcv_org_context_subjects")
}

/// Audit trail for org context lifecycle transitions.
model VcvOrgContextStatusEvent {
  id          String                 @id @default(uuid()) @db.Uuid
  contextId   String                 @map("context_id") @db.Uuid
  context     VcvOrganizationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  fromStatus  VcvOrgContextStatus?   @map("from_status")
  toStatus    VcvOrgContextStatus    @map("to_status")
  triggeredBy String?                @map("triggered_by") // clerk user ID or system
  reason      String?
  metadata    Json                   @default("{}") @db.JsonB
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([contextId])
  @@map("vcv_org_context_status_events")
}

// ── VcvUserEntityClaim — Wave S1 ──────────────────────────────────────────────

/// Canonical link: auth user → identity subject (VcvEntity).
/// Replaces the looser NpiOwnership with a typed, multi-level claim
/// that supports progressive verification.
///
/// A user may claim multiple entities (e.g. a physician who also runs a group).
/// An entity may have multiple users claiming it (e.g. credentialing coordinator
/// acting on behalf of a clinician).
model VcvUserEntityClaim {
  id          String    @id @default(uuid()) @db.Uuid
  /// The VCV auth user (Clerk user ID — NOT the internal User.id UUID)
  clerkUserId String    @map("clerk_user_id")
  /// The entity being claimed
  entityId    String    @map("entity_id") @db.Uuid
  entity      VcvEntity @relation("entity_claims", fields: [entityId], references: [id], onDelete: Cascade)

  /// Why the user is claiming this entity
  claimType String @default("SUBJECT") @map("claim_type")
  // SUBJECT     — user is the identity subject (clinician claiming their own NPI)
  // COORDINATOR — user manages on behalf of the subject
  // EMPLOYER    — user is reviewing/employing this entity
  // AUDITOR     — read-only access for compliance

  verificationLevel VcvVerificationLevel @default(SELF_REPORTED) @map("verification_level")

  /// When the claim was verified (if ever)
  verifiedAt         DateTime? @map("verified_at")
  /// How it was verified: PASSKEY, MAGIC_LINK, DOCUMENT, ADMIN_OVERRIDE
  verificationMethod String?   @map("verification_method")
  /// Source artifact that confirmed the claim
  artifactId         String?   @map("artifact_id")

  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  claimedAt     DateTime  @default(now()) @map("claimed_at")
  metadata      Json      @default("{}") @db.JsonB

  @@unique([clerkUserId, entityId, claimType])
  @@index([clerkUserId])
  @@index([entityId])
  @@index([verificationLevel])
  @@map("vcv_user_entity_claims")
}

// ── Back-relations on VcvEntity (additive) ────────────────────────────────────

// NOTE: Relations below are declared on VcvEntity via back-relation fields.
// Prisma requires that all relations be declared on both sides.
// The VcvEntity model was defined earlier in this file — these back-relations
// are handled by the field declarations on the new models above.
// (Prisma resolves this at generate time across the full schema.)

// ══════════════════════════════════════════════════════════════════════════════
// SEAL Training Pipeline
//
// These tables capture behavioral/outcome signals for SEAL model training.
// SAFETY CONTRACT:
//   - These tables are APPEND-ONLY. Rows are never updated by inference.
//   - Source truth (claims, artifacts, receipts, readiness core) is never
//     modified by SEAL training. SEAL reads outcomes; it never writes claims.
//   - advisory_output fields contain "Based on observed patterns" attribution.
// ══════════════════════════════════════════════════════════════════════════════

/// Captures what advisory state was shown at each product interaction
/// and what the user/employer subsequently did.
/// Used to train SEAL on: which advisory states correlate with good outcomes.
model AdvisoryOutcomeEvent {
  id                        String   @id @default(uuid()) @db.Uuid
  entityId                  String   @map("entity_id") @db.Uuid
  organizationContextId     String?  @map("organization_context_id") @db.Uuid
  /// Version of the advisory model that produced this output (e.g. "243.1")
  advisoryVersion           String   @map("advisory_version")
  /// FK to a snapshot of advisory inputs at the time of the event
  advisoryInputSnapshotRef  String?  @map("advisory_input_snapshot_ref")
  /// FK to a snapshot of advisory outputs shown to the user
  advisoryOutputSnapshotRef String?  @map("advisory_output_snapshot_ref")
  /// PASSPORT_VIEW | SHARE_INITIATED | EMPLOYER_REVIEW | INTERVIEW_MODE | PACKET_EXPORT
  eventType                 String   @map("event_type")
  eventTimestamp            DateTime @default(now()) @map("event_timestamp")
  /// Blockers present at time of event — captured for training
  blockersAtEvent           Json     @default("[]") @map("blockers_at_event") @db.JsonB
  /// Readiness score at time of event
  readinessScoreAtEvent     Int?     @map("readiness_score_at_event")
  /// Which sources were checked at time of event
  sourceCoverageAtEvent     Json     @default("{}") @map("source_coverage_at_event") @db.JsonB
  /// Free-form outcome metadata (e.g. employer_decision, share_destination)
  metadata                  Json     @default("{}") @db.JsonB

  entity              VcvEntity               @relation("advisory_outcome_entity", fields: [entityId], references: [id], onDelete: Cascade)
  organizationContext VcvOrganizationContext? @relation("advisory_outcome_org_ctx", fields: [organizationContextId], references: [id], onDelete: SetNull)

  @@index([entityId, eventTimestamp])
  @@index([eventType, eventTimestamp])
  @@index([organizationContextId, eventTimestamp])
  @@index([advisoryVersion, eventTimestamp])
  @@map("advisory_outcome_events")
}

/// Tracks how long it took to resolve each blocker and which path was used.
/// Primary signal for SEAL's "fastest path to ready" recommendations.
model BlockerResolutionEvent {
  id               String    @id @default(uuid()) @db.Uuid
  entityId         String    @map("entity_id") @db.Uuid
  /// Structured blocker code (e.g. "ENROLLMENT_NOT_FOUND", "LICENSE_EXPIRED")
  blockerCode      String    @map("blocker_code")
  openedAt         DateTime  @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")
  /// Computed on resolution: resolvedAt - openedAt in whole days
  resolutionDays   Int?      @map("resolution_days")
  /// How the blocker was resolved: SOURCE_UPDATE | MANUAL_UPLOAD | WAIVED | EXPIRED | UNKNOWN
  resolutionMethod String?   @map("resolution_method")
  /// OPEN | RESOLVED | WAIVED | EXPIRED
  status           String    @default("OPEN")
  metadata         Json      @default("{}") @db.JsonB

  entity VcvEntity @relation("blocker_resolution_entity", fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, openedAt])
  @@index([blockerCode, status])
  @@index([blockerCode, resolutionDays])
  @@index([status, openedAt])
  @@map("blocker_resolution_events")
}

/// Records the employer's decision at review time with full context snapshot.
/// Primary signal for SEAL's "conditional proceed" recommendations.
model EmployerDecisionEvent {
  id                       String   @id @default(uuid()) @db.Uuid
  entityId                 String   @map("entity_id") @db.Uuid
  organizationContextId    String?  @map("organization_context_id") @db.Uuid
  /// PROCEED | HOLD | REQUEST_REFRESH | ROUTE_TO_REVIEW | REJECT
  decision                 String
  decidedAt                DateTime @default(now()) @map("decided_at")
  /// Role of the reviewer: EMPLOYER | CREDENTIALING_COORDINATOR | RECRUITER | SYSTEM
  reviewerRole             String   @default("EMPLOYER") @map("reviewer_role")
  /// Audit event ID from the action that triggered this decision
  auditEventId             String?  @map("audit_event_id")
  /// Trust state snapshot at decision time
  trustSnapshotAtDecision  Json     @default("{}") @map("trust_snapshot_at_decision") @db.JsonB
  /// Blockers present at decision time
  blockersAtDecision       Json     @default("[]") @map("blockers_at_decision") @db.JsonB
  /// Readiness score at decision time
  readinessScoreAtDecision Int?     @map("readiness_score_at_decision")
  metadata                 Json     @default("{}") @db.JsonB

  entity              VcvEntity               @relation("employer_decision_entity", fields: [entityId], references: [id], onDelete: Cascade)
  organizationContext VcvOrganizationContext? @relation("employer_decision_org_ctx", fields: [organizationContextId], references: [id], onDelete: SetNull)

  @@index([entityId, decidedAt])
  @@index([decision, decidedAt])
  @@index([organizationContextId, decidedAt])
  @@map("employer_decision_events")
}

/// Records actual start outcomes with delta calculations.
/// Primary signal for SEAL's "time to start" estimates.
model StartOutcomeEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  entityId              String   @map("entity_id") @db.Uuid
  organizationContextId String?  @map("organization_context_id") @db.Uuid
  startedAt             DateTime @map("started_at")
  /// Days from first employer review event to start
  daysFromFirstReview   Int?     @map("days_from_first_review")
  /// Days from first share event to start
  daysFromShare         Int?     @map("days_from_share")
  /// Days from readiness score reaching L2+ to start
  daysFromReady         Int?     @map("days_from_ready")
  /// Readiness score at time of start
  readinessScoreAtStart Int?     @map("readiness_score_at_start")
  /// Blockers present at time of start (should be empty for clean starts)
  blockersAtStart       Json     @default("[]") @map("blockers_at_start") @db.JsonB
  /// Source coverage at time of start
  sourceCoverageAtStart Json     @default("{}") @map("source_coverage_at_start") @db.JsonB
  metadata              Json     @default("{}") @db.JsonB

  entity              VcvEntity               @relation("start_outcome_entity", fields: [entityId], references: [id], onDelete: Cascade)
  organizationContext VcvOrganizationContext? @relation("start_outcome_org_ctx", fields: [organizationContextId], references: [id], onDelete: SetNull)

  @@index([entityId, startedAt])
  @@index([organizationContextId, startedAt])
  @@index([daysFromFirstReview])
  @@index([daysFromReady])
  @@map("start_outcome_events")
}

model MissingRequest {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field         String
  message       String
  status        String      @default("OPEN")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("missing_requests")
}
