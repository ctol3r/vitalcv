enum SourceStalenessStatus {
  STALE
  DISAPPEARED
}

enum TrustDegradationReason {
  CLAIM_EXPIRED
  NEW_SANCTION_HIT
  LICENSE_STATUS_CHANGED
  BOARD_CERT_STATUS_CHANGED
  SOURCE_STALE
  SOURCE_DISAPPEARED
