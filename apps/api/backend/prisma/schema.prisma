/// One row per anchored Merkle batch root. The root is recorded
/// unconditionally each anchor cycle; the witness columns fill in when
/// ANCHOR_WITNESS_ENABLED=true publishes it to external append-only
/// observers (Rekor transparency log + RFC 3161 TSA). Only bare hex root
/// hashes reach this table — assertHashOnlyAnchor gates the boundary.
model AnchorRoot {
  id              String    @id @default(uuid()) @db.Uuid
  merkleRoot      String    @unique
  eventCount      Int
  /// pending | witnessed | failed — each leg tracked independently.
  rekorStatus     String    @default("pending")
  rekorUuid       String?
  rekorLogIndex   String?
  tsaStatus       String    @default("pending")
  tsaToken        Bytes?
  tsaUrl          String?
  witnessAttempts Int       @default(0)
  witnessedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([rekorStatus])
  @@index([tsaStatus])
  @@map("anchor_roots")
}

