  @@index([suppressionCount])
  @@map("graph_reject_memory")
}

model GraphClusterAssignment {
  id          String         @id
  nodeId      String         @map("node_id")
  snapshotId  String?        @map("snapshot_id")
  clusterMode String         @map("cluster_mode")
  clusterKey  String         @map("cluster_key")
  score       Float          @default(1)
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  node        GraphNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  snapshot    GraphSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([nodeId, snapshotId, clusterMode])
  @@index([clusterMode, clusterKey])
  @@index([snapshotId])
  @@map("graph_cluster_assignments")
}

model GraphSuggestionBatch {
  id                    String                @id
  status                String                @default("QUEUED")
  requestFingerprint    String?               @map("request_fingerprint")
  graphMode             String                @map("graph_mode")
  targetNodeId          String?               @map("target_node_id")
  filterSignature       String                @map("filter_signature")
  maxSuggestionsPerNode Int                   @default(10) @map("max_suggestions_per_node")
  minConfidence         Float                 @default(0.3) @map("min_confidence")
  applyThreshold        Float                 @default(0.85) @map("apply_threshold")
  summary               Json                  @default("{}")
  errorText             String?               @map("error_text")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  completedAt           DateTime?             @map("completed_at")
  suggestions           GraphLinkSuggestion[]

  @@index([status, createdAt])
  @@index([graphMode, targetNodeId])
  @@index([requestFingerprint, status])
  @@map("graph_suggestion_batches")
}

model GraphLinkSuggestion {
  id                 String                @id
  suggestionKey      String                @map("suggestion_key")
  batchId            String?               @map("batch_id")
  sourceNodeId       String                @map("source_node_id")
  targetNodeId       String                @map("target_node_id")
  edgeType           String                @map("edge_type")
  directed           Boolean               @default(true)
  reciprocal         Boolean               @default(false)
  confidence         Float
  state              String                @default("PENDING")
  explanation        Json
  signalBreakdown    Json                  @default("{}") @map("signal_breakdown")
  materialChangeHash String                @map("material_change_hash")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  decidedAt          DateTime?             @map("decided_at")
  decisions          GraphLinkDecision[]
  batch              GraphSuggestionBatch? @relation(fields: [batchId], references: [id])
  sourceNode         GraphNode             @relation("GraphSuggestionSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode         GraphNode             @relation("GraphSuggestionTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([suggestionKey, materialChangeHash])
  @@index([state, createdAt])
  @@index([batchId])
  @@index([sourceNodeId, state])
  @@index([targetNodeId, state])
  @@map("graph_link_suggestions")
}

model GraphLinkDecision {
  id           String              @id
  suggestionId String              @map("suggestion_id")
  action       String
  decidedBy    String?             @map("decided_by")
  rationale    String?
  metadata     Json                @default("{}")
  createdAt    DateTime            @default(now()) @map("created_at")
  suggestion   GraphLinkSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId, createdAt])
  @@index([action, createdAt])
  @@map("graph_link_decisions")
}

model ReciprocalEdgeRule {
  id               String   @id
  edgeType         String   @unique @map("edge_type")
  reverseEdgeType  String   @map("reverse_edge_type")
  relationshipMode String   @map("relationship_mode")
  directed         Boolean  @default(true)
  reciprocal       Boolean  @default(false)
  autoCreate       Boolean  @default(false) @map("auto_create")
  explanation      String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([relationshipMode, autoCreate])
  @@map("reciprocal_edge_rules")
}

/// Canonical entity — the VCV representation of a real-world entity.
/// Entities exist independently of VCV user accounts.
/// Resolved from source artifacts (NPPES, OIG, PECOS, etc.).
model VcvEntity {
  id          String        @id @default(uuid()) @db.Uuid
  entityType  VcvEntityType @map("entity_type")
  /// Deterministic: sha256(entityType + primaryKey) — safe lookup key
  canonicalId String        @unique(map: "vcv_entities_canonical_uq") @map("canonical_id")
  displayName String        @map("display_name")
  npi         String?
  npiType     NpiType?      @map("npi_type")
  orgDid      String?       @map("org_did")
  /// Source system IDs that reference this entity (NPPES, OIG, etc.)
  sourceIds   String[]      @map("source_ids")
  verifiedAt  DateTime?     @map("verified_at")
  /// Free-form metadata: name parts, addresses, taxonomies, etc.
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  institution            Institution?
  subjectRelationships   VcvEntityRelationship[]  @relation("EntityRelSubject")
  objectRelationships    VcvEntityRelationship[]  @relation("EntityRelObject")
  subjectCredentials     VcvCredential[]          @relation("CredSubject")
  issuedCredentials      VcvCredential[]          @relation("CredIssuer")
  educationRecords       VcvEducationRecord[]
  requestedContexts      VcvOrganizationContext[]

  @@index([npi])
  @@index([entityType], map: "vcv_entities_type_idx")
  @@index([entityType, npi], map: "vcv_entities_type_npi_idx")
  @@map("vcv_entities")
}

/// Time-bounded role assignment for an entity.
/// An entity may hold multiple roles simultaneously.
model VcvEntityRole {
  id         String        @id @default(uuid()) @db.Uuid
  entityId   String        @map("entity_id") @db.Uuid
  roleType   VcvRoleType   @map("role_type")
  /// Contextual qualifier: state of practice, specialty, program name
  context    String?
  validFrom  DateTime?     @map("valid_from")
  validUntil DateTime?     @map("valid_until")
  source     VcvRoleSource @default(INFERRED)
  /// Artifact or claim ID backing this role assignment
  evidenceId String?       @map("evidence_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([entityId, roleType], map: "vcv_entity_roles_entity_role_idx")
  @@index([roleType], map: "vcv_entity_roles_role_idx")
  @@map("vcv_entity_roles")
}

/// Typed, evidence-backed relationship between two entities.
/// subject → [relationshipType] → object
/// Example: person:NPI123 → LICENSED_BY → issuer_authority:CA_MEDICAL_BOARD
model VcvEntityRelationship {
  id               String              @id @default(uuid()) @db.Uuid
  subjectId        String              @map("subject_id") @db.Uuid
  objectId         String              @map("object_id") @db.Uuid
  relationshipType VcvRelationshipType @map("relationship_type")
  /// State context (e.g. for licensed_by, privileges_at)
  state            String?
  startDate        DateTime?           @map("start_date")
  endDate          DateTime?           @map("end_date")
  /// Source artifact backing this relationship
  artifactId       String?             @map("artifact_id") @db.Uuid
  /// Specific claim backing this relationship
  claimId          String?             @map("claim_id")
  confidence       Float               @default(0.5)
  tier             String              @default("SILVER")
  /// Extra metadata (dates, notes, program details)
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  subject          VcvEntity           @relation("EntityRelSubject", fields: [subjectId], references: [id])
  object           VcvEntity           @relation("EntityRelObject", fields: [objectId], references: [id])

  @@index([objectId, relationshipType], map: "vcv_rel_object_type_idx")
  @@index([subjectId, objectId], map: "vcv_rel_pair_idx")
  @@index([subjectId, relationshipType], map: "vcv_rel_subject_type_idx")
  @@map("vcv_entity_relationships")
}

model PasskeyCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  counter      BigInt   @default(0)
  deviceType   String   @default("platform") @map("device_type")
  backedUp     Boolean  @default(false) @map("backed_up")
  rpId         String   @map("rp_id")
  transports   String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("passkey_credentials")
}

model NpiOwnership {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id")
  npi                String
  verifiedAt         DateTime? @map("verified_at")
  verificationMethod String    @default("CLAIMED") @map("verification_method")
  claimedAt          DateTime  @default(now()) @map("claimed_at")
  revokedAt          DateTime? @map("revoked_at")

  @@unique([userId, npi])
  @@index([npi])
  @@map("npi_ownership")
}

/// A derived credential claim tied to a specific entity.
/// Separate from VerificationArtifact (raw source capture) —
/// this is the app-layer credential: "Entity X holds credential Y".
///
/// Every credential must trace to at least one VcvEntity (the subject)
/// and optionally one issuer entity (the authority that issued it).
model VcvCredential {
  id                       String               @id @default(uuid()) @db.Uuid
  subjectId                String               @map("subject_id") @db.Uuid
  issuerId                 String?              @map("issuer_id") @db.Uuid
  domain                   VcvCredentialDomain  @map("domain")
  credentialType           String               @map("credential_type")
  status                   String               @default("ACTIVE")
  verificationLevel        VcvVerificationLevel @default(SELF_REPORTED) @map("verification_level")
  /// Raw claim value — structured JSON (license number, state, dates, etc.)
  claimValue               Json                 @default("{}") @map("claim_value")
  /// Source artifact IDs that back this credential
  artifactIds              String[]             @default([]) @map("artifact_ids")
  /// The claim ID in the identity pipeline that produced this credential
  claimId                  String?              @map("claim_id")
  issuedAt                 DateTime?            @map("issued_at")
  expiresAt                DateTime?            @map("expires_at")
  verifiedAt               DateTime?            @map("verified_at")
  revokedAt                DateTime?            @map("revoked_at")
  nextReverifyAt           DateTime?            @map("next_reverify_at")
  /// State context (e.g. for state licenses: "CA", "NY")
  jurisdiction             String?
  /// Free-form metadata
  metadata                 Json                 @default("{}")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  credentialKey            String               @unique @map("credential_key")
  credentialFamilyKey      String               @map("credential_family_key")
  /// Verification receipt IDs that justify this materialized credential
  receiptIds               String[]             @default([]) @map("receipt_ids")
  observedAt               DateTime?            @map("observed_at")
  trustTier                String?              @map("trust_tier")
  confidence               Float?
  supersededByCredentialId String?              @map("superseded_by_credential_id") @db.Uuid
  supersedesCredentialId   String?              @map("supersedes_credential_id") @db.Uuid
  subject                  VcvEntity            @relation("CredSubject", fields: [subjectId], references: [id])
  issuer                   VcvEntity?           @relation("CredIssuer", fields: [issuerId], references: [id])

  @@index([expiresAt], map: "vcv_cred_expires_idx")
  @@index([credentialFamilyKey], map: "vcv_cred_family_idx")
  @@index([issuerId], map: "vcv_cred_issuer_idx")
  @@index([observedAt], map: "vcv_cred_observed_idx")
  @@index([subjectId, domain], map: "vcv_cred_subject_domain_idx")
  @@index([subjectId, status], map: "vcv_cred_subject_status_idx")
  @@index([credentialType, jurisdiction], map: "vcv_cred_type_jur_idx")
  @@map("vcv_credentials")
}

/// Education and training record — first-class domain object.
/// Covers: medical degree, residency, fellowship, CME, internship.
/// Linked to a subject entity, optional institution entity,
/// and optionally a VcvCredential that represents its verified state.
model VcvEducationRecord {
  id                String               @id @default(uuid()) @db.Uuid
  subjectId         String               @map("subject_id") @db.Uuid
  institutionId     String?              @map("institution_id") @db.Uuid
  /// The verified credential this education record supports (optional)
  credentialId      String?              @map("credential_id") @db.Uuid
  recordType        String               @map("record_type")
  degreeOrTitle     String?              @map("degree_or_title")
  specialty         String?
  programName       String?              @map("program_name")
  acgmeCode         String?              @map("acgme_code")
  startYear         Int?                 @map("start_year")
  endYear           Int?                 @map("end_year")
  graduationDate    DateTime?            @map("graduation_date")
  completed         Boolean              @default(false)
  pgLevel           String?              @map("pg_level")
  countryCode       String               @default("US") @map("country_code")
  accredited        Boolean?
  verificationLevel VcvVerificationLevel @default(SELF_REPORTED) @map("verification_level")
  /// Raw source data (degree conferral letter, ACGME record, etc.)
  sourceData        Json                 @default("{}") @map("source_data")
  metadata          Json                 @default("{}")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  institution       VcvEntity?           @relation(fields: [institutionId], references: [id])

  @@index([acgmeCode], map: "vcv_edu_acgme_idx")
  @@index([subjectId, completed], map: "vcv_edu_completed_idx")
  @@index([institutionId], map: "vcv_edu_institution_idx")
  @@index([subjectId, recordType], map: "vcv_edu_subject_type_idx")
  @@map("vcv_education_records")
}

/// The canonical path for org-entity interactions.
/// Replaces ad-hoc application/review/monitoring flows with a
/// first-class typed context that carries its own lifecycle,
/// participants, credentials, and audit trail.
///
/// An org context always has:
/// - A requesting entity (the org/verifier/employer)
/// - One or more subject entities (the clinicians being reviewed)
/// - A context type (what is being done)
/// - A status (where in the lifecycle it is)
model VcvOrganizationContext {
  id              String              @id(map: "vcv_org_ctx_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestorId     String              @map("requestor_id") @db.Uuid
  contextType     VcvOrgContextType   @map("context_type")
  status          VcvOrgContextStatus @default(PENDING) @map("status")
  title           String?
  description     String?
  /// Deadline or expiration for this context
  dueAt           DateTime?           @map("due_at") @db.Timestamptz(6)
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(6)
  revokedAt       DateTime?           @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?             @map("revoked_reason")
  /// Structured outcome (decision, notes, credential IDs accepted)
  outcome         Json?
  /// Webhook URL to notify on status changes
  webhookUrl      String?             @map("webhook_url")
  /// Auth user who created this context (Clerk user ID)
  createdByUserId String?             @map("created_by_user_id")
  /// Org-level external reference ID (for correlation with requester's systems)
  externalRefId   String?             @map("external_ref_id")
  metadata        Json                @default("{}")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestor       VcvEntity              @relation(fields: [requestorId], references: [id])
  subjects        VcvOrgContextSubject[]

  @@index([externalRefId], map: "vcv_org_ctx_ext_ref_idx")
  @@index([requestorId, contextType], map: "vcv_org_ctx_requestor_type_idx")
  @@index([status], map: "vcv_org_ctx_status_idx")
  @@index([contextType, status], map: "vcv_org_ctx_type_status_idx")
  @@index([createdByUserId], map: "vcv_org_ctx_user_idx")
  @@map("vcv_organization_contexts")
}

/// A subject (entity + optional credential set) participating in an org context.
/// Subject can be a clinician, trainee, or other entity being reviewed.
model VcvOrgContextSubject {
  id               String    @id(map: "vcv_org_ctx_subj_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contextId        String    @map("context_id") @db.Uuid
  subjectId        String    @map("subject_id") @db.Uuid
  /// Specific credential(s) being reviewed in this context (nullable = all)
  credentialId     String?   @map("credential_id") @db.Uuid
  subjectStatus    String    @default("PENDING") @map("subject_status")
  /// Subject's response or submission data
  submissionData   Json?     @map("submission_data")
  /// Reviewer notes
  reviewNotes      String?   @map("review_notes")
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId String?   @map("reviewed_by_user_id")
  invitedAt        DateTime? @map("invited_at") @db.Timestamptz(6)
  respondedAt      DateTime? @map("responded_at") @db.Timestamptz(6)
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  context          VcvOrganizationContext @relation(fields: [contextId], references: [id])

  @@unique([contextId, subjectId], map: "vcv_org_ctx_subj_uq")
  @@index([contextId], map: "vcv_org_ctx_subj_ctx_idx")
  @@index([subjectStatus], map: "vcv_org_ctx_subj_status_idx")
  @@index([subjectId], map: "vcv_org_ctx_subj_subj_idx")
  @@map("vcv_org_context_subjects")
}

/// Audit trail for org context lifecycle transitions.
model VcvOrgContextStatusEvent {
  id          String               @id(map: "vcv_org_ctx_evt_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contextId   String               @map("context_id") @db.Uuid
  fromStatus  VcvOrgContextStatus? @map("from_status")
  toStatus    VcvOrgContextStatus  @map("to_status")
  triggeredBy String?              @map("triggered_by")
  reason      String?
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contextId], map: "vcv_org_ctx_evt_ctx_idx")
  @@map("vcv_org_context_status_events")
}

/// Canonical link: auth user → identity subject (VcvEntity).
/// Replaces the looser NpiOwnership with a typed, multi-level claim
/// that supports progressive verification.
///
/// A user may claim multiple entities (e.g. a physician who also runs a group).
/// An entity may have multiple users claiming it (e.g. credentialing coordinator
/// acting on behalf of a clinician).
model VcvUserEntityClaim {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The VCV auth user (Clerk user ID — NOT the internal User.id UUID)
  clerkUserId        String               @map("clerk_user_id")
  /// The entity being claimed
  entityId           String               @map("entity_id") @db.Uuid
  /// Why the user is claiming this entity
  claimType          String               @default("SUBJECT") @map("claim_type")
  verificationLevel  VcvVerificationLevel @default(SELF_REPORTED) @map("verification_level")
  /// When the claim was verified (if ever)
  verifiedAt         DateTime?            @map("verified_at") @db.Timestamptz(6)
  /// How it was verified: PASSKEY, MAGIC_LINK, DOCUMENT, ADMIN_OVERRIDE
  verificationMethod String?              @map("verification_method")
  /// Source artifact that confirmed the claim
  artifactId         String?              @map("artifact_id")
  revokedAt          DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedReason      String?              @map("revoked_reason")
  claimedAt          DateTime             @default(now()) @map("claimed_at") @db.Timestamptz(6)
  metadata           Json                 @default("{}")

  @@unique([clerkUserId, entityId, claimType], map: "vcv_user_entity_claims_uq")
  @@index([entityId], map: "vcv_uec_entity_idx")
  @@index([verificationLevel], map: "vcv_uec_level_idx")
  @@index([clerkUserId], map: "vcv_uec_user_idx")
  @@map("vcv_user_entity_claims")
}

model EventLog {
