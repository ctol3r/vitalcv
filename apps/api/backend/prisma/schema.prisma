generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Auth & RBAC: User identity linked to Clerk
// ──────────────────────────────────────────────────────────────

enum UserRole {
  CLINICIAN
  VERIFIER
  ISSUER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum NpiDidBindingStatus {
  ACTIVE
  CONTESTED
  REVOKED
  PENDING
}

enum IssuerSigningKeyState {
  ACTIVE
  GRACE
  RETIRED
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  clerkUserId    String     @unique
  email          String     @unique
  role           UserRole   @default(CLINICIAN)
  roleVersion    Int        @default(1)
  status         UserStatus @default(INVITED)
  organizationId String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  personProfile  PersonProfile?
  workspacePreference WorkspacePreference?

  @@index([clerkUserId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────
// Canonical Path: Recognition → Acceptance → Start
// ──────────────────────────────────────────────────────────────

model Recognition {
  id              String    @id @default(uuid()) @db.Uuid
  recognitionId   String    @unique
  subjectId       String
  employerId      String
  recognizedAt    DateTime
  verifiedAt      DateTime
  verificationRef String
  expiresAt       DateTime?
  revokedAt       DateTime?
  revocationRef   String?
  eventHash       String
  createdAt       DateTime  @default(now())

  acceptances Acceptance[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
}

model Acceptance {
  id              String   @id @default(uuid()) @db.Uuid
  acceptanceId    String   @unique
  recognitionId   String
  subjectId       String
  employerId      String
  facilityId      String
  acceptedAt      DateTime
  psvReportId     String
  eventHash       String
  createdAt       DateTime @default(now())

  recognition Recognition @relation(fields: [recognitionId], references: [recognitionId])
  starts      Start[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
  @@index([acceptanceId])
}

model Start {
  id           String   @id @default(uuid()) @db.Uuid
  startId      String   @unique
  acceptanceId String
  subjectId    String
  employerId   String
  attestedAt   DateTime
  eventHash    String
  createdAt    DateTime @default(now())

  acceptance Acceptance @relation(fields: [acceptanceId], references: [acceptanceId])

  @@index([subjectId])
  @@index([employerId])
  @@index([acceptanceId])
  @@index([startId])
}

// ──────────────────────────────────────────────────────────────
// PSV Receipts (verification evidence)
// ──────────────────────────────────────────────────────────────

model PsvReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptId       String   @unique
  clinicianId     String
  sourceAuthority String
  licenseId       String
  transactionId   String
  fetchedAt       DateTime
  responseHash    String
  ttlSeconds      Int
  revoked         Boolean  @default(false)
  lane            String?
  verificationCheck   String?
  verificationOutcome String?
  failureReason       String?
  source              String?
  attestorId          String?
  verificationRequestId String?
  createdAt       DateTime @default(now())

  @@index([clinicianId])
  @@index([receiptId])
}

// ──────────────────────────────────────────────────────────────
// Clinician Intake (ingestion staging)
// ──────────────────────────────────────────────────────────────

model ClinicianIdentity {
  id           String   @id @default(uuid()) @db.Uuid
  clinicianId  String   @unique
  data         Json     @db.JsonB
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NpiDidBinding {
  id                String              @id @default(uuid()) @db.Uuid
  npi               String              @unique
  did               String              @unique
  sourceFingerprint String
  recipeVersion     String              @default("1.0.0")
  evidencePointers  Json                @db.JsonB
  status            NpiDidBindingStatus @default(ACTIVE)
  contestReason     String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([npi])
  @@index([did])
  @@map("npi_did_binding")
}

model CandidateCredential {
  id                     String   @id @default(uuid()) @db.Uuid
  candidateCredentialId  String   @unique
  clinicianId            String
  data                   Json     @db.JsonB
  status                 String   @default("UNVERIFIED")
  createdAt              DateTime @default(now())

  @@index([clinicianId])
}

model IngestConflict {
  id           String   @id @default(uuid()) @db.Uuid
  conflictId   String   @unique
  clinicianId  String
  status       String   @default("UNRESOLVED")
  data         Json     @db.JsonB
  createdAt    DateTime @default(now())

  @@index([clinicianId])
}

model IdempotentResponse {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  auditRef    String
  payload     Json     @db.JsonB
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([key])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────
// API Key → Organization mapping
// ──────────────────────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  keyHash      String    @unique
  orgName      String
  orgId        String
  permissions  String[]  @default(["write:recognitions", "write:acceptances", "write:starts", "write:ingest"])
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([orgId])
}

model ParRequest {
  id                   String   @id @default(uuid()) @db.Uuid
  requestUri           String   @unique
  requestType          String
  requestJson          Json
  clientId             String
  codeChallenge        String?
  codeChallengeMethod  String?
  redirectUri          String?
  scope                String?
  expiresAt            DateTime
  used                 Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([requestType])
  @@index([expiresAt])
  @@index([createdAt])
}

model JtiReplay {
  service   String
  jti       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([service, jti])
  @@index([expiresAt])
}

model RefreshToken {
  tokenId   String   @id
  clientId  String?
  userId    String?
  scope     String
  cnfJkt    String?
  clientCert String?
  issuedAt  DateTime
  expiresAt DateTime
  rotated   Boolean  @default(false)
  rotatedTo String?
}

model VerifierNonce {
  nonce     String   @id
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([used])
  @@index([expiresAt])
}

enum VerificationRequestStatus {
  PENDING
  COMPLETE
  FAILED
}

enum VerifierLifecycle {
  REGISTERED
  TOKEN_SENT
  TOKEN_USED
  PILOT_ACTIVATED
  BUNDLE_GENERATED
}

model VerificationRequest {
  requestId       String                   @id @default(uuid()) @db.Uuid
  clinicianId     String
  lane            String
  source          String
  attestorId      String?
  documentHash    String?
  subject         String
  status          VerificationRequestStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  completedAt     DateTime?
  receiptId       String?
  failureReason   String?

  @@index([clinicianId])
  @@index([status])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Verifier Pilot: Cross-check share links and acceptance actions
// ──────────────────────────────────────────────────────────────

model ShareLink {
  id             String   @id @default(uuid()) @db.Uuid
  npi            String
  firstViewedAt  DateTime?
  organizationId String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([npi])
  @@index([organizationId])
  @@index([createdAt])
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organizationProfile OrganizationProfile?
  activeWorkspacePreferences WorkspacePreference[] @relation("WorkspacePreferenceActiveOrganization")
  opportunities Opportunity[]
}

model Opportunity {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  specialty       String
  hiringType      String   @map("hiring_type")   // locums | perm | telehealth | contract
  state           String
  payRange        String?  @map("pay_range")
  requirementLevel String  @default("L1") @map("requirement_level") // L1 | L2 | L3
  description     String?
  remote          Boolean  @default(false)
  status          String   @default("ACTIVE")    // ACTIVE | PAUSED | CLOSED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  applications    Application[]

  @@index([organizationId])
  @@index([specialty, state])
  @@index([status])
}

/// Application status for clinician → opportunity flow
enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// Clinician application to a job opportunity
model Application {
  id             String            @id @default(uuid()) @db.Uuid
  opportunityId  String            @db.Uuid @map("opportunity_id")
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  clerkUserId    String            @map("clerk_user_id")
  npi            String?
  coverNote      String?           @map("cover_note")
  status         ApplicationStatus @default(PENDING)
  reviewedBy     String?           @map("reviewed_by")   // verifier clerkUserId
  reviewedAt     DateTime?         @map("reviewed_at")
  reviewNote     String?           @map("review_note")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([opportunityId, clerkUserId])
  @@index([clerkUserId])
  @@index([opportunityId])
  @@index([status])
}

/// NPI classification
enum NpiType {
  TYPE_1
  TYPE_2
}

/// Workspace persona a user is currently operating as
enum ActivePersona {
  CLINICIAN
  VERIFIER
  BOTH
}

/// Membership role within an organization workspace
enum MembershipRole {
  HOLDER
  VERIFIER
  ISSUER
  ADMIN
  RECRUITER
  CREDENTIALING_SPECIALIST
}

/// Linked profile for an individual clinician (Type 1 NPI)
model PersonProfile {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @unique @db.Uuid @map("user_id")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  npi             String?               @unique
  npiType         NpiType?              @default(TYPE_1) @map("npi_type")
  firstName       String?               @map("first_name")
  lastName        String?               @map("last_name")
  specialty       String?
  stateOfPractice String?               @map("state_of_practice")
  workAuthStatus  String?               @map("work_auth_status")
  resumeUrl       String?               @map("resume_url")
  linkedinUrl     String?               @map("linkedin_url")
  portfolioUrl    String?               @map("portfolio_url")
  completeness    Int                   @default(0)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  memberships     WorkspaceMembership[]

  @@index([npi])
  @@index([userId])
  @@map("person_profiles")
}

/// Linked profile for an organization (Type 2 NPI or Org DID)
model OrganizationProfile {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @unique @db.Uuid @map("organization_id")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  npi            String?
  npiType        NpiType?              @default(TYPE_2) @map("npi_type")
  orgDid         String?               @map("org_did")
  facilityType   String?               @map("facility_type")
  specialties    String[]
  statesCovered  String[]              @map("states_covered")
  website        String?
  // Wave 186: Employer intelligence fields
  tagline        String?
  description    String?
  trustScore     Int                   @default(0) @map("trust_score")
  openRoles      Int                   @default(0) @map("open_roles")
  recentHires    Int                   @default(0) @map("recent_hires")
  hiringStatus   EmployerHiringStatus  @default(NOT_HIRING) @map("hiring_status")
  hiringTypes    String[]              @map("hiring_types")
  timeToStart    String?               @map("time_to_start")
  timeToOnboard  String?               @map("time_to_onboard")
  clearToStartThreshold String?        @map("clear_to_start_threshold")
  payTransparency Boolean              @default(false) @map("pay_transparency")
  payRange       String?               @map("pay_range")
  requirements   Json                  @default("[]") @db.JsonB
  verifiedSince  DateTime?             @map("verified_since")
  verified       Boolean               @default(false)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  memberships    WorkspaceMembership[]

  @@index([npi])
  @@index([organizationId])
  @@index([hiringStatus])
  @@index([trustScore])
  @@map("organization_profiles")
}

enum EmployerHiringStatus {
  HIRING_NOW
  ACTIVELY_HIRING
  ACCEPTING_APPLICATIONS
  NOT_HIRING
}

enum SourceRunStatus {
  QUEUED
  FETCHING
  FETCHED
  PARSED
  NORMALIZED
  VERIFIED
  ALERTED
  QUARANTINED
  FAILED
}

enum IdentityResolutionDecisionType {
  LINK
  MERGE
  UNMERGE
  COLLISION
  SKIP
}

enum IdentityDeltaType {
  CLAIM_ADDED
  CLAIM_CHANGED
  CLAIM_EXPIRED
  EXCLUSION_DETECTED
  LICENSE_STATUS_CHANGED
  NEW_SANCTION_HIT
  NEW_PAYMENT_RELATIONSHIP
  PROVIDER_MOVED_ORGANIZATION
  PROVIDER_MOVED_LOCATION
  LICENSE_STATE_CHANGED
  BOARD_CERT_STATUS_CHANGED
}

enum MonitoringSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EntityChangeEventType {
  CLAIM_VALUE_CHANGED
  CLAIM_EXPIRED
  NEW_SANCTION_HIT
  NEW_PAYMENT_RELATIONSHIP
  PROVIDER_MOVED_ORGANIZATION
  PROVIDER_MOVED_LOCATION
  LICENSE_STATE_CHANGED
  LICENSE_STATUS_CHANGED
  BOARD_CERT_STATUS_CHANGED
}

enum SourceStalenessStatus {
  STALE
  DISAPPEARED
}

enum TrustDegradationReason {
  CLAIM_EXPIRED
  NEW_SANCTION_HIT
  LICENSE_STATUS_CHANGED
  BOARD_CERT_STATUS_CHANGED
  SOURCE_STALE
  SOURCE_DISAPPEARED
}

enum WatchlistTargetType {
  PROVIDER
  INSTITUTION
  CLAIM_CLASS
}

enum AlertDeliveryChannel {
  INTERNAL_FEED
  WEBHOOK
  EVENT_SINK
  EMAIL
  SLACK
}

enum AlertDeliveryStatus {
  DELIVERED
  PENDING
  SUPPRESSED
  DEDUPED
  FAILED
  NOT_CONFIGURED
}

/// Links a person to an organization with a role
model WorkspaceMembership {
  id                    String              @id @default(uuid()) @db.Uuid
  personProfileId       String              @db.Uuid @map("person_profile_id")
  personProfile         PersonProfile       @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  organizationProfileId String              @db.Uuid @map("organization_profile_id")
  organizationProfile   OrganizationProfile @relation(fields: [organizationProfileId], references: [id], onDelete: Cascade)
  role                  MembershipRole      @default(VERIFIER)
  active                Boolean             @default(true)
  invitedAt             DateTime?           @map("invited_at")
  acceptedAt            DateTime?           @map("accepted_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@unique([personProfileId, organizationProfileId])
  @@index([personProfileId])
  @@index([organizationProfileId])
  @@map("workspace_memberships")
}

/// Per-user workspace preferences and active persona state
model WorkspacePreference {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePersona     ActivePersona @default(CLINICIAN) @map("active_persona")
  activeOrgId       String?       @db.Uuid @map("active_org_id")
  activeOrganization Organization? @relation("WorkspacePreferenceActiveOrganization", fields: [activeOrgId], references: [id], onDelete: SetNull)
  sidebarCollapsed  Boolean       @default(false) @map("sidebar_collapsed")
  lastSwitchedAt    DateTime?     @map("last_switched_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("workspace_preferences")
}

model NursysEvent {
  id            String   @id @default(uuid()) @db.Uuid
  npi           String
  licenseNumber String
  state         String
  eventType     String
  rawPayload    Json     @db.JsonB
  receivedAt    DateTime @default(now())

  @@index([npi])
  @@index([licenseNumber])
}

model PecosCheck {
  id             String   @id @default(uuid()) @db.Uuid
  npi            String
  enrolled       Boolean
  enrollmentType String?
  rawPayload     Json     @db.JsonB
  checkedAt      DateTime @default(now())

  @@index([npi])
}

model CrossCheckBundle {
  id             String   @id @default(uuid()) @db.Uuid
  artifactId     String
  checksum       String
  crossCheckPass Boolean
  createdAt      DateTime @default(now())

  @@index([artifactId])
}

model VerifierAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  organization String
  acceptedAt   DateTime @default(now())

  @@index([organization])
  @@index([acceptedAt])
}

model PilotOrg {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String
  activatedAt  DateTime @default(now())
  accepted     Boolean  @default(false)
  plans        PilotPlan[]

  @@index([accepted])
  @@index([activatedAt])
}

model PilotPlan {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  startDate      DateTime
  endDate        DateTime?
  active         Boolean  @default(true)
  bundleCount    Int      @default(0)

  organization PilotOrg? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([active])
  @@index([startDate])
}

// ──────────────────────────────────────────────────────────────
// Verifier Onboarding (enterprise registration + token access)
// ──────────────────────────────────────────────────────────────

model VerifierOrg {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  contactName    String
  contactEmail   String
  createdAt      DateTime @default(now())
  lifecycle      VerifierLifecycle @default(REGISTERED)
  pilotActivated Boolean  @default(false)

  tokens VerifierAccessToken[]

  @@index([contactEmail])
  @@index([pilotActivated])
  @@index([lifecycle])
  @@index([createdAt])
}

model VerifierAccessToken {
  id            String   @id @default(uuid()) @db.Uuid
  verifierOrgId String   @db.Uuid
  token         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  verifierOrg VerifierOrg @relation(fields: [verifierOrgId], references: [id])

  @@index([verifierOrgId])
  @@index([token])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────
// Verification Artifacts (primary-source evidence)
// ──────────────────────────────────────────────────────────────

model VerificationArtifact {
  id         String    @id @default(uuid()) @db.Uuid
  npi        String
  source     String
  status     String
  artifactType String  @default("GENERIC") @map("artifact_type")
  parserVersion String? @map("parser_version")
  matchingStrategy String? @map("matching_strategy")
  trustTier  String?   @map("trust_tier")
  confidenceScore Float? @map("confidence_score")
  conflictReason String? @map("conflict_reason")
  mergeReason String? @map("merge_reason")
  sourceRunId String? @db.Uuid @map("source_run_id")
  sourceRecordId String? @db.Uuid @map("source_record_id")
  sourceUrl String? @map("source_url")
  fetchHeaders Json? @db.JsonB @map("fetch_headers")
  fetchedAt DateTime? @map("fetched_at")
  observedAt DateTime? @map("observed_at")
  generation Int?
  supersededByArtifactId String? @db.Uuid @map("superseded_by_artifact_id")
  supersedesArtifactId String? @db.Uuid @map("supersedes_artifact_id")
  rawPayload Json?     @db.JsonB
  checksum   String
  merkleRoot String?
  claimHashes Json?
  lifecycleState String @default("active")
  revokedAt DateTime?
  suspendedAt DateTime?
  revocationReason String?
  statusLastChecked DateTime @default(now())
  psvWindowStart    DateTime?
  psvWindowDeadline DateTime?
  psvWindowCompliant Boolean?
  verifiedAt DateTime
  expiresAt  DateTime?
  monitoring Boolean   @default(false)
  organizationId String? @db.Uuid
  trustState String    @default("needs_review")
  // Wave Y: Expiration forecasting
  daysUntilExpiration  Int?
  forecastRiskLevel    String?   // low | medium | high
  // Wave 40: W3C Bitstring Status List bit assignment
  statusListIndex      Int?
  createdAt  DateTime  @default(now())

  sourceRun SourceRun? @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  sourceRecord SourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  supersededByArtifact VerificationArtifact? @relation("ArtifactSupersededBy", fields: [supersededByArtifactId], references: [id], onDelete: SetNull)
  supersedesArtifact VerificationArtifact? @relation("ArtifactSupersedes", fields: [supersedesArtifactId], references: [id], onDelete: SetNull)
  snapshots AuditSnapshot[]
  claimRecords ClaimRecord[] @relation("ArtifactClaimRecords")
  verificationReceiptRecords VerificationReceiptRecord[] @relation("ArtifactReceiptRecords")
  identityResolutionDecisions IdentityResolutionDecision[] @relation("ArtifactResolutionDecisions")
  identityClaimDeltas IdentityClaimDelta[]
  trustAlertRecords TrustAlertRecord[]
  supersededArtifacts VerificationArtifact[] @relation("ArtifactSupersedes")
  supersedesArtifacts VerificationArtifact[] @relation("ArtifactSupersededBy")

  @@index([npi])
  @@index([source])
  @@index([artifactType])
  @@index([parserVersion])
  @@index([matchingStrategy])
  @@index([trustTier])
  @@index([sourceRunId])
  @@index([sourceRecordId])
  @@index([supersededByArtifactId])
  @@index([supersedesArtifactId])
  @@index([monitoring])
  @@index([organizationId])
  @@index([lifecycleState])
  @@index([revokedAt])
  @@index([suspendedAt])
  @@index([trustState])
  @@index([statusLastChecked])
  @@index([createdAt])
  // Wave M: Performance indexes
  @@index([checksum])
  @@index([merkleRoot])
  // Wave Y: Forecast index
  @@index([forecastRiskLevel])
  // Wave 40: Status list index
  @@index([statusListIndex])
}

model SourceRun {
  id               String          @id @default(uuid()) @db.Uuid
  sourceId         String          @map("source_id")
  subjectNpi       String          @map("subject_npi")
  personProfileId  String?         @db.Uuid @map("person_profile_id")
  idempotencyKey   String          @unique @map("idempotency_key")
  status           SourceRunStatus @default(QUEUED)
  runSummary       Json?           @db.JsonB @map("run_summary")
  lastError        String?         @map("last_error")
  quarantineReason String?         @map("quarantine_reason")
  startedAt        DateTime        @default(now()) @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  sourceRecords               SourceRecord[]
  fetchJobs                   FetchJob[]
  parseJobs                   ParseJob[]
  claimDerivationJobs         ClaimDerivationJob[]
  deltaDetectionJobs          DeltaDetectionJob[]
  alertJobs                   AlertJob[]
  verificationArtifacts       VerificationArtifact[]
  claimRecords                ClaimRecord[]
  verificationReceiptRecords  VerificationReceiptRecord[]
  identityResolutionDecisions IdentityResolutionDecision[]
  identityClaimDeltas         IdentityClaimDelta[]
  trustAlertRecords           TrustAlertRecord[]

  @@index([sourceId, subjectNpi, createdAt])
  @@index([status, createdAt])
  @@map("source_runs")
}

model FetchJob {
  id             String          @id @default(uuid()) @db.Uuid
  sourceRunId    String          @db.Uuid @map("source_run_id")
  state          SourceRunStatus @default(QUEUED)
