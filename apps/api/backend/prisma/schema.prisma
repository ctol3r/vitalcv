// Prisma schema for Chai VC Platform with database seeding support
// Defines User, Credential, and Job models for comprehensive GraphQL operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  passwordHash String?
  credentials Credential[]
  jobs        Job[]
}

model Credential {
  id       Int      @id @default(autoincrement())
  name     String
  issuer   String
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  userId   Int
}

model AuditEvent {
  id           Int      @id @default(autoincrement())
  type         String
  hash         String
  credentialId String?
  userId       Int?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Job {
  id     Int    @id @default(autoincrement())
  title  String
  user   User   @relation(fields: [userId], references: [id])
  userId Int
}

model Org {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  createdAt    DateTime       @default(now())
  roleBindings RoleBinding[]
  invites      Invite[]
}

model RoleBinding {
  id        Int      @id @default(autoincrement())
  role      String
  email     String
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     Int
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
}

model EarlyAccessRequest {
  id        Int      @id @default(autoincrement())
  email     String
  role      String
  orgName   String?
  createdAt DateTime @default(now())
  tokenHash String
  expiresAt DateTime
}

model Invite {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique
  role       String
  orgName    String
  email      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  org        Org?      @relation(fields: [orgId], references: [id])
  orgId      Int?
}

model MetricEvent {
  id            Int       @id @default(autoincrement())
  ts            DateTime  @default(now())
  type          String
  actorRole     String?
  orgId         Int?
  credentialId  String?
  durationMs    Int?
  completionPct Float?
  metaJson      Json?
}
