generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Auth & RBAC: User identity linked to Clerk
// ──────────────────────────────────────────────────────────────

enum UserRole {
  CLINICIAN
  VERIFIER
  ISSUER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum NpiDidBindingStatus {
  ACTIVE
  CONTESTED
  REVOKED
  PENDING
}

enum IssuerSigningKeyState {
  ACTIVE
  GRACE
  RETIRED
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  clerkUserId    String     @unique
  email          String     @unique
  role           UserRole   @default(CLINICIAN)
  roleVersion    Int        @default(1)
  status         UserStatus @default(INVITED)
  organizationId String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  personProfile  PersonProfile?
  workspacePreference WorkspacePreference?

  @@index([clerkUserId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────
// Canonical Path: Recognition → Acceptance → Start
// ──────────────────────────────────────────────────────────────

model Recognition {
  id              String    @id @default(uuid()) @db.Uuid
  recognitionId   String    @unique
  subjectId       String
  employerId      String
  recognizedAt    DateTime
  verifiedAt      DateTime
  verificationRef String
  expiresAt       DateTime?
  revokedAt       DateTime?
  revocationRef   String?
  eventHash       String
  createdAt       DateTime  @default(now())

  acceptances Acceptance[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
}

model Acceptance {
  id              String   @id @default(uuid()) @db.Uuid
  acceptanceId    String   @unique
  recognitionId   String
  subjectId       String
  employerId      String
  facilityId      String
  acceptedAt      DateTime
  psvReportId     String
  eventHash       String
  createdAt       DateTime @default(now())

  recognition Recognition @relation(fields: [recognitionId], references: [recognitionId])
  starts      Start[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
  @@index([acceptanceId])
}

model Start {
  id           String   @id @default(uuid()) @db.Uuid
  startId      String   @unique
  acceptanceId String
  subjectId    String
  employerId   String
  attestedAt   DateTime
  eventHash    String
  createdAt    DateTime @default(now())

  acceptance Acceptance @relation(fields: [acceptanceId], references: [acceptanceId])

  @@index([subjectId])
  @@index([employerId])
  @@index([acceptanceId])
  @@index([startId])
}

// ──────────────────────────────────────────────────────────────
// PSV Receipts (verification evidence)
// ──────────────────────────────────────────────────────────────

model PsvReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptId       String   @unique
  clinicianId     String
  sourceAuthority String
  licenseId       String
  transactionId   String
  fetchedAt       DateTime
  responseHash    String
  ttlSeconds      Int
  revoked         Boolean  @default(false)
  lane            String?
  verificationCheck   String?
  verificationOutcome String?
  failureReason       String?
  source              String?
  attestorId          String?
  verificationRequestId String?
  createdAt       DateTime @default(now())

  @@index([clinicianId])
  @@index([receiptId])
}

// ──────────────────────────────────────────────────────────────
// Clinician Intake (ingestion staging)
// ──────────────────────────────────────────────────────────────

model ClinicianIdentity {
  id           String   @id @default(uuid()) @db.Uuid
  clinicianId  String   @unique
  data         Json     @db.JsonB
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NpiDidBinding {
  id                String              @id @default(uuid()) @db.Uuid
  npi               String              @unique
  did               String              @unique
  sourceFingerprint String
  recipeVersion     String              @default("1.0.0")
  evidencePointers  Json                @db.JsonB
  status            NpiDidBindingStatus @default(ACTIVE)
  contestReason     String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([npi])
  @@index([did])
  @@map("npi_did_binding")
}

model CandidateCredential {
  id                     String   @id @default(uuid()) @db.Uuid
  candidateCredentialId  String   @unique
  clinicianId            String
  data                   Json     @db.JsonB
  status                 String   @default("UNVERIFIED")
  createdAt              DateTime @default(now())

  @@index([clinicianId])
}

model IngestConflict {
  id           String   @id @default(uuid()) @db.Uuid
  conflictId   String   @unique
  clinicianId  String
  status       String   @default("UNRESOLVED")
  data         Json     @db.JsonB
  createdAt    DateTime @default(now())

  @@index([clinicianId])
}

model IdempotentResponse {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  auditRef    String
  payload     Json     @db.JsonB
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([key])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────
// API Key → Organization mapping
// ──────────────────────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  keyHash      String    @unique
  orgName      String
  orgId        String
  permissions  String[]  @default(["write:recognitions", "write:acceptances", "write:starts", "write:ingest"])
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([orgId])
}

model ParRequest {
  id                   String   @id @default(uuid()) @db.Uuid
  requestUri           String   @unique
  requestType          String
  requestJson          Json
  clientId             String
  codeChallenge        String?
  codeChallengeMethod  String?
  redirectUri          String?
  scope                String?
  expiresAt            DateTime
  used                 Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([requestType])
  @@index([expiresAt])
  @@index([createdAt])
}

model JtiReplay {
  service   String
  jti       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([service, jti])
  @@index([expiresAt])
}

model RefreshToken {
  tokenId   String   @id
  clientId  String?
  userId    String?
  scope     String
  cnfJkt    String?
  clientCert String?
  issuedAt  DateTime
  expiresAt DateTime
  rotated   Boolean  @default(false)
  rotatedTo String?
}

model VerifierNonce {
  nonce     String   @id
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([used])
  @@index([expiresAt])
}

enum VerificationRequestStatus {
  PENDING
  COMPLETE
  FAILED
}

enum VerifierLifecycle {
  REGISTERED
  TOKEN_SENT
  TOKEN_USED
  PILOT_ACTIVATED
  BUNDLE_GENERATED
}

model VerificationRequest {
  requestId       String                   @id @default(uuid()) @db.Uuid
  clinicianId     String
  lane            String
  source          String
  attestorId      String?
  documentHash    String?
  subject         String
  status          VerificationRequestStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  completedAt     DateTime?
  receiptId       String?
  failureReason   String?

  @@index([clinicianId])
  @@index([status])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Verifier Pilot: Cross-check share links and acceptance actions
// ──────────────────────────────────────────────────────────────

model ShareLink {
  id             String   @id @default(uuid()) @db.Uuid
  npi            String
  firstViewedAt  DateTime?
  organizationId String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([npi])
  @@index([organizationId])
  @@index([createdAt])
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organizationProfile OrganizationProfile?
  activeWorkspacePreferences WorkspacePreference[] @relation("WorkspacePreferenceActiveOrganization")
}

/// NPI classification
enum NpiType {
  TYPE_1
  TYPE_2
}

/// Workspace persona a user is currently operating as
enum ActivePersona {
  CLINICIAN
  VERIFIER
  BOTH
}

/// Membership role within an organization workspace
enum MembershipRole {
  HOLDER
  VERIFIER
  ISSUER
  ADMIN
  RECRUITER
  CREDENTIALING_SPECIALIST
}

/// Linked profile for an individual clinician (Type 1 NPI)
model PersonProfile {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @unique @db.Uuid @map("user_id")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  npi             String?               @unique
  npiType         NpiType?              @default(TYPE_1) @map("npi_type")
  firstName       String?               @map("first_name")
  lastName        String?               @map("last_name")
  specialty       String?
  stateOfPractice String?               @map("state_of_practice")
  workAuthStatus  String?               @map("work_auth_status")
  resumeUrl       String?               @map("resume_url")
  linkedinUrl     String?               @map("linkedin_url")
  portfolioUrl    String?               @map("portfolio_url")
  completeness    Int                   @default(0)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  memberships     WorkspaceMembership[]

  @@index([npi])
  @@index([userId])
  @@map("person_profiles")
}

/// Linked profile for an organization (Type 2 NPI or Org DID)
model OrganizationProfile {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @unique @db.Uuid @map("organization_id")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  npi            String?
  npiType        NpiType?              @default(TYPE_2) @map("npi_type")
  orgDid         String?               @map("org_did")
  facilityType   String?               @map("facility_type")
  specialties    String[]
  statesCovered  String[]              @map("states_covered")
  website        String?
  // Wave 186: Employer intelligence fields
  tagline        String?
  description    String?
  trustScore     Int                   @default(0) @map("trust_score")
  openRoles      Int                   @default(0) @map("open_roles")
  recentHires    Int                   @default(0) @map("recent_hires")
  hiringStatus   EmployerHiringStatus  @default(NOT_HIRING) @map("hiring_status")
  hiringTypes    String[]              @map("hiring_types")
  timeToStart    String?               @map("time_to_start")
  timeToOnboard  String?               @map("time_to_onboard")
  clearToStartThreshold String?        @map("clear_to_start_threshold")
  payTransparency Boolean              @default(false) @map("pay_transparency")
  payRange       String?               @map("pay_range")
  requirements   Json                  @default("[]") @db.JsonB
  verifiedSince  DateTime?             @map("verified_since")
  verified       Boolean               @default(false)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  memberships    WorkspaceMembership[]

  @@index([npi])
  @@index([organizationId])
  @@index([hiringStatus])
  @@index([trustScore])
  @@map("organization_profiles")
}

enum EmployerHiringStatus {
  HIRING_NOW
  ACTIVELY_HIRING
  ACCEPTING_APPLICATIONS
  NOT_HIRING
}

/// Links a person to an organization with a role
model WorkspaceMembership {
  id                    String              @id @default(uuid()) @db.Uuid
  personProfileId       String              @db.Uuid @map("person_profile_id")
  personProfile         PersonProfile       @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  organizationProfileId String              @db.Uuid @map("organization_profile_id")
  organizationProfile   OrganizationProfile @relation(fields: [organizationProfileId], references: [id], onDelete: Cascade)
  role                  MembershipRole      @default(VERIFIER)
  active                Boolean             @default(true)
  invitedAt             DateTime?           @map("invited_at")
  acceptedAt            DateTime?           @map("accepted_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@unique([personProfileId, organizationProfileId])
  @@index([personProfileId])
  @@index([organizationProfileId])
  @@map("workspace_memberships")
}

/// Per-user workspace preferences and active persona state
model WorkspacePreference {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePersona     ActivePersona @default(CLINICIAN) @map("active_persona")
  activeOrgId       String?       @db.Uuid @map("active_org_id")
  activeOrganization Organization? @relation("WorkspacePreferenceActiveOrganization", fields: [activeOrgId], references: [id], onDelete: SetNull)
  sidebarCollapsed  Boolean       @default(false) @map("sidebar_collapsed")
  lastSwitchedAt    DateTime?     @map("last_switched_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("workspace_preferences")
}

model NursysEvent {
  id            String   @id @default(uuid()) @db.Uuid
  npi           String
  licenseNumber String
  state         String
  eventType     String
  rawPayload    Json     @db.JsonB
  receivedAt    DateTime @default(now())

  @@index([npi])
  @@index([licenseNumber])
}

model PecosCheck {
  id             String   @id @default(uuid()) @db.Uuid
  npi            String
  enrolled       Boolean
  enrollmentType String?
  rawPayload     Json     @db.JsonB
  checkedAt      DateTime @default(now())

  @@index([npi])
}

model CrossCheckBundle {
  id             String   @id @default(uuid()) @db.Uuid
  artifactId     String
  checksum       String
  crossCheckPass Boolean
  createdAt      DateTime @default(now())

  @@index([artifactId])
}

model VerifierAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  organization String
  acceptedAt   DateTime @default(now())

  @@index([organization])
  @@index([acceptedAt])
}

model PilotOrg {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String
  activatedAt  DateTime @default(now())
  accepted     Boolean  @default(false)
  plans        PilotPlan[]

  @@index([accepted])
  @@index([activatedAt])
}

model PilotPlan {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  startDate      DateTime
  endDate        DateTime?
  active         Boolean  @default(true)
  bundleCount    Int      @default(0)

  organization PilotOrg? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([active])
  @@index([startDate])
}

// ──────────────────────────────────────────────────────────────
// Verifier Onboarding (enterprise registration + token access)
// ──────────────────────────────────────────────────────────────

model VerifierOrg {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  contactName    String
  contactEmail   String
  createdAt      DateTime @default(now())
  lifecycle      VerifierLifecycle @default(REGISTERED)
  pilotActivated Boolean  @default(false)

  tokens VerifierAccessToken[]

  @@index([contactEmail])
  @@index([pilotActivated])
  @@index([lifecycle])
  @@index([createdAt])
}

model VerifierAccessToken {
  id            String   @id @default(uuid()) @db.Uuid
  verifierOrgId String   @db.Uuid
  token         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  verifierOrg VerifierOrg @relation(fields: [verifierOrgId], references: [id])

  @@index([verifierOrgId])
  @@index([token])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────
// Verification Artifacts (primary-source evidence)
// ──────────────────────────────────────────────────────────────

model VerificationArtifact {
  id         String    @id @default(uuid()) @db.Uuid
  npi        String
  source     String
  status     String
  rawPayload Json?     @db.JsonB
  checksum   String
  merkleRoot String?
  claimHashes Json?
  lifecycleState String @default("active")
  revokedAt DateTime?
  suspendedAt DateTime?
  revocationReason String?
  statusLastChecked DateTime @default(now())
  psvWindowStart    DateTime?
  psvWindowDeadline DateTime?
  psvWindowCompliant Boolean?
  verifiedAt DateTime
  expiresAt  DateTime?
  monitoring Boolean   @default(false)
  organizationId String? @db.Uuid
  trustState String    @default("needs_review")
  // Wave Y: Expiration forecasting
  daysUntilExpiration  Int?
  forecastRiskLevel    String?   // low | medium | high
  // Wave 40: W3C Bitstring Status List bit assignment
  statusListIndex      Int?
  createdAt  DateTime  @default(now())

  snapshots AuditSnapshot[]

  @@index([npi])
  @@index([source])
  @@index([monitoring])
  @@index([organizationId])
  @@index([lifecycleState])
  @@index([revokedAt])
  @@index([suspendedAt])
  @@index([trustState])
  @@index([statusLastChecked])
  @@index([createdAt])
  // Wave M: Performance indexes
  @@index([checksum])
  @@index([merkleRoot])
  // Wave Y: Forecast index
  @@index([forecastRiskLevel])
  // Wave 40: Status list index
  @@index([statusListIndex])
}

model TrustedIssuer {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  did          String    @unique
  publicKeyJwk Json      @db.JsonB
  publicKeyPem String    @default("")
  trustLevel   String    @default("PROVISIONAL")
  status       String    @default("ACTIVE")
  trustScore   Int?
  verificationCount Int?
  revocationCount   Int?
  lastScoredAt DateTime?
  assuranceProfile String?
  algorithmPolicy String[] @default([])
  haipCompliant Boolean?
  federationEntityId String?
  federationTrustChain String[] @default([])
  federatedAt DateTime?
  registryMetadata Json? @db.JsonB
  active       Boolean   @default(true)
  organizationId String?  @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([trustLevel])
  @@index([active])
}

model IssuerSigningKey {
  id                     String                @id @default(uuid()) @db.Uuid
  issuerDid              String
  kid                    String                @unique
  algorithm              String
  publicKeyJwk           Json                  @db.JsonB
  encryptedPrivateKeyJwk String
  state                  IssuerSigningKeyState @default(ACTIVE)
  createdAt              DateTime              @default(now())
  activatesAt            DateTime              @default(now())
  expiresAt              DateTime
  graceUntil             DateTime?
  retiredAt              DateTime?
  rotatedFromKid         String?
  lastUsedAt             DateTime?

  @@index([issuerDid, state])
  @@index([issuerDid, activatesAt])
  @@index([graceUntil])
  @@index([rotatedFromKid])
}

model IssuedCredentialRecord {
  id                String   @id @default(uuid()) @db.Uuid
  credentialId      String   @unique
  issuerDid         String
  holderDid         String
  credentialType    String
  format            String
  kid               String
  claimDigests      Json     @db.JsonB
  disclosureDigests String[] @default([])
  holderBindingHash String
  statusReference   String?
  receiptId         String   @unique
  auditEventId      String   @unique
  issuedAt          DateTime
  expiresAt         DateTime?
  revokedAt         DateTime?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([issuerDid, createdAt])
  @@index([holderDid, createdAt])
  @@index([kid])
  @@index([status])
  @@index([revokedAt])
}

model CredentialTransparencyLog {
  id            String    @id @default(uuid()) @db.Uuid
  artifactId    String
  fingerprint   String
  merkleRoot    String
  lifecycleState String
  organizationId String?   @db.Uuid
  createdAt     DateTime  @default(now())

  @@index([artifactId])
  @@index([fingerprint])
  @@index([organizationId])
}

model TrustAlertRecord {
  id                String   @id @default(uuid()) @db.Uuid
  alertId           String   @unique
  type              String
  severity          String
  title             String
  description       String
  credentialId      String?
  issuerId          String?
  subject           String?
  recommendedAction String
  acknowledged      Boolean  @default(false)
  acknowledgedAt    DateTime?
  createdAt         DateTime @default(now())

  @@index([severity, createdAt])
  @@index([acknowledged, createdAt])
  @@index([issuerId])
  @@index([subject])
}

model OrganizationTrust {
  id                  String   @id @default(uuid()) @db.Uuid
  sourceOrgId         String   @db.Uuid
  targetOrgId         String   @db.Uuid
  trustLevel          String
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@index([sourceOrgId])
  @@index([targetOrgId])
}

model TrustLedgerEntry {
  id         String   @id @default(uuid()) @db.Uuid
  artifactId String?
  npi        String?
  action     String
  hash       String
  organizationId String?
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now())

  @@index([npi])
  @@index([organizationId])
  @@index([createdAt])
  // Wave M: Performance index for transparency log queries
  @@index([artifactId])
}

model AuditSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  artifactId String   @db.Uuid
  snapshot   Json     @db.JsonB
  createdAt  DateTime @default(now())

  artifact VerificationArtifact @relation(fields: [artifactId], references: [id])

  @@index([artifactId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Audit Trail (append-only event log)
// ──────────────────────────────────────────────────────────────

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  type           String
  hash           String
  referenceId    String?
  clinicianId    String?
  organizationId String?
  metadata       Json?    @db.JsonB
  anchored       Boolean  @default(false)
  merkleRoot     String?
  createdAt      DateTime @default(now())

  @@index([type, createdAt])
  @@index([clinicianId])
  @@index([referenceId])
  @@index([organizationId])
  @@index([anchored])
  @@index([merkleRoot])
}

// ──────────────────────────────────────────────────────────────
// Continuous Monitoring (status change detection)
// ──────────────────────────────────────────────────────────────

model MonitoringEvent {
  id             String    @id @default(uuid()) @db.Uuid
  npi            String
  source         String
  organizationId  String?   @db.Uuid
  previousStatus String?
  newStatus      String
  detectedAt     DateTime  @default(now())

  @@index([npi])
  @@index([organizationId])
  @@index([source])
  @@index([detectedAt])
}

model CredentialMonitoringEvent {
  id             String   @id @default(uuid()) @db.Uuid
  artifactId     String
  organizationId String   @db.Uuid
  eventType      String
  createdAt      DateTime @default(now())

  @@index([artifactId])
  @@index([organizationId])
}

// ──────────────────────────────────────────────────────────────
// Wave R: Onboarding Analytics (revenue signal computation)
// ──────────────────────────────────────────────────────────────

model OnboardingAnalytics {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String
  artifactId          String
  createdAt           DateTime  @default(now())
  firstVerifiedAt     DateTime?
  firstProofIssuedAt  DateTime?
  psvCompletedAt      DateTime?
  daysToVerification  Int?
  daysToPSVCompletion Int?

  @@index([organizationId])
  @@index([artifactId])
}

model MissionOpsOnboardingFlow {
  id              String   @id @default(uuid()) @db.Uuid
  role            String
  entityId        String
  entityName      String
  stages          Json     @db.JsonB
  overallProgress Int      @default(0)
  createdAt       DateTime @default(now())
  lastUpdated     DateTime @updatedAt

  @@unique([role, entityId])
  @@index([role, lastUpdated])
  @@index([entityId])
}

model AuditReceiptRecord {
  id        String   @id @default(uuid()) @db.Uuid
  receiptId String   @unique
  type      String
  status    String
  issuedAt  DateTime
  hash      String
  payload   Json     @db.JsonB
  summary   String
  actor     String
  subject   String
  createdAt DateTime @default(now())

  @@index([type, issuedAt])
  @@index([status, issuedAt])
  @@index([actor])
  @@index([subject])
}

// ──────────────────────────────────────────────────────────────
// Wave T: System Failure Events (observability + isolation)
// ──────────────────────────────────────────────────────────────

model SystemFailureEvent {
  id             String   @id @default(uuid()) @db.Uuid
  component      String
  severity       String   // "warning", "error", "critical"
  message        String
  artifactId     String?
  organizationId String?
  createdAt      DateTime @default(now())

  @@index([severity])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Wave 2A: Normalized persistence (Provider → VerificationRun → Artifact)
// ──────────────────────────────────────────────────────────────

model Provider {
  id              String   @id @default(uuid()) @db.Uuid
  npi             String   @unique
  fullName        String
  providerType    String
  taxonomyCode    String
  stateOfPractice String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verificationRuns VerificationRun[]
}

model VerificationRun {
  id              String   @id @default(uuid()) @db.Uuid
  providerId      String   @db.Uuid
  sourceName      String
  retrievedAtUtc  DateTime
  rawPayloadHash  String
  artifactHash    String
  createdAt       DateTime @default(now())

  provider  Provider   @relation(fields: [providerId], references: [id])
  artifacts W2Artifact[]
}

model W2Artifact {
  id                  String   @id @default(uuid()) @db.Uuid
  verificationRunId   String   @db.Uuid
  artifactJson        Json     @db.JsonB
  signature           String
  signatureAlgorithm  String
  signatureIssuedAt   DateTime
  createdAt           DateTime @default(now())

  verificationRun VerificationRun @relation(fields: [verificationRunId], references: [id])
  deltaLogs       DeltaLog[]
}

model DeltaLog {
  id             String   @id @default(uuid()) @db.Uuid
  artifactId     String   @db.Uuid
  previousStatus String
  newStatus      String
  deltaHash      String
  detectedAt     DateTime @default(now())

  artifact W2Artifact @relation(fields: [artifactId], references: [id])
}

// ──────────────────────────────────────────────────────────────
// Wave 36: Clinical Ontology Engine — Superbrain data models
// ──────────────────────────────────────────────────────────────

model MedicalSchool {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  location             String
  accreditation_status String   @default("LCME")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  residencyPrograms ResidencyProgram[]

  @@index([name])
  @@index([accreditation_status])
}

model ResidencyProgram {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String
  specialty            String
  acgme_code           String        @unique
  hospital_affiliation String
  medicalSchoolId      String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  medicalSchool MedicalSchool? @relation(fields: [medicalSchoolId], references: [id])

  @@index([specialty])
  @@index([acgme_code])
  @@index([hospital_affiliation])
}

model SpecialtyTaxonomy {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  board_name  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([board_name])
}

model StateComplianceRule {
  id                        String   @id @default(uuid()) @db.Uuid
  state_code                String
  specialty                 String
  required_credential_types String[]
  renewal_window_days       Int      @default(365)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([state_code, specialty])
  @@index([state_code])
  @@index([specialty])
}

// ──────────────────────────────────────────────────────────────
// Wave 40: W3C Bitstring Status List — singleton bitstring state
// ──────────────────────────────────────────────────────────────

model StatusListState {
  /// Singleton row — always "singleton"
  id        String   @id @default("singleton")
  /// GZIP-compressed, Base64URL-encoded bitstring (W3C spec §3.1)
  encoded   String
  /// Monotonically increasing version counter for cache-busting
  version   Int      @default(0)
  /// Total bits allocated (131 072 minimum per W3C spec)
  sizeBits  Int      @default(131072)
  /// Next available bit index to assign
  nextIndex Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────
// Wave 40: Enterprise Webhook Dispatcher — per-employer webhook config
// ──────────────────────────────────────────────────────────────

model EmployerWebhookConfig {
  id            String   @id @default(uuid()) @db.Uuid
  /// Domain-level employer identifier (matches Acceptance.employerId)
  employerId    String   @unique
  webhookUrl    String
  /// HMAC-SHA256 signing secret for X-VitalCV-Signature
  signingSecret String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

// ──────────────────────────────────────────────────────────────
// Wave 41: Start Attestation Engine — Golden Path / ON Loop
// ──────────────────────────────────────────────────────────────

/// An employer's formal decision to accept a clinician after reviewing
/// their verified credential bundle.  This is the first half of the
/// ON Loop — the moment an employer says "we will hire this person".
model EmployerAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  /// Internal employer identifier (domain-level, not a FK to preserve loose coupling).
  employerId   String
  /// 10-digit NPI of the clinician being accepted.
  clinicianNpi String
  /// Optional: the VerificationArtifact that anchored the decision.
  artifactId   String?
  /// PENDING | ACCEPTED | WITHDRAWN
  status       String   @default("ACCEPTED")
  acceptedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  startAttestations StartAttestation[]

  @@index([clinicianNpi])
  @@index([employerId])
  @@index([status])
  @@index([acceptedAt])
}

/// The employer's final, cryptographically-anchored confirmation that the
/// clinician has started their role.  Closing this record closes the ON Loop.
/// The `anchoredRoot` ties this record to the Wave 35 Merkle audit ledger.
model StartAttestation {
  id           String   @id @default(uuid()) @db.Uuid
  acceptanceId String   @db.Uuid
  /// Clinical role title (e.g. "Attending Cardiologist").
  role         String
  /// Facility or unit identifier.
  facility     String
  /// The attested start date/time (employer-supplied; may be future-dated).
  startedAt    DateTime
  /// Merkle root of the AuditEvent batch that includes this attestation.
  /// Null until the Wave 35 merkleBatcher anchors the pending event.
  anchoredRoot String?
  createdAt    DateTime @default(now())

  acceptance    EmployerAcceptance @relation(fields: [acceptanceId], references: [id])
  billingEvents BillingEvent[]

  @@index([acceptanceId])
  @@index([startedAt])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Wave 42: Outcomes Billing Engine — per-hire Stripe billing
// ──────────────────────────────────────────────────────────────

/// Append-only financial truth record.  One row is created for every
/// successful StartAttestation, recording the Stripe billing outcome.
/// status lifecycle: PENDING → BILLED | SKIPPED | ERROR
model BillingEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  employerId          String
  startAttestationId  String   @db.Uuid
  /// Stripe invoiceitem.id — null until the async Stripe call resolves.
  stripeInvoiceItemId String?
  /// Stripe customer.id resolved or created for this employer.
  stripeCustomerId    String?
  /// Fee in smallest currency unit (cents). Default: $37.99 = 3799 cents.
  amountCents         Int      @default(3799)
  currency            String   @default("usd")
  /// PENDING | BILLED | SKIPPED | ERROR
  status              String   @default("PENDING")
  /// Populated when status = ERROR.
  errorMessage        String?
  createdAt           DateTime @default(now())

  startAttestation StartAttestation @relation(fields: [startAttestationId], references: [id])

  @@index([employerId])
  @@index([startAttestationId])
  @@index([status])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Wave 46: Authority-Bound Knowledge Graph (AKG)
// ──────────────────────────────────────────────────────────────

/// Generic graph node representing any entity in the AKG.
/// entityType discriminates the kind (CLINICIAN, ISSUER, CREDENTIAL, POLICY, FACILITY).
/// entityId references the primary key in the source-of-truth table.
/// attributes stores denormalized metadata as JSON for fast graph queries.
model KnowledgeNode {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   // CLINICIAN | ISSUER | CREDENTIAL | POLICY | FACILITY
  entityId   String   // FK to the source table row
  label      String   // Human-readable label
  attributes Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outEdges AuthorityEdge[] @relation("EdgeSource")
  inEdges  AuthorityEdge[] @relation("EdgeTarget")

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityId])
}

/// Directed edge in the AKG representing an authority relationship.
/// relationType encodes the semantic meaning (VERIFIED_BY, ISSUED_TO, COMPLIES_WITH, REQUIRED_BY, ATTESTED_BY).
/// cryptographicProof optionally stores a hash or signature anchoring this edge to the trust ledger.
model AuthorityEdge {
  id                 String   @id @default(uuid()) @db.Uuid
  sourceNodeId       String   @db.Uuid
  targetNodeId       String   @db.Uuid
  relationType       String   // VERIFIED_BY | ISSUED_TO | COMPLIES_WITH | REQUIRED_BY | ATTESTED_BY
  weight             Float    @default(1.0) // Trust weight for scoring
  cryptographicProof String?  // Optional hash/signature
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())

  source KnowledgeNode @relation("EdgeSource", fields: [sourceNodeId], references: [id])
  target KnowledgeNode @relation("EdgeTarget", fields: [targetNodeId], references: [id])

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([relationType])
  @@index([sourceNodeId, relationType])
}

// ── Wave 115: Subscription Billing & API Keys ────────────────────────

model Subscription {
  id               String   @id @default(uuid()) @db.Uuid
  clinicianId      String   @db.Uuid
  tier             String   // STARTER | GROWTH | ENTERPRISE
  status           String   @default("active") // active | canceled | past_due
  stripeSubId      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clinicianId])
  @@index([status])
}

model SubscriptionApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  clinicianId  String    @db.Uuid
  keyHash      String    @unique
  name         String
  tier         String    @default("STARTER")
  requestCount Int       @default(0)
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([clinicianId])
  @@index([keyHash])
}

// ── Wave 119: Feedback ───────────────────────────────────────────────

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   // nps | bug | feature
  score     Int?
  message   String
  email     String?
  createdAt DateTime @default(now())

  @@index([type])
}

// ── Wave A (Phase 1 Hardening): Decision Capsule Infrastructure ──────────────

/// Immutable audit record of an operational decision (hiring, privileging,
/// deployment, renewal) with a cryptographic snapshot of the credential
/// bundle that supported it. Status transitions record revocation cascade
/// impact: VALID → AT_RISK → INVALID.
model DecisionCapsule {
  id                String   @id @default(uuid()) @db.Uuid

  /// Decentralized Identifier of the clinician subject
  subjectDid        String

  /// 10-digit NPI of the clinician subject
  subjectNpi        String

  /// HIRING | PRIVILEGING | DEPLOYMENT | RENEWAL
  decisionType      String

  /// When the decision was made (immutable after creation)
  decisionTimestamp DateTime

  /// IDs of VerificationArtifacts that supported this decision
  credentialIds     String[]

  /// IDs of trusted issuers involved in this decision
  issuerIds         String[]

  /// SHA-256 hash of the full credential bundle snapshot at decision time
  artifactHash      String

  /// Evaluation methodology version (e.g. "CRS_v1.0")
  methodology       String   @default("CRS_v1.0")

  /// VALID | AT_RISK | INVALID
  status            String   @default("VALID")

  /// Arbitrary context: employerId, deploymentRef, notes
  metadata          Json     @default("{}")  @db.JsonB

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subjectNpi])
  @@index([subjectDid])
  @@index([status])
  @@index([decisionType])
  @@index([decisionTimestamp])
  @@index([subjectNpi, status])
}

// ── Wave 184: Unified Search Index & Content Graph ───────────────────────────

/// Object type classifications for the search index
enum SearchObjectType {
  PUBLIC_PAGE
  EMPLOYER_PROFILE
  OPPORTUNITY
  ISSUER_PROFILE
  TRUST_STATE_SUMMARY
  AUDIT_EVENT_SUMMARY
  FAQ_DOC
  CONNECTED_RECORD
}

/// ACL visibility levels
enum SearchAclLevel {
  PUBLIC        // anyone can see
  AUTHENTICATED // any logged-in user
  HOLDER        // clinician workspace only
  VERIFIER      // verifier/employer workspace only
  ADMIN         // internal only
}

/// Indexed search object — the core retrieval unit
model SearchObject {
  id            String           @id @default(uuid()) @db.Uuid
  type          SearchObjectType
  title         String
  /// Plain-text body — used for BM25 keyword search
  body          String
  /// Source URL or internal path
  sourceUrl     String?
  /// External reference id (opportunity id, issuer id, etc.)
  referenceId   String?
  /// ACL gate
  aclLevel      SearchAclLevel   @default(PUBLIC)
  /// JSON metadata (specialty, state, pay, etc.)
  metadata      Json             @default("{}") @db.JsonB
  /// Embedding vector stored as float array (pgvector-ready)
  embedding     Float[]
  /// ISO timestamp of source freshness
  indexedAt     DateTime         @default(now())
  freshAt       DateTime?
  active        Boolean          @default(true)

  acl           SearchObjectACL[]

  @@index([type])
  @@index([aclLevel])
  @@index([active])
  @@index([type, active])
  @@index([referenceId])
}

/// Fine-grained ACL: which role/org can access which search object
model SearchObjectACL {
  id             String          @id @default(uuid()) @db.Uuid
  searchObjectId String          @db.Uuid
  searchObject   SearchObject    @relation(fields: [searchObjectId], references: [id], onDelete: Cascade)
  /// If set, only users with this role can see the object
  roleRequired   String?
  /// If set, only members of this org can see the object
  orgId          String?         @db.Uuid
  createdAt      DateTime        @default(now())

  @@index([searchObjectId])
  @@index([orgId])
}

/// Index job run log
model SearchIndexRun {
  id           String   @id @default(uuid()) @db.Uuid
  objectType   String
  totalIndexed Int      @default(0)
  totalSkipped Int      @default(0)
  totalErrors  Int      @default(0)
  durationMs   Int?
  status       String   @default("PENDING")  // PENDING | RUNNING | DONE | FAILED
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  errorMessage String?

  @@index([status])
  @@index([objectType])
}
