enum WatchlistTargetType {
  PROVIDER
  INSTITUTION
  CLAIM_CLASS
}

enum AlertDeliveryChannel {
  INTERNAL_FEED
  WEBHOOK
  EVENT_SINK
  EMAIL
  SLACK
}

enum AlertDeliveryStatus {
  DELIVERED
  PENDING
  SUPPRESSED
  DEDUPED
  FAILED
  NOT_CONFIGURED
}

enum StorylineType {
  TRUST_DECLINE
  RISING_INVESTIGATOR
  NETWORK_EMERGENCE
  COMPLIANCE_RISK
  WORKFORCE_OPPORTUNITY
  INSTITUTION_SHIFT
  INDUSTRY_INFLUENCE
