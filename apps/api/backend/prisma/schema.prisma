generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Auth & RBAC: User identity linked to Clerk
// ──────────────────────────────────────────────────────────────

enum UserRole {
  CLINICIAN
  VERIFIER
  ISSUER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum NpiDidBindingStatus {
  ACTIVE
  CONTESTED
  REVOKED
  PENDING
}

enum IssuerSigningKeyState {
  ACTIVE
  GRACE
  RETIRED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  clerkUserId         String               @unique
  email               String               @unique
  role                UserRole             @default(CLINICIAN)
  roleVersion         Int                  @default(1)
  status              UserStatus           @default(INVITED)
  organizationId      String?              @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  personProfile       PersonProfile?
  workspacePreference WorkspacePreference?
  passkeyCredentials  PasskeyCredential[]
  npiOwnerships       NpiOwnership[]

  @@index([clerkUserId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────
// Canonical Path: Recognition → Acceptance → Start
// ──────────────────────────────────────────────────────────────

model Recognition {
  id              String    @id @default(uuid()) @db.Uuid
  recognitionId   String    @unique
  subjectId       String
  employerId      String
  recognizedAt    DateTime
  verifiedAt      DateTime
  verificationRef String
  expiresAt       DateTime?
  revokedAt       DateTime?
  revocationRef   String?
  eventHash       String
  createdAt       DateTime  @default(now())

  acceptances Acceptance[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
}

model Acceptance {
  id            String   @id @default(uuid()) @db.Uuid
  acceptanceId  String   @unique
  recognitionId String
  subjectId     String
  employerId    String
  facilityId    String
  acceptedAt    DateTime
  psvReportId   String
  eventHash     String
  createdAt     DateTime @default(now())

  recognition Recognition @relation(fields: [recognitionId], references: [recognitionId])
  starts      Start[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
  @@index([acceptanceId])
}

model Start {
  id           String   @id @default(uuid()) @db.Uuid
  startId      String   @unique
  acceptanceId String
  subjectId    String
  employerId   String
  attestedAt   DateTime
  eventHash    String
  createdAt    DateTime @default(now())

  acceptance Acceptance @relation(fields: [acceptanceId], references: [acceptanceId])

  @@index([subjectId])
  @@index([employerId])
  @@index([acceptanceId])
  @@index([startId])
}

// ──────────────────────────────────────────────────────────────
// PSV Receipts (verification evidence)
// ──────────────────────────────────────────────────────────────

model PsvReceipt {
  id                    String   @id @default(uuid()) @db.Uuid
  receiptId             String   @unique
  clinicianId           String
  sourceAuthority       String
  licenseId             String
  transactionId         String
  fetchedAt             DateTime
  responseHash          String
  ttlSeconds            Int
  revoked               Boolean  @default(false)
  lane                  String?
  verificationCheck     String?
  verificationOutcome   String?
  failureReason         String?
  source                String?
  attestorId            String?
  verificationRequestId String?
  createdAt             DateTime @default(now())

  @@index([clinicianId])
  @@index([receiptId])
}

// ──────────────────────────────────────────────────────────────
// Clinician Intake (ingestion staging)
// ──────────────────────────────────────────────────────────────

model ClinicianIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  clinicianId String   @unique
  data        Json     @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NpiDidBinding {
  id                String              @id @default(uuid()) @db.Uuid
  npi               String              @unique
  did               String              @unique
  sourceFingerprint String
  recipeVersion     String              @default("1.0.0")
  evidencePointers  Json                @db.JsonB
  status            NpiDidBindingStatus @default(ACTIVE)
  contestReason     String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([npi])
  @@index([did])
  @@map("npi_did_binding")
}

model CandidateCredential {
  id                    String   @id @default(uuid()) @db.Uuid
  candidateCredentialId String   @unique
  clinicianId           String
  data                  Json     @db.JsonB
  status                String   @default("UNVERIFIED")
  createdAt             DateTime @default(now())

  @@index([clinicianId])
}

model IngestConflict {
  id          String   @id @default(uuid()) @db.Uuid
  conflictId  String   @unique
  clinicianId String
  status      String   @default("UNRESOLVED")
  data        Json     @db.JsonB
  createdAt   DateTime @default(now())

  @@index([clinicianId])
}

model IdempotentResponse {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  auditRef  String
  payload   Json     @db.JsonB
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([key])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────
// API Key → Organization mapping
// ──────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  keyHash     String    @unique
  orgName     String
  orgId       String
  permissions String[]  @default(["write:recognitions", "write:acceptances", "write:starts", "write:ingest"])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([orgId])
}

model ParRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  requestUri          String   @unique
  requestType         String
  requestJson         Json
  clientId            String
  codeChallenge       String?
  codeChallengeMethod String?
  redirectUri         String?
  scope               String?
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([requestType])
  @@index([expiresAt])
  @@index([createdAt])
}

model JtiReplay {
  service   String
  jti       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([service, jti])
  @@index([expiresAt])
}

model RefreshToken {
  tokenId    String   @id
  clientId   String?
  userId     String?
  scope      String
  cnfJkt     String?
  clientCert String?
  issuedAt   DateTime
  expiresAt  DateTime
  rotated    Boolean  @default(false)
  rotatedTo  String?
}

model VerifierNonce {
  nonce     String   @id
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([used])
  @@index([expiresAt])
}

enum VerificationRequestStatus {
  PENDING
  COMPLETE
  FAILED
}

enum VerifierLifecycle {
  REGISTERED
  TOKEN_SENT
  TOKEN_USED
  PILOT_ACTIVATED
  BUNDLE_GENERATED
}

model VerificationRequest {
  requestId     String                    @id @default(uuid()) @db.Uuid
  clinicianId   String
  lane          String
  source        String
  attestorId    String?
  documentHash  String?
  subject       String
  status        VerificationRequestStatus @default(PENDING)
  createdAt     DateTime                  @default(now())
  completedAt   DateTime?
  receiptId     String?
  failureReason String?

  @@index([clinicianId])
  @@index([status])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Verifier Pilot: Cross-check share links and acceptance actions
// ──────────────────────────────────────────────────────────────

model ShareLink {
  id             String    @id @default(uuid()) @db.Uuid
  npi            String
  firstViewedAt  DateTime?
  organizationId String?   @db.Uuid
  createdAt      DateTime  @default(now())

  @@index([npi])
  @@index([organizationId])
  @@index([createdAt])
}

model Organization {
  id                         String                @id @default(uuid()) @db.Uuid
  name                       String
  slug                       String                @unique
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  organizationProfile        OrganizationProfile?
  activeWorkspacePreferences WorkspacePreference[] @relation("WorkspacePreferenceActiveOrganization")
  opportunities              Opportunity[]
}

model Opportunity {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  specialty        String
  hiringType       String        @map("hiring_type") // locums | perm | telehealth | contract
  state            String
  payRange         String?       @map("pay_range")
  requirementLevel String        @default("L1") @map("requirement_level") // L1 | L2 | L3
  description      String?
  remote           Boolean       @default(false)
  status           String        @default("ACTIVE") // ACTIVE | PAUSED | CLOSED
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  applications     Application[]

  @@index([organizationId])
  @@index([specialty, state])
  @@index([status])
}

/// Application status for clinician → opportunity flow
enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  DECLINED
  WITHDRAWN
  DRAFT
  SUBMITTED
  VIEWED
  IN_REVIEW
  CREDENTIALING
  APPROVED
  REJECTED
  STARTED
}

/// Clinician application to a job opportunity
model Application {
  id              String            @id @default(uuid()) @db.Uuid
  opportunityId   String            @map("opportunity_id") @db.Uuid
  opportunity     Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  clerkUserId     String            @map("clerk_user_id")
  npi             String?
  coverNote       String?           @map("cover_note")
  status          ApplicationStatus @default(PENDING)
  reviewedBy      String?           @map("reviewed_by") // verifier clerkUserId
  reviewedAt      DateTime?         @map("reviewed_at")
  reviewNote      String?           @map("review_note")
  missingRequests MissingRequest[]
  price           Float?            @map("price")
  timeline        Json?             @map("timeline")
  progress        Json?             @map("progress")
  artifacts       Json?             @map("artifacts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([opportunityId, clerkUserId])
  @@index([clerkUserId])
  @@index([opportunityId])
  @@index([status])
}

/// NPI classification
enum NpiType {
  TYPE_1
  TYPE_2
}

enum GeocodeStatus {
  PENDING
  GEOCODED
  FAILED
}

enum GeocodePrecision {
  ROOFTOP
  STREET
  ZIP_CENTROID
  STATE_CENTROID
  UNRESOLVED
}

enum ProviderLocationType {
  PRACTICE
  MAILING
  TRAINING
  EMPLOYER
}

enum GeographicBoundaryType {
  HPSA
  STATE
}

enum BoundaryAssignmentMethod {
  ZIP
  COUNTY_FIPS
  POINT_IN_POLYGON
  HRSA_LOOKUP
}

/// Workspace persona a user is currently operating as
enum ActivePersona {
  CLINICIAN
  VERIFIER
  BOTH
}

/// Membership role within an organization workspace
enum MembershipRole {
  HOLDER
  VERIFIER
  ISSUER
  ADMIN
  RECRUITER
  CREDENTIALING_SPECIALIST
}

/// Linked profile for an individual clinician (Type 1 NPI)
model PersonProfile {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @unique @map("user_id") @db.Uuid
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  npi               String?               @unique
  npiType           NpiType?              @default(TYPE_1) @map("npi_type")
  firstName         String?               @map("first_name")
  lastName          String?               @map("last_name")
  specialty         String?
  stateOfPractice   String?               @map("state_of_practice")
  workAuthStatus    String?               @map("work_auth_status")
  resumeUrl         String?               @map("resume_url")
  linkedinUrl       String?               @map("linkedin_url")
  portfolioUrl      String?               @map("portfolio_url")
  completeness      Int                   @default(0)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  memberships       WorkspaceMembership[]
  providerLocations ProviderLocation[]

  @@index([npi])
  @@index([userId])
  @@map("person_profiles")
}

/// Linked profile for an organization (Type 2 NPI or Org DID)
model OrganizationProfile {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @unique @map("organization_id") @db.Uuid
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  npi                   String?
  npiType               NpiType?              @default(TYPE_2) @map("npi_type")
  orgDid                String?               @map("org_did")
  facilityType          String?               @map("facility_type")
  specialties           String[]
  statesCovered         String[]              @map("states_covered")
  website               String?
  // Wave 186: Employer intelligence fields
  tagline               String?
  description           String?
  trustScore            Int                   @default(0) @map("trust_score")
  openRoles             Int                   @default(0) @map("open_roles")
  recentHires           Int                   @default(0) @map("recent_hires")
  hiringStatus          EmployerHiringStatus  @default(NOT_HIRING) @map("hiring_status")
  hiringTypes           String[]              @map("hiring_types")
  timeToStart           String?               @map("time_to_start")
  timeToOnboard         String?               @map("time_to_onboard")
  clearToStartThreshold String?               @map("clear_to_start_threshold")
  payTransparency       Boolean               @default(false) @map("pay_transparency")
  payRange              String?               @map("pay_range")
  requirements          Json                  @default("[]") @db.JsonB
  verifiedSince         DateTime?             @map("verified_since")
  verified              Boolean               @default(false)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  memberships           WorkspaceMembership[]
  institution           Institution?

  @@index([npi])
  @@index([organizationId])
  @@index([hiringStatus])
  @@index([trustScore])
  @@map("organization_profiles")
}

model Institution {
  id                    String           @id @default(uuid()) @db.Uuid
  vcvEntityId           String?          @unique @map("vcv_entity_id") @db.Uuid
  organizationProfileId String?          @unique @map("organization_profile_id") @db.Uuid
  canonicalName         String           @map("canonical_name")
  slug                  String           @unique
  rorId                 String?          @unique @map("ror_id")
  addressLine1          String?          @map("address_line1")
  addressLine2          String?          @map("address_line2")
  city                  String?
  stateCode             String?          @map("state_code")
  postalCode            String?          @map("postal_code")
  countryCode           String           @default("US") @map("country_code")
  latitude              Decimal?         @db.Decimal(9, 6)
  longitude             Decimal?         @db.Decimal(9, 6)
  geocodeStatus         GeocodeStatus    @default(PENDING) @map("geocode_status")
  geocodePrecision      GeocodePrecision @default(UNRESOLVED) @map("geocode_precision")
  geocodeSource         String?          @map("geocode_source")
  geocodeAttempts       Int              @default(0) @map("geocode_attempts")
  lastGeocodedAt        DateTime?        @map("last_geocoded_at")
  lastGeocodeError      String?          @map("last_geocode_error")
  metadata              Json             @default("{}") @db.JsonB
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  vcvEntity           VcvEntity?           @relation(fields: [vcvEntityId], references: [id], onDelete: SetNull)
  organizationProfile OrganizationProfile? @relation(fields: [organizationProfileId], references: [id], onDelete: SetNull)

  @@index([latitude, longitude])
  @@index([stateCode, postalCode])
  @@index([canonicalName])
  @@index([geocodeStatus, updatedAt])
  @@map("institutions")
}

model ProviderLocation {
  id               String               @id @default(uuid()) @db.Uuid
  subjectNpi       String               @map("subject_npi")
  personProfileId  String?              @map("person_profile_id") @db.Uuid
  claimRecordId    String?              @unique @map("claim_record_id") @db.Uuid
  locationType     ProviderLocationType @default(PRACTICE) @map("location_type")
  isCurrent        Boolean              @default(true) @map("is_current")
  sourceId         String               @map("source_id")
  trustTier        String               @map("trust_tier")
  confidenceScore  Float                @map("confidence_score")
  addressHash      String               @map("address_hash")
  addressLine1     String?              @map("address_line1")
  addressLine2     String?              @map("address_line2")
  city             String?
  stateCode        String?              @map("state_code")
  postalCode       String?              @map("postal_code")
  countryCode      String               @default("US") @map("country_code")
  countyFips       String?              @map("county_fips")
  latitude         Decimal?             @db.Decimal(9, 6)
  longitude        Decimal?             @db.Decimal(9, 6)
  geocodeStatus    GeocodeStatus        @default(PENDING) @map("geocode_status")
  geocodePrecision GeocodePrecision     @default(UNRESOLVED) @map("geocode_precision")
  geocodeSource    String?              @map("geocode_source")
  geocodeAttempts  Int                  @default(0) @map("geocode_attempts")
  lastGeocodedAt   DateTime?            @map("last_geocoded_at")
  lastGeocodeError String?              @map("last_geocode_error")
  observedAt       DateTime             @map("observed_at")
  metadata         Json                 @default("{}") @db.JsonB
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  personProfile       PersonProfile?               @relation(fields: [personProfileId], references: [id], onDelete: SetNull)
  claimRecord         ClaimRecord?                 @relation(fields: [claimRecordId], references: [id], onDelete: SetNull)
  boundaryAssignments ProviderBoundaryAssignment[]

  @@index([subjectNpi, isCurrent])
  @@index([latitude, longitude])
  @@index([stateCode, postalCode])
  @@index([geocodeStatus, updatedAt])
  @@index([addressHash])
  @@map("provider_locations")
}

model GeographicBoundary {
  id              String                 @id @default(uuid()) @db.Uuid
  boundaryType    GeographicBoundaryType @map("boundary_type")
  externalId      String                 @map("external_id")
  name            String
  stateCode       String?                @map("state_code")
  countyFips      String?                @map("county_fips")
  centroidLat     Decimal?               @map("centroid_lat") @db.Decimal(9, 6)
  centroidLng     Decimal?               @map("centroid_lng") @db.Decimal(9, 6)
  bboxMinLat      Decimal?               @map("bbox_min_lat") @db.Decimal(9, 6)
  bboxMinLng      Decimal?               @map("bbox_min_lng") @db.Decimal(9, 6)
  bboxMaxLat      Decimal?               @map("bbox_max_lat") @db.Decimal(9, 6)
  bboxMaxLng      Decimal?               @map("bbox_max_lng") @db.Decimal(9, 6)
  geometryGeoJson Json                   @map("geometry_geojson") @db.JsonB
  sourceDataset   String                 @map("source_dataset")
  dataVersion     String                 @map("data_version")
  metadata        Json                   @default("{}") @db.JsonB
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  providerAssignments ProviderBoundaryAssignment[]

  @@unique([boundaryType, externalId])
  @@index([stateCode])
  @@index([boundaryType, stateCode])
  @@index([bboxMinLat, bboxMaxLat, bboxMinLng, bboxMaxLng])
  @@map("geographic_boundaries")
}

model ProviderBoundaryAssignment {
  id                 String                   @id @default(uuid()) @db.Uuid
  providerLocationId String                   @map("provider_location_id") @db.Uuid
  boundaryId         String                   @map("boundary_id") @db.Uuid
  assignmentMethod   BoundaryAssignmentMethod @map("assignment_method")
  confidence         Float                    @default(0)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  providerLocation ProviderLocation   @relation(fields: [providerLocationId], references: [id], onDelete: Cascade)
  boundary         GeographicBoundary @relation(fields: [boundaryId], references: [id], onDelete: Cascade)

  @@unique([providerLocationId, boundaryId])
  @@index([boundaryId])
  @@index([assignmentMethod, confidence])
  @@map("provider_boundary_assignments")
}

enum EmployerHiringStatus {
  HIRING_NOW
  ACTIVELY_HIRING
  ACCEPTING_APPLICATIONS
  NOT_HIRING
}

enum SourceRunStatus {
  QUEUED
  FETCHING
  FETCHED
  PARSED
  NORMALIZED
  VERIFIED
  ALERTED
  QUARANTINED
  FAILED
}

enum IdentityResolutionDecisionType {
  LINK
  MERGE
  UNMERGE
  COLLISION
  SKIP
