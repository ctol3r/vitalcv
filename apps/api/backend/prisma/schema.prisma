// ── Wave A (Phase 1 Hardening): Decision Capsule Infrastructure ──────────────

/// Immutable audit record of an operational decision (hiring, privileging,
/// deployment, renewal) with a cryptographic snapshot of the credential
/// bundle that supported it. Status transitions record revocation cascade
/// impact: VALID → AT_RISK → INVALID.
model DecisionCapsule {
  id                String   @id @default(uuid()) @db.Uuid

  /// Decentralized Identifier of the clinician subject
  subjectDid        String

  /// 10-digit NPI of the clinician subject
  subjectNpi        String

  /// HIRING | PRIVILEGING | DEPLOYMENT | RENEWAL
  decisionType      String

  /// When the decision was made (immutable after creation)
  decisionTimestamp DateTime

  /// IDs of VerificationArtifacts that supported this decision
  credentialIds     String[]

  /// IDs of trusted issuers involved in this decision
  issuerIds         String[]

  /// SHA-256 hash of the full credential bundle snapshot at decision time
  artifactHash      String

  /// Evaluation methodology version (e.g. "CRS_v1.0")
  methodology       String   @default("CRS_v1.0")

  /// VALID | AT_RISK | INVALID
  status            String   @default("VALID")

  /// Arbitrary context: employerId, deploymentRef, notes
  metadata          Json     @default("{}")  @db.JsonB

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subjectNpi])
  @@index([subjectDid])
  @@index([status])
  @@index([decisionType])
  @@index([decisionTimestamp])
  @@index([subjectNpi, status])
}

// ── Wave 184: Unified Search Index & Content Graph ───────────────────────────

/// Object type classifications for the search index
enum SearchObjectType {
  PUBLIC_PAGE
  EMPLOYER_PROFILE
  OPPORTUNITY
  ISSUER_PROFILE
  TRUST_STATE_SUMMARY
  AUDIT_EVENT_SUMMARY
  FAQ_DOC
  CONNECTED_RECORD
}

/// ACL visibility levels
enum SearchAclLevel {
  PUBLIC        // anyone can see
  AUTHENTICATED // any logged-in user
  HOLDER        // clinician workspace only
  VERIFIER      // verifier/employer workspace only
  ADMIN         // internal only
}

/// Indexed search object — the core retrieval unit
model SearchObject {
  id            String           @id @default(uuid()) @db.Uuid
  type          SearchObjectType
  title         String
  /// Plain-text body — used for BM25 keyword search
  body          String
  /// Source URL or internal path
  sourceUrl     String?
  /// External reference id (opportunity id, issuer id, etc.)
  referenceId   String?
  /// ACL gate
  aclLevel      SearchAclLevel   @default(PUBLIC)
  /// JSON metadata (specialty, state, pay, etc.)
  metadata      Json             @default("{}") @db.JsonB
  /// Embedding vector stored as float array (pgvector-ready)
  embedding     Float[]
  /// ISO timestamp of source freshness
  indexedAt     DateTime         @default(now())
  freshAt       DateTime?
  active        Boolean          @default(true)

  acl           SearchObjectACL[]

  @@index([type])
  @@index([aclLevel])
  @@index([active])
  @@index([type, active])
  @@index([referenceId])
}

/// Fine-grained ACL: which role/org can access which search object
model SearchObjectACL {
  id             String          @id @default(uuid()) @db.Uuid
  searchObjectId String          @db.Uuid
  searchObject   SearchObject    @relation(fields: [searchObjectId], references: [id], onDelete: Cascade)
  /// If set, only users with this role can see the object
  roleRequired   String?
  /// If set, only members of this org can see the object
  orgId          String?         @db.Uuid
  createdAt      DateTime        @default(now())

  @@index([searchObjectId])
  @@index([orgId])
}

/// Index job run log
model SearchIndexRun {
  id           String   @id @default(uuid()) @db.Uuid
  objectType   String
  totalIndexed Int      @default(0)
  totalSkipped Int      @default(0)
  totalErrors  Int      @default(0)
  durationMs   Int?
  status       String   @default("PENDING")  // PENDING | RUNNING | DONE | FAILED
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  errorMessage String?

  @@index([status])
  @@index([objectType])
}

// ──────────────────────────────────────────────────────────────
// Waves 9-11: Durable graph runtime, snapshots, AI link review
// ──────────────────────────────────────────────────────────────

model GraphNode {
  id              String   @id
  canonicalKey    String   @unique @map("canonical_key")
  type            String
  label           String
  title           String
  colorGroup      String   @map("color_group")
  groupKey        String?  @map("group_key")
  tags            String[] @default([])
  metadata        Json     @default("{}") @db.JsonB
  degree          Int      @default(0)
  inDegree        Int      @default(0) @map("in_degree")
  outDegree       Int      @default(0) @map("out_degree")
  sourceRefs      String[] @default([]) @map("source_refs")
  sourceChecksum  String?  @map("source_checksum")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  outgoingEdges       GraphEdge[]            @relation("GraphEdgeSource")
  incomingEdges       GraphEdge[]            @relation("GraphEdgeTarget")
  sourceSuggestions   GraphLinkSuggestion[]  @relation("GraphSuggestionSource")
  targetSuggestions   GraphLinkSuggestion[]  @relation("GraphSuggestionTarget")
  sourceRejectMemory  GraphRejectMemory[]    @relation("GraphRejectSource")
  targetRejectMemory  GraphRejectMemory[]    @relation("GraphRejectTarget")
  clusterAssignments  GraphClusterAssignment[]

  @@index([type])
  @@index([colorGroup])
  @@index([groupKey])
  @@index([active])
  @@index([sourceUpdatedAt])
  @@map("graph_nodes")
}

model GraphEdge {
  id            String   @id
  canonicalKey  String   @unique @map("canonical_key")
  pairKey       String   @map("pair_key")
  sourceNodeId  String   @map("source_node_id")
  targetNodeId  String   @map("target_node_id")
  edgeType      String   @map("edge_type")
  directed      Boolean  @default(true)
  reciprocal    Boolean  @default(false)
  reverseEdgeId String?  @map("reverse_edge_id")
  confidence    Float    @default(1)
  status        String   @default("ACTIVE")
  createdBy     String   @map("created_by")
  provenance    Json     @default("{}") @db.JsonB
  explanation   String?
  materialHash  String?  @map("material_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sourceNode GraphNode  @relation("GraphEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode GraphNode  @relation("GraphEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  reverseEdge GraphEdge? @relation("GraphEdgeReverse", fields: [reverseEdgeId], references: [id], onDelete: SetNull)
  mirroredBy  GraphEdge[] @relation("GraphEdgeReverse")

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([edgeType])
  @@index([status])
  @@index([pairKey])
  @@index([sourceNodeId, edgeType])
  @@map("graph_edges")
}

model GraphBuildRun {
  id                  String   @id
  buildType           String   @map("build_type")
  status              String   @default("QUEUED")
  requestedBy         String?  @map("requested_by")
  requestFingerprint  String?  @map("request_fingerprint")
  graphMode           String?  @map("graph_mode")
  scopeType           String?  @map("scope_type")
  scopeKey            String?  @map("scope_key")
  targetNodeId        String?  @map("target_node_id")
  filterSignature     String?  @map("filter_signature")
  invalidationReasons String[] @default([]) @map("invalidation_reasons")
  summary             Json     @default("{}") @db.JsonB
  errorText           String?  @map("error_text")
  startedAt           DateTime @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  snapshots GraphSnapshot[]

  @@index([status, startedAt])
  @@index([buildType, createdAt])
  @@index([graphMode, status])
  @@index([requestFingerprint, status])
  @@map("graph_build_runs")
}

model GraphSnapshot {
  id              String    @id
  querySignature  String    @unique @map("query_signature")
  scopeType       String    @map("scope_type")
  scopeKey        String    @map("scope_key")
  graphMode       String    @map("graph_mode")
  focusNodeId     String?   @map("focus_node_id")
  depth           Int?
  filterSignature String    @map("filter_signature")
  schemaVersion   String    @map("schema_version")
  nodeCount       Int       @default(0) @map("node_count")
  edgeCount       Int       @default(0) @map("edge_count")
  payloadBytes    Int       @default(0) @map("payload_bytes")
  payload         Json      @db.JsonB
  stats           Json      @default("{}") @db.JsonB
  invalidatedAt   DateTime? @map("invalidated_at")
  lastInvalidationReason String? @map("last_invalidation_reason")
  lastInvalidationScope  Json?   @db.JsonB @map("last_invalidation_scope")
  builtAt         DateTime  @default(now()) @map("built_at")
  lastAccessedAt  DateTime? @map("last_accessed_at")
  buildRunId      String?   @map("build_run_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  buildRun           GraphBuildRun?           @relation(fields: [buildRunId], references: [id], onDelete: SetNull)
  clusterAssignments GraphClusterAssignment[]

  @@index([graphMode, invalidatedAt])
  @@index([scopeType, scopeKey])
  @@index([focusNodeId, depth])
  @@index([buildRunId])
  @@index([payloadBytes])
  @@map("graph_snapshots")
}

model GraphPreset {
  id                  String   @id
  ownerKey            String   @map("owner_key")
  name                String
  graphMode           String   @map("graph_mode")
  focusNodeId         String?  @map("focus_node_id")
  depth               Int      @default(2)
  filterSchemaVersion String   @map("filter_schema_version")
  filters             Json     @db.JsonB
  display             Json     @db.JsonB
  physics             Json     @db.JsonB
  camera              Json     @db.JsonB
  pinnedNodes         Json     @default("{}") @db.JsonB @map("pinned_nodes")
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([ownerKey, name])
  @@index([ownerKey, status])
  @@index([graphMode])
  @@map("graph_presets")
}

model GraphLayoutState {
  id              String   @id
  ownerKey        String   @map("owner_key")
  scopeType       String   @map("scope_type")
  scopeKey        String   @map("scope_key")
  graphMode       String   @map("graph_mode")
  filterSignature String   @map("filter_signature")
  positions       Json     @default("{}") @db.JsonB
  pinnedNodes     Json     @default("{}") @db.JsonB @map("pinned_nodes")
  frozenNodeIds   String[] @default([]) @map("frozen_node_ids")
  camera          Json     @db.JsonB
  display         Json     @db.JsonB
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([ownerKey, scopeType, scopeKey, graphMode, filterSignature])
  @@index([ownerKey, graphMode])
  @@index([scopeType, scopeKey])
  @@map("graph_layout_states")
}

model GraphRejectMemory {
  id             String   @id
  pairKey        String   @unique @map("pair_key")
  sourceNodeId   String   @map("source_node_id")
  targetNodeId   String   @map("target_node_id")
  edgeType       String   @map("edge_type")
  reviewerId     String?  @map("reviewer_id")
  rationale      String?
  evidenceHash   String   @map("evidence_hash")
  reconsiderAfter DateTime? @map("reconsider_after")
  lastRejectedAt DateTime @default(now()) @map("last_rejected_at")
  lastSuggestedAt DateTime? @map("last_suggested_at")
  lastSuppressedAt DateTime? @map("last_suppressed_at")
  suppressionCount Int @default(0) @map("suppression_count")
  metadata       Json     @default("{}") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sourceNode GraphNode @relation("GraphRejectSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode GraphNode @relation("GraphRejectTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([sourceNodeId, targetNodeId])
  @@index([edgeType, lastRejectedAt])
  @@index([suppressionCount])
  @@map("graph_reject_memory")
}

model GraphClusterAssignment {
  id          String   @id
  nodeId      String   @map("node_id")
  snapshotId  String?  @map("snapshot_id")
  clusterMode String   @map("cluster_mode")
  clusterKey  String   @map("cluster_key")
  score       Float    @default(1)
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  node     GraphNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  snapshot GraphSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([nodeId, snapshotId, clusterMode])
  @@index([clusterMode, clusterKey])
  @@index([snapshotId])
  @@map("graph_cluster_assignments")
}

model GraphSuggestionBatch {
  id                   String   @id
  status               String   @default("QUEUED")
  requestFingerprint   String?  @map("request_fingerprint")
  graphMode            String   @map("graph_mode")
  targetNodeId         String?  @map("target_node_id")
  filterSignature      String   @map("filter_signature")
  maxSuggestionsPerNode Int     @default(10) @map("max_suggestions_per_node")
  minConfidence        Float    @default(0.3) @map("min_confidence")
  applyThreshold       Float    @default(0.85) @map("apply_threshold")
  summary              Json     @default("{}") @db.JsonB
  errorText            String?  @map("error_text")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  completedAt          DateTime? @map("completed_at")

  suggestions GraphLinkSuggestion[]

  @@index([status, createdAt])
  @@index([graphMode, targetNodeId])
  @@index([requestFingerprint, status])
  @@map("graph_suggestion_batches")
}

model GraphLinkSuggestion {
  id                 String   @id
  suggestionKey      String   @map("suggestion_key")
  batchId            String?  @map("batch_id")
  sourceNodeId       String   @map("source_node_id")
  targetNodeId       String   @map("target_node_id")
  edgeType           String   @map("edge_type")
  directed           Boolean  @default(true)
  reciprocal         Boolean  @default(false)
  confidence         Float
  state              String   @default("PENDING")
  explanation        Json     @db.JsonB
  signalBreakdown    Json     @default("{}") @db.JsonB @map("signal_breakdown")
  materialChangeHash String   @map("material_change_hash")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  decidedAt          DateTime? @map("decided_at")

  batch      GraphSuggestionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sourceNode GraphNode             @relation("GraphSuggestionSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode GraphNode             @relation("GraphSuggestionTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  decisions  GraphLinkDecision[]

  @@unique([suggestionKey, materialChangeHash])
  @@index([state, createdAt])
  @@index([batchId])
  @@index([sourceNodeId, state])
  @@index([targetNodeId, state])
  @@map("graph_link_suggestions")
}

model GraphLinkDecision {
  id          String   @id
  suggestionId String  @map("suggestion_id")
  action      String
  decidedBy   String?  @map("decided_by")
  rationale   String?
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  suggestion GraphLinkSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId, createdAt])
  @@index([action, createdAt])
  @@map("graph_link_decisions")
}

model ReciprocalEdgeRule {
  id               String   @id
  edgeType         String   @unique @map("edge_type")
  reverseEdgeType  String   @map("reverse_edge_type")
  relationshipMode String   @map("relationship_mode")
  directed         Boolean  @default(true)
  reciprocal       Boolean  @default(false)
  autoCreate       Boolean  @default(false) @map("auto_create")
  explanation      String?
  metadata         Json     @default("{}") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([relationshipMode, autoCreate])
  @@map("reciprocal_edge_rules")
}
