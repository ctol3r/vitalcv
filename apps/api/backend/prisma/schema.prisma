  claimId                    String                      @map("claim_id")
  sourceRunId                String?                     @map("source_run_id") @db.Uuid
  sourceRecordId             String?                     @map("source_record_id") @db.Uuid
  verificationArtifactId     String?                     @map("verification_artifact_id") @db.Uuid
  personProfileId            String?                     @map("person_profile_id") @db.Uuid
  subjectNpi                 String                      @map("subject_npi")
  claimType                  String                      @map("claim_type")
  value                      Json
  trustTier                  String                      @map("trust_tier")
  confidenceLabel            String                      @map("confidence_label")
  confidenceScore            Float                       @map("confidence_score")
  sourceId                   String                      @map("source_id")
  parserVersion              String                      @map("parser_version")
  matchingStrategy           String?                     @map("matching_strategy")
  status                     String
  observedAt                 DateTime                    @map("observed_at")
  derivedAt                  DateTime                    @map("derived_at")
  validFrom                  DateTime?                   @map("valid_from")
  validUntil                 DateTime?                   @map("valid_until")
  expiresAt                  DateTime?                   @map("expires_at")
  supersededByClaimId        String?                     @map("superseded_by_claim_id")
  supersedesClaimId          String?                     @map("supersedes_claim_id")
  reviewRequired             Boolean                     @default(false) @map("review_required")
  reviewReason               String?                     @map("review_reason")
  mergeReason                String?                     @map("merge_reason")
  conflictReason             String?                     @map("conflict_reason")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  explanation                String?
  freshnessWindowHours       Int?                        @map("freshness_window_hours")
  sourceRecord               SourceRecord?               @relation(fields: [sourceRecordId], references: [id])
  sourceRun                  SourceRun?                  @relation(fields: [sourceRunId], references: [id])
  verificationArtifact       VerificationArtifact?       @relation("ArtifactClaimRecords", fields: [verificationArtifactId], references: [id])
  identityClaimDeltas        IdentityClaimDelta[]        @relation("CurrentDeltaClaimRecords")
  previousClaimDeltas        IdentityClaimDelta[]        @relation("PreviousDeltaClaimRecords")
  providerLocation           ProviderLocation?
  verificationReceiptRecords VerificationReceiptRecord[]

  @@unique([claimId, verificationArtifactId])
  @@index([claimId])
  @@index([trustTier])
  @@index([status, createdAt])
  @@index([subjectNpi, claimType, createdAt])
  @@index([sourceRecordId, createdAt])
  @@map("claim_records")
}

model VerificationReceiptRecord {
