// Prisma schema for Chai VC Platform with database seeding support
// Defines User, Credential, and Job models for comprehensive GraphQL operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  passwordHash String?
  credentials Credential[]
  jobs        Job[]
}

model Credential {
  id       Int      @id @default(autoincrement())
  name     String
  issuer   String
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  userId   Int
}

model CredentialAttestation {
  id              Int      @id @default(autoincrement())
  subjectId       String
  credentialType  String
  issuerOrgId     String
  submitterId     String
  status          String
  evidence        Json?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditEvent {
  id           Int      @id @default(autoincrement())
  type         String
  hash         String
  credentialId String?
  userId       Int?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Job {
  id     Int    @id @default(autoincrement())
  title  String
  user   User   @relation(fields: [userId], references: [id])
  userId Int
}
