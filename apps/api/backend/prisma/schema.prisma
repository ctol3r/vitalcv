/// Generic graph node representing any entity in the AKG.
/// entityType discriminates the kind (CLINICIAN, ISSUER, CREDENTIAL, POLICY, FACILITY).
/// entityId references the primary key in the source-of-truth table.
/// attributes stores denormalized metadata as JSON for fast graph queries.
model KnowledgeNode {
  id         String          @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  label      String
  attributes Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  outEdges   AuthorityEdge[] @relation("EdgeSource")
  inEdges    AuthorityEdge[] @relation("EdgeTarget")

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityId])
}

/// Directed edge in the AKG representing an authority relationship.
/// relationType encodes the semantic meaning (VERIFIED_BY, ISSUED_TO, COMPLIES_WITH, REQUIRED_BY, ATTESTED_BY).
/// cryptographicProof optionally stores a hash or signature anchoring this edge to the trust ledger.
model AuthorityEdge {
  id                 String        @id @default(uuid()) @db.Uuid
  sourceNodeId       String        @db.Uuid
  targetNodeId       String        @db.Uuid
  relationType       String
  weight             Float         @default(1.0)
  cryptographicProof String?
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now())
  source             KnowledgeNode @relation("EdgeSource", fields: [sourceNodeId], references: [id])
  target             KnowledgeNode @relation("EdgeTarget", fields: [targetNodeId], references: [id])

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([relationType])
  @@index([sourceNodeId, relationType])
}

/// Immutable audit record of an operational decision (hiring, privileging,
/// deployment, renewal) with a cryptographic snapshot of the credential
/// bundle that supported it. Status transitions record revocation cascade
/// impact: VALID → AT_RISK → INVALID.
model DecisionCapsule {
  id                   String   @id @default(uuid()) @db.Uuid
  /// Decentralized Identifier of the clinician subject
  subjectDid           String
  /// 10-digit NPI of the clinician subject
  subjectNpi           String
  /// HIRING | PRIVILEGING | DEPLOYMENT | RENEWAL
  decisionType         String
  /// When the decision was made (immutable after creation)
  decisionTimestamp    DateTime
  /// IDs of VerificationArtifacts that supported this decision
  credentialIds        String[]
  /// IDs of trusted issuers involved in this decision
  issuerIds            String[]
  /// SHA-256 hash of the full credential bundle snapshot at decision time
  artifactHash         String
  /// Evaluation methodology version (e.g. "CRS_v1.0")
  methodology          String   @default("CRS_v1.0")
  /// VALID | AT_RISK | INVALID
  status               String   @default("VALID")
  /// Arbitrary context: employerId, deploymentRef, notes
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  /// Whether this decision was affected by a revoked credential
  impactedByRevocation Boolean  @default(false)
  /// The ID of the organization that made this decision
  organizationId       String?  @db.Uuid

  @@index([subjectNpi])
  @@index([subjectDid])
  @@index([status])
  @@index([decisionType])
  @@index([decisionTimestamp])
  @@index([subjectNpi, status])
}

/// Acceptance Graph & Decision Learning — captures the exact passport state
/// an employer saw at decision time so the network can learn what a
/// "ready-to-accept" signal looks like. Distinct from `DecisionCapsule`
/// (which is an immutable cryptographic audit capsule): this one is a
/// mutable-shape learning record whose schema is expected to evolve.
model DecisionLearningCapsule {
  id               String   @id @default(uuid()) @db.Uuid
  /// Clinician the decision was about
  clinicianId      String   @db.Uuid
  /// Employer / verifier org that made the decision
  employerId       String   @db.Uuid
  /// Target role (specialty + seniority label, or opportunity id)
  role             String
  /// Exact source coverage, freshness, and gaps at decision time.
  /// Shape: { readinessBand, readinessScore, credentialTypes[], gaps[], state, specialty, … }
  passportSnapshot Json
  /// ACCEPTED_HEAD_START | REQUESTED_INFO | ROUTED_MANUAL | REJECTED
  decisionOutcome  String
  /// Seconds between the employer opening the packet and pressing the action
  timeToDecision   Int
  /// When the decision was actually taken (not necessarily when row was inserted)
  timestamp        DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([clinicianId])
  @@index([employerId])
  @@index([role])
  @@index([decisionOutcome])
  @@index([employerId, decisionOutcome])
  @@index([timestamp])
  @@map("decision_learning_capsules")
}

/// Indexed search object — the core retrieval unit
model SearchObject {
