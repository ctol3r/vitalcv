// Wave APPLY-FIX: Apply-with-VitalCV share event log
// Tracks every "Sign & Share" action: who shared, what, where, when,
// webhook delivery status, email fallback, and provider-initiated revocations.
// ── Shape-of-Truth: Canonical Provider Decision State ──────────────────────
// Persists the latest formal DecisionArtifact for each NPI.
// Updated by trustStateService after each verification run.
// Never overwritten — see provider_decision_history for append-only log.

model ProviderDecisionState {
  id                  String   @id @default(uuid()) @db.Uuid
  npi                 String   @unique
  /// TRUSTED_CURRENT | TRUSTED_BUT_STALE_SOON | STALE_REVERIFY_REQUIRED |
  /// CONFLICT_REQUIRES_REVIEW | NEGATIVE_FINDING_BLOCK | INSUFFICIENT_EVIDENCE
  decisionClass       String   @map("decision_class")
  aggregateConfidence Float    @map("aggregate_confidence")
  context             String   @default("credentialing")
  methodologyVersion  String   @map("methodology_version")
  evaluatedAt         DateTime @map("evaluated_at")
  expiresAt           DateTime @map("expires_at")
  claimCount          Int      @map("claim_count")
  goldClaimCount      Int      @map("gold_claim_count")
  silverClaimCount    Int      @map("silver_claim_count")
