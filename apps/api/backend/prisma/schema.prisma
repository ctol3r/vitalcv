  subjectNpi             String                @map("subject_npi")
  entityId               String                @map("entity_id")
  field                  String
  value                  Json
  trustTier              String                @map("trust_tier")
  confidence             Float
  sourceArtifactId       String?               @map("source_artifact_id")
  sourceSystem           String                @map("source_system")
  parserVersion          String                @map("parser_version")
  matchingStrategy       String?               @map("matching_strategy")
  observedAt             DateTime              @map("observed_at")
  explanation            String
  expiresAt              DateTime?             @map("expires_at")
  issuedAt               DateTime              @default(now()) @map("issued_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  sourceUrl              String?               @map("source_url")
  retrievedAt            DateTime?             @map("retrieved_at") @db.Timestamptz(6)
  rawArtifactRef         String?               @map("raw_artifact_ref")
