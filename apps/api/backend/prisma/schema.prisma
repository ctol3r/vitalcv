  externalIdentifier String   @map("external_identifier")
  firstObservedAt    DateTime @map("first_observed_at")
  lastObservedAt     DateTime @map("last_observed_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, objectType, externalIdentifier], map: "application_external_references_external_uq")
  @@unique([applicationId, organizationId, sourceSystem, objectType], map: "application_external_references_application_uq")
  @@index([applicationId])
  @@index([organizationId, sourceSystem])
  @@map("application_external_references")
}

/// Immutable inbound receipt plus mutable processing state. The signed
/// envelope, normalized payload, and payload hash are never rewritten; only the
/// processing fields advance. Duplicate external event ids are replay-safe.
model IntegrationInboxEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  applicationId      String?   @map("application_id") @db.Uuid
  sourceSystem       String    @map("source_system")
  externalEventId    String    @map("external_event_id")
  eventType          String    @map("event_type")
  payload            Json
  payloadHash        String    @map("payload_hash")
  signatureKeyId     String    @map("signature_key_id") @db.Uuid
  occurredAt         DateTime  @map("occurred_at")
  receivedAt         DateTime  @default(now()) @map("received_at")
  processingState    String    @default("RECEIVED") @map("processing_state")
  processedAt        DateTime? @map("processed_at")
  processingError    String?   @map("processing_error")
  outboxEventId      String?   @map("outbox_event_id") @db.Uuid

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceSystem, externalEventId], map: "integration_inbox_events_external_uq")
  @@index([organizationId, processingState, receivedAt])
  @@index([applicationId, occurredAt])
  @@map("integration_inbox_events")
}

