generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  clerkUserId         String               @unique
  email               String               @unique
  role                UserRole             @default(CLINICIAN)
  roleVersion         Int                  @default(1)
  status              UserStatus           @default(INVITED)
  organizationId      String?              @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  personProfile       PersonProfile?
  workspacePreference WorkspacePreference?

  @@index([clerkUserId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

model Recognition {
  id              String       @id @default(uuid()) @db.Uuid
  recognitionId   String       @unique
  subjectId       String
  employerId      String
  recognizedAt    DateTime
  verifiedAt      DateTime
  verificationRef String
  expiresAt       DateTime?
  revokedAt       DateTime?
  revocationRef   String?
  eventHash       String
  createdAt       DateTime     @default(now())
  acceptances     Acceptance[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
}

model Acceptance {
  id                   String      @id @default(uuid()) @db.Uuid
  acceptanceId         String      @unique
  recognitionId        String
  subjectId            String
  employerId           String
  facilityId           String
  acceptedAt           DateTime
  psvReportId          String
  eventHash            String
  createdAt            DateTime    @default(now())
  // Graph-node extensions — all optional to preserve existing callers.
  decisionState        String?
  trustSignalsSnapshot Json?       @map("trust_signals_snapshot")
  role                 String?
  recognition          Recognition @relation(fields: [recognitionId], references: [recognitionId])
  starts               Start[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
  @@index([acceptanceId])
}

model Start {
  id           String     @id @default(uuid()) @db.Uuid
  startId      String     @unique
  acceptanceId String
  subjectId    String
  employerId   String
  attestedAt   DateTime
  eventHash    String
  createdAt    DateTime   @default(now())
  acceptance   Acceptance @relation(fields: [acceptanceId], references: [acceptanceId])

  @@index([subjectId])
  @@index([employerId])
  @@index([acceptanceId])
  @@index([startId])
}

model PsvReceipt {
  id                    String   @id @default(uuid()) @db.Uuid
  receiptId             String   @unique
  clinicianId           String
  sourceAuthority       String
  licenseId             String
  transactionId         String
  fetchedAt             DateTime
  responseHash          String
  ttlSeconds            Int
  revoked               Boolean  @default(false)
  lane                  String?
  verificationCheck     String?
  verificationOutcome   String?
  failureReason         String?
  source                String?
  attestorId            String?
  verificationRequestId String?
  createdAt             DateTime @default(now())

  @@index([clinicianId])
  @@index([receiptId])
}

model ClinicianIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  clinicianId String   @unique
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NpiDidBinding {
  id                String              @id @default(uuid()) @db.Uuid
  npi               String              @unique
  did               String              @unique
  sourceFingerprint String
  recipeVersion     String              @default("1.0.0")
  evidencePointers  Json
  status            NpiDidBindingStatus @default(ACTIVE)
  contestReason     String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([npi])
  @@index([did])
  @@map("npi_did_binding")
}

model CandidateCredential {
  id                    String   @id @default(uuid()) @db.Uuid
  candidateCredentialId String   @unique
  clinicianId           String
  data                  Json
  status                String   @default("UNVERIFIED")
  createdAt             DateTime @default(now())

  @@index([clinicianId])
}

model IngestConflict {
  id          String   @id @default(uuid()) @db.Uuid
  conflictId  String   @unique
  clinicianId String
  status      String   @default("UNRESOLVED")
  data        Json
  createdAt   DateTime @default(now())

  @@index([clinicianId])
}

model IdempotentResponse {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  auditRef  String
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([key])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  keyHash     String    @unique
  orgName     String
  orgId       String
  permissions String[]  @default(["write:recognitions", "write:acceptances", "write:starts", "write:ingest"])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([orgId])
}

model ParRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  requestUri          String   @unique
  requestType         String
  requestJson         Json
  clientId            String
  codeChallenge       String?
  codeChallengeMethod String?
  redirectUri         String?
  scope               String?
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([requestType])
  @@index([expiresAt])
  @@index([createdAt])
}

model JtiReplay {
  service   String
  jti       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([service, jti])
  @@index([expiresAt])
}

model RefreshToken {
  tokenId    String   @id
  clientId   String?
  userId     String?
  scope      String
  cnfJkt     String?
  clientCert String?
  issuedAt   DateTime
  expiresAt  DateTime
  rotated    Boolean  @default(false)
  rotatedTo  String?
}

model VerifierNonce {
  nonce     String   @id
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([used])
  @@index([expiresAt])
}

model VerificationRequest {
  requestId     String                    @id @default(uuid()) @db.Uuid
  clinicianId   String
  lane          String
  source        String
  attestorId    String?
  documentHash  String?
  subject       String
  status        VerificationRequestStatus @default(PENDING)
  createdAt     DateTime                  @default(now())
  completedAt   DateTime?
  receiptId     String?
  failureReason String?

  @@index([clinicianId])
  @@index([status])
  @@index([createdAt])
}

model ShareLink {
  id             String    @id @default(uuid()) @db.Uuid
  npi            String
  firstViewedAt  DateTime?
  createdAt      DateTime  @default(now())
  organizationId String?   @db.Uuid

  @@index([npi])
  @@index([organizationId])
  @@index([createdAt])
}

model Organization {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationProfile OrganizationProfile?
  opportunities       Opportunity[]
}

model Opportunity {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  title            String
  specialty        String
  hiringType       String   @map("hiring_type")
  state            String
  payRange         String?  @map("pay_range")
  requirementLevel String   @default("L1") @map("requirement_level")
  description      String?
  remote           Boolean  @default(false)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([specialty, state])
  @@index([status])
}

/// Linked profile for an individual clinician (Type 1 NPI)
model PersonProfile {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  npi               String?            @unique
  npiType           NpiType?           @default(TYPE_1) @map("npi_type")
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  specialty         String?
  stateOfPractice   String?            @map("state_of_practice")
  workAuthStatus    String?            @map("work_auth_status")
  resumeUrl         String?            @map("resume_url")
  linkedinUrl       String?            @map("linkedin_url")
  portfolioUrl      String?            @map("portfolio_url")
  completeness      Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  providerLocations ProviderLocation[]
  user              User                 @relation(fields: [userId], references: [id])
  memberships       WorkspaceMembership[]

  @@index([npi])
  @@index([userId])
  @@map("person_profiles")
}

/// Linked profile for an organization (Type 2 NPI or Org DID)
model OrganizationProfile {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @unique @map("organization_id") @db.Uuid
  npi                   String?
  npiType               NpiType?             @default(TYPE_2) @map("npi_type")
  orgDid                String?              @map("org_did")
  facilityType          String?              @map("facility_type")
  specialties           String[]
  statesCovered         String[]             @map("states_covered")
  website               String?
  tagline               String?
  description           String?
  trustScore            Int                  @default(0) @map("trust_score")
  openRoles             Int                  @default(0) @map("open_roles")
  recentHires           Int                  @default(0) @map("recent_hires")
  hiringStatus          EmployerHiringStatus @default(NOT_HIRING) @map("hiring_status")
  hiringTypes           String[]             @map("hiring_types")
  timeToStart           String?              @map("time_to_start")
  timeToOnboard         String?              @map("time_to_onboard")
  clearToStartThreshold String?              @map("clear_to_start_threshold")
  payTransparency       Boolean              @default(false) @map("pay_transparency")
  payRange              String?              @map("pay_range")
  requirements          Json                 @default("[]")
  verifiedSince         DateTime?            @map("verified_since")
  verified              Boolean              @default(false)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  institution           Institution?
  organization          Organization         @relation(fields: [organizationId], references: [id])
  memberships           WorkspaceMembership[]

  @@index([npi])
  @@index([organizationId])
  @@index([hiringStatus])
  @@index([trustScore])
  @@map("organization_profiles")
}

model Institution {
  id                    String               @id @default(uuid()) @db.Uuid
  vcvEntityId           String?              @unique @map("vcv_entity_id") @db.Uuid
  organizationProfileId String?              @unique @map("organization_profile_id") @db.Uuid
  canonicalName         String               @map("canonical_name")
  slug                  String               @unique
  rorId                 String?              @unique @map("ror_id")
  addressLine1          String?              @map("address_line1")
  addressLine2          String?              @map("address_line2")
  city                  String?
  stateCode             String?              @map("state_code")
  postalCode            String?              @map("postal_code")
  countryCode           String               @default("US") @map("country_code")
  latitude              Decimal?             @db.Decimal(9, 6)
  longitude             Decimal?             @db.Decimal(9, 6)
  geocodeStatus         GeocodeStatus        @default(PENDING) @map("geocode_status")
  geocodePrecision      GeocodePrecision     @default(UNRESOLVED) @map("geocode_precision")
  geocodeSource         String?              @map("geocode_source")
  geocodeAttempts       Int                  @default(0) @map("geocode_attempts")
  lastGeocodedAt        DateTime?            @map("last_geocoded_at")
  lastGeocodeError      String?              @map("last_geocode_error")
  metadata              Json                 @default("{}")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  organizationProfile   OrganizationProfile? @relation(fields: [organizationProfileId], references: [id])
  vcvEntity             VcvEntity?           @relation(fields: [vcvEntityId], references: [id])

  @@index([latitude, longitude])
  @@index([stateCode, postalCode])
  @@index([canonicalName])
  @@index([geocodeStatus, updatedAt])
  @@map("institutions")
}

model ProviderLocation {
  id                  String                       @id @default(uuid()) @db.Uuid
  subjectNpi          String                       @map("subject_npi")
  personProfileId     String?                      @map("person_profile_id") @db.Uuid
  claimRecordId       String?                      @unique @map("claim_record_id") @db.Uuid
  locationType        ProviderLocationType         @default(PRACTICE) @map("location_type")
  isCurrent           Boolean                      @default(true) @map("is_current")
  sourceId            String                       @map("source_id")
  trustTier           String                       @map("trust_tier")
  confidenceScore     Float                        @map("confidence_score")
  addressHash         String                       @map("address_hash")
  addressLine1        String?                      @map("address_line1")
  addressLine2        String?                      @map("address_line2")
  city                String?
  stateCode           String?                      @map("state_code")
  postalCode          String?                      @map("postal_code")
  countryCode         String                       @default("US") @map("country_code")
  countyFips          String?                      @map("county_fips")
  latitude            Decimal?                     @db.Decimal(9, 6)
  longitude           Decimal?                     @db.Decimal(9, 6)
  geocodeStatus       GeocodeStatus                @default(PENDING) @map("geocode_status")
  geocodePrecision    GeocodePrecision             @default(UNRESOLVED) @map("geocode_precision")
  geocodeSource       String?                      @map("geocode_source")
  geocodeAttempts     Int                          @default(0) @map("geocode_attempts")
  lastGeocodedAt      DateTime?                    @map("last_geocoded_at")
  lastGeocodeError    String?                      @map("last_geocode_error")
  observedAt          DateTime                     @map("observed_at")
  metadata            Json                         @default("{}")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  boundaryAssignments ProviderBoundaryAssignment[]
  claimRecord         ClaimRecord?                 @relation(fields: [claimRecordId], references: [id])
  personProfile       PersonProfile?               @relation(fields: [personProfileId], references: [id])

  @@index([subjectNpi, isCurrent])
  @@index([latitude, longitude])
  @@index([stateCode, postalCode])
  @@index([geocodeStatus, updatedAt])
  @@index([addressHash])
  @@map("provider_locations")
}

model GeographicBoundary {
  id                  String                       @id @default(uuid()) @db.Uuid
  boundaryType        GeographicBoundaryType       @map("boundary_type")
  externalId          String                       @map("external_id")
  name                String
  stateCode           String?                      @map("state_code")
  countyFips          String?                      @map("county_fips")
  centroidLat         Decimal?                     @map("centroid_lat") @db.Decimal(9, 6)
  centroidLng         Decimal?                     @map("centroid_lng") @db.Decimal(9, 6)
  bboxMinLat          Decimal?                     @map("bbox_min_lat") @db.Decimal(9, 6)
  bboxMinLng          Decimal?                     @map("bbox_min_lng") @db.Decimal(9, 6)
  bboxMaxLat          Decimal?                     @map("bbox_max_lat") @db.Decimal(9, 6)
  bboxMaxLng          Decimal?                     @map("bbox_max_lng") @db.Decimal(9, 6)
  geometryGeoJson     Json                         @map("geometry_geojson")
  sourceDataset       String                       @map("source_dataset")
  dataVersion         String                       @map("data_version")
  metadata            Json                         @default("{}")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  providerAssignments ProviderBoundaryAssignment[]

  @@unique([boundaryType, externalId])
  @@index([stateCode])
  @@index([boundaryType, stateCode])
  @@index([bboxMinLat, bboxMaxLat, bboxMinLng, bboxMaxLng], map: "geographic_boundaries_bbox_min_lat_bbox_max_lat_bbox_min_lng_bb")
  @@map("geographic_boundaries")
}

model ProviderBoundaryAssignment {
  id                 String                   @id @default(uuid()) @db.Uuid
  providerLocationId String                   @map("provider_location_id") @db.Uuid
  boundaryId         String                   @map("boundary_id") @db.Uuid
  assignmentMethod   BoundaryAssignmentMethod @map("assignment_method")
  confidence         Float                    @default(0)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  boundary           GeographicBoundary       @relation(fields: [boundaryId], references: [id], onDelete: Cascade)
  providerLocation   ProviderLocation         @relation(fields: [providerLocationId], references: [id], onDelete: Cascade)

  @@unique([providerLocationId, boundaryId], map: "provider_boundary_assignments_provider_location_id_boundary_id_")
  @@index([boundaryId])
  @@index([assignmentMethod, confidence])
  @@map("provider_boundary_assignments")
}

/// Links a person to an organization with a role
model WorkspaceMembership {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personProfileId       String         @map("person_profile_id") @db.Uuid
  organizationProfileId String         @map("organization_profile_id") @db.Uuid
  role                  MembershipRole @default(VERIFIER)
  active                Boolean        @default(true)
  invitedAt             DateTime?      @map("invited_at")
  acceptedAt            DateTime?      @map("accepted_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at")

  personProfile         PersonProfile       @relation(fields: [personProfileId], references: [id])
  organizationProfile   OrganizationProfile @relation(fields: [organizationProfileId], references: [id])

  @@unique([personProfileId, organizationProfileId], map: "workspace_memberships_person_org_key")
  @@index([organizationProfileId], map: "workspace_memberships_org_idx")
  @@index([personProfileId], map: "workspace_memberships_person_idx")
  @@map("workspace_memberships")
}

/// Per-user workspace preferences and active persona state
model WorkspacePreference {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @unique @map("user_id") @db.Uuid
  activePersona    ActivePersona @default(CLINICIAN) @map("active_persona")
  activeOrgId      String?       @map("active_org_id") @db.Uuid
  sidebarCollapsed Boolean       @default(false) @map("sidebar_collapsed")
  lastSwitchedAt   DateTime?     @map("last_switched_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  user             User          @relation(fields: [userId], references: [id])

  @@index([userId], map: "workspace_preferences_user_idx")
  @@map("workspace_preferences")
}

model NursysEvent {
  id            String   @id @default(uuid()) @db.Uuid
  npi           String
  licenseNumber String
  state         String
  eventType     String
  rawPayload    Json
  receivedAt    DateTime @default(now())

  @@index([npi])
  @@index([licenseNumber])
}

model PecosCheck {
  id             String   @id @default(uuid()) @db.Uuid
  npi            String
  enrolled       Boolean
  enrollmentType String?
  rawPayload     Json
  checkedAt      DateTime @default(now())

  @@index([npi])
}

model CrossCheckBundle {
  id             String   @id @default(uuid()) @db.Uuid
  artifactId     String
  checksum       String
  crossCheckPass Boolean
  createdAt      DateTime @default(now())

  @@index([artifactId])
}

model VerifierAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  organization String
  acceptedAt   DateTime @default(now())

  @@index([organization])
  @@index([acceptedAt])
}

model PilotOrg {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String
  activatedAt  DateTime @default(now())
  accepted     Boolean  @default(false)

  @@index([accepted])
  @@index([activatedAt])
}

model PilotPlan {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  startDate      DateTime
  endDate        DateTime?
  active         Boolean   @default(true)
  bundleCount    Int       @default(0)

  @@index([organizationId])
  @@index([active])
  @@index([startDate])
}

model VerifierOrg {
  id             String                @id @default(uuid()) @db.Uuid
  name           String
  contactName    String
  contactEmail   String
  createdAt      DateTime              @default(now())
  pilotActivated Boolean               @default(false)
  lifecycle      VerifierLifecycle     @default(REGISTERED)
  tokens         VerifierAccessToken[]

  @@index([contactEmail])
  @@index([pilotActivated])
  @@index([lifecycle])
  @@index([createdAt])
}

model VerifierAccessToken {
  id            String      @id @default(uuid()) @db.Uuid
  verifierOrgId String      @db.Uuid
  token         String      @unique
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  verifierOrg   VerifierOrg @relation(fields: [verifierOrgId], references: [id])

  @@index([verifierOrgId])
  @@index([token])
  @@index([expiresAt])
}

model VerificationArtifact {
  id                          String                       @id @default(uuid()) @db.Uuid
  npi                         String
  source                      String
  status                      String
  rawPayload                  Json?
  checksum                    String
  verifiedAt                  DateTime
  expiresAt                   DateTime?
  monitoring                  Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  trustState                  String                       @default("needs_review")
  organizationId              String?                      @db.Uuid
  merkleRoot                  String?
  claimHashes                 Json?
  lifecycleState              String                       @default("active")
  revokedAt                   DateTime?
  suspendedAt                 DateTime?
  revocationReason            String?
  statusLastChecked           DateTime                     @default(now())
  daysUntilExpiration         Int?
  forecastRiskLevel           String?
  psvWindowStart              DateTime?
  psvWindowDeadline           DateTime?
  psvWindowCompliant          Boolean?
  artifactType                String                       @default("GENERIC") @map("artifact_type")
  parserVersion               String?                      @map("parser_version")
  matchingStrategy            String?                      @map("matching_strategy")
  trustTier                   String?                      @map("trust_tier")
  confidenceScore             Float?                       @map("confidence_score")
  conflictReason              String?                      @map("conflict_reason")
  mergeReason                 String?                      @map("merge_reason")
  sourceRunId                 String?                      @map("source_run_id") @db.Uuid
  sourceRecordId              String?                      @map("source_record_id") @db.Uuid
  sourceUrl                   String?                      @map("source_url")
  fetchHeaders                Json?                        @map("fetch_headers")
  fetchedAt                   DateTime?                    @map("fetched_at")
  observedAt                  DateTime?                    @map("observed_at")
  generation                  Int?
  supersededByArtifactId      String?                      @map("superseded_by_artifact_id") @db.Uuid
  supersedesArtifactId        String?                      @map("supersedes_artifact_id") @db.Uuid
  statusListIndex             Int?
  snapshots                   AuditSnapshot[]
  trustAlertRecords           TrustAlertRecord[]
  sourceRecord                SourceRecord?                @relation(fields: [sourceRecordId], references: [id])
  sourceRun                   SourceRun?                   @relation(fields: [sourceRunId], references: [id])
  supersededByArtifact        VerificationArtifact?        @relation("ArtifactSupersededBy", fields: [supersededByArtifactId], references: [id])
  supersedesArtifacts         VerificationArtifact[]       @relation("ArtifactSupersededBy")
  supersedesArtifact          VerificationArtifact?        @relation("ArtifactSupersedes", fields: [supersedesArtifactId], references: [id])
  supersededArtifacts         VerificationArtifact[]       @relation("ArtifactSupersedes")
  claimRecords                ClaimRecord[]                @relation("ArtifactClaimRecords")
  identityClaimDeltas         IdentityClaimDelta[]
  identityResolutionDecisions IdentityResolutionDecision[] @relation("ArtifactResolutionDecisions")
  verificationReceiptRecords  VerificationReceiptRecord[]  @relation("ArtifactReceiptRecords")

  @@index([npi])
  @@index([source])
  @@index([artifactType])
  @@index([parserVersion])
  @@index([matchingStrategy])
  @@index([trustTier])
  @@index([sourceRunId])
  @@index([sourceRecordId])
  @@index([supersededByArtifactId])
  @@index([supersedesArtifactId])
  @@index([monitoring])
  @@index([organizationId])
  @@index([lifecycleState])
  @@index([revokedAt])
  @@index([suspendedAt])
  @@index([trustState])
  @@index([statusLastChecked])
  @@index([createdAt])
  @@index([forecastRiskLevel])
  @@index([statusListIndex])
}

model SourceRun {
  id                          String                       @id @default(uuid()) @db.Uuid
  sourceId                    String                       @map("source_id")
  subjectNpi                  String                       @map("subject_npi")
  personProfileId             String?                      @map("person_profile_id") @db.Uuid
  idempotencyKey              String                       @unique @map("idempotency_key")
  status                      SourceRunStatus              @default(QUEUED)
  runSummary                  Json?                        @map("run_summary")
  lastError                   String?                      @map("last_error")
  quarantineReason            String?                      @map("quarantine_reason")
  startedAt                   DateTime                     @default(now()) @map("started_at")
  completedAt                 DateTime?                    @map("completed_at")
