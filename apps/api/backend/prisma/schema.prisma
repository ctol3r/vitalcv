// Prisma schema for Chai VC Platform with database seeding support
// Defines User, Credential, and Job models for comprehensive GraphQL operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  passwordHash String?
  credentials Credential[]
  jobs        Job[]
}

model Credential {
  id       Int      @id @default(autoincrement())
  name     String
  issuer   String
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  userId   Int
}

model AuditEvent {
  id           Int      @id @default(autoincrement())
  type         String
  hash         String
  credentialId String?
  userId       Int?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Job {
  id     Int    @id @default(autoincrement())
  title  String
  user   User   @relation(fields: [userId], references: [id])
  userId Int
}

model PulseEvent {
  id            Int      @id @default(autoincrement())
  type          String
  title         String
  message       String
  severity      String   @default("info")
  source        String?
  scope         String?
  fingerprint   String
  occurrences   Int      @default(1)
  calmUntil     DateTime?
  lastEmittedAt DateTime @default(now())
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fingerprint, lastEmittedAt])
  @@index([type, lastEmittedAt])
  @@index([scope, lastEmittedAt])
}

model DiscoverItem {
  id          Int      @id @default(autoincrement())
  source      String
  sourceId    String
  specialty   String
  title       String
  summary     String
  url         String
  publishedAt DateTime?
  ingestedAt  DateTime @default(now())
  metadata    Json?
  fingerprint String

  @@unique([source, sourceId])
  @@index([specialty, publishedAt])
  @@index([fingerprint])
}
