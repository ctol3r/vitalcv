generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  clerkUserId    String     @unique
  email          String     @unique
  role           UserRole   @default(CLINICIAN)
  roleVersion    Int        @default(1)
  status         UserStatus @default(INVITED)
  organizationId String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([clerkUserId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

/// MATCHA career preferences / Career DNA for a clinician.
/// Keyed by the authenticated Clerk user id so preferences follow the provider
/// across devices, not the browser. `data` holds the full MatchaPreferences bag
/// (self-stated, editable preferences — never credentials or evidence),
/// sanitized to known fields before write. One row per user.
model MatchaPreference {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId])
}

/// Career Garden private note ("seed"). Clinician-personal workspace prose,
/// keyed by the internal User.id (pre-NPI accounts included). Never evidence,
/// never source-checked, never shared by any backend path: rows leave this
/// table only when the clinician explicitly promotes one into a
/// GardenCvEntry. Professional-development content only — the UI reminds
/// clinicians to keep patient details out.
model GardenNote {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  title          String
  body           String
  tags           String[]  @default([])
  /// unfiled | growing | grown — workspace state, enforced in the route layer.
  status         String    @default("unfiled")
  promotedAt     DateTime?
  /// WB-11: when the clinician explicitly opted THIS note into agent
  /// visibility. NULL = excluded (the default, forever, unless they act).
  /// Timestamp doubles as the consent record. Revocation sets NULL.
  /// Opt-in never widens any other audience — employer surfaces, matching,
  /// ranking, dossiers, and analytics remain excluded by construction.
  agentConsentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
  @@map("garden_notes")
}

/// A Living CV line grown from the Career Garden. Always clinician-authored:
/// `provenance` is the literal string "self_attested" and the route layer
/// rejects anything else — promotion can never mint a source-backed claim.
/// Distinct from PersonProfile.selfAttested (structured intake sections) and
/// from credential evidence: these are prose CV lines with a recorded origin.
model GardenCvEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// experience | research | teaching | service | publications
  section    String
  headline   String
  detail     String
  provenance String   @default("self_attested")
  /// Plain-language origin ("Grown from your note …"), shown under the line.
  origin     String
  fromNoteId String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("garden_cv_entries")
}

/// CC-05 / WB-02 — immutable pre-image of a garden note, captured in the
/// same transaction as every content mutation (cause 'update') and on
/// restore (cause 'pre_restore'). Rows are never updated or edited; like the
/// note itself they are scoped by the internal User.id resolved from the
/// verified identity, and misses read as 404. A revision is workspace prose,
/// never evidence: restoring one cannot change provenance anywhere.
model GardenNoteRevision {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  tags      String[] @default([])
  /// update | pre_restore — what caused this pre-image to be captured.
  cause     String   @default("update")
  createdAt DateTime @default(now())

  @@index([userId, noteId, createdAt])
  @@map("garden_note_revisions")
}

/// CC-05 / WB-02 — a typed link from a clinician's private note to something
/// that clinician may legally see. Target types are a closed allowlist
/// enforced in the service layer (note | cv_entry | opportunity |
/// profile_field | source_pointer); ownership/visibility of the target is
/// resolved server-side both when the link is created AND when it is read,
/// so a link can never disclose another user's rows. `label` is a display
/// snapshot derived server-side at create time — never caller-supplied. A
/// link is a research pointer, never evidence: it cannot set or elevate any
/// source-backed state.
model GardenNoteLink {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  fromNoteId String   @db.Uuid
  targetType String
  targetId   String
  label      String
  createdAt  DateTime @default(now())

  @@unique([userId, fromNoteId, targetType, targetId])
  @@index([userId, targetType, targetId])
  @@index([userId, fromNoteId])
  @@map("garden_note_links")
}

/// Wave Q — durable commercial lead capture. One row per submitted pilot
/// request / pilot intake (in addition to the existing Slack + stdout
/// delivery, which stays). Operational CRM-lite, never evidence: rows carry
/// buyer contact context only and are paired with an AuditEvent
/// (`pilot.lead_captured`) at insert. Mirrored in apps/web/prisma/schema.prisma
/// — the web app writes this table directly (deploy-order safe).
model PilotLead {
  id             String   @id @default(uuid()) @db.Uuid
  source         String // pilot_request | pilot_intake
  persona        String?
  organization   String
  contactName    String?
  email          String
  message        String?
  workflowTarget String?
  sourceContext  String?
  payload        Json
  slackDelivered Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([email])
}

/// Wave K — server-persisted clinician Save / Connect / Decline decisions on
/// MATCHA opportunities. Append-only: every decision (including clearing one
/// back to "new") is a NEW row; current state = latest row per
/// (clerkUserId, opportunityId). Rows are never updated or deleted. Mirrored
/// in apps/web/prisma/schema.prisma — the web app writes this table directly
/// via an auth-scoped route (identity from Clerk auth(), never a header).
///
/// PR J2 — MATCHA Discover (the swipe deck) writes its decisions to THIS log
/// too, so a role saved on the board is the same role the deck shows as
/// decided; there is never a second competing "saved roles" list. Undo appends
/// a `restored` row exactly as the board's un-toggle appends `cleared`.
///
/// action: saved | connected | declined | cleared        (board decisions)
///       | interested | priority | passed | restored     (deck decisions)
///       | viewed | details_opened                       (deck telemetry — NOT decisions)
///       | application_started | application_submitted    (apply funnel, PR J5)
/// The canonical vocabulary and the current-state derivation live in
/// apps/web/lib/matcha/opportunitySignals.ts — read the log through it, never
/// by casting `action` at a call site.
///
/// PRIVACY: these are the clinician's own private workflow decisions. Never
/// credentials, never verification state, never an input to trust-state/CRS,
/// and no employer-facing read path may expose them.
model OpportunityAction {
  id            String   @id @default(uuid()) @db.Uuid
  clerkUserId   String
  npi           String?
  opportunityId String
  action        String
  source        String   @default("web")
  createdAt     DateTime @default(now())
  /// PR J2 fields — additive + nullable, so every pre-deck row stays valid.
  /// Which surface produced the signal: board | deck.
  surface            String   @default("board")
  /// The opportunity version the clinician actually saw when deciding.
  /// Carried through Apply so a packet replays against what was on screen.
  opportunityVersion String?
  /// The MATCHA recommendation this decision responded to (replay/audit).
  recommendationId   String?
  /// Deck session, so a run of decisions can be reconstructed.
  sessionId          String?
  /// Optional structured pass reason (PR J6). Private preference data.
  reason             String?
  /// Client-generated idempotency key: a retried or replayed emit of the SAME
  /// user intent collapses onto one row instead of duplicating the event.
  clientSignalId     String?  @unique

  @@index([clerkUserId, opportunityId, createdAt])
  @@index([opportunityId])
  @@index([createdAt])
  @@index([clerkUserId, surface, createdAt])
}

model Recognition {
  id              String       @id @default(uuid()) @db.Uuid
  recognitionId   String       @unique
  subjectId       String
  employerId      String
  recognizedAt    DateTime
  verifiedAt      DateTime
  verificationRef String
  expiresAt       DateTime?
  revokedAt       DateTime?
  revocationRef   String?
  eventHash       String
  createdAt       DateTime     @default(now())
  acceptances     Acceptance[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
}

model Acceptance {
  id            String      @id @default(uuid()) @db.Uuid
  acceptanceId  String      @unique
  recognitionId String
  subjectId     String
  employerId    String
  facilityId    String
  acceptedAt    DateTime
  psvReportId   String
  eventHash     String
  createdAt     DateTime    @default(now())
  recognition   Recognition @relation(fields: [recognitionId], references: [recognitionId])
  starts        Start[]

  @@index([subjectId])
  @@index([employerId])
  @@index([recognitionId])
  @@index([acceptanceId])
}

model Start {
  id           String     @id @default(uuid()) @db.Uuid
  startId      String     @unique
  acceptanceId String
  subjectId    String
  employerId   String
  attestedAt   DateTime
  eventHash    String
  createdAt    DateTime   @default(now())
  acceptance   Acceptance @relation(fields: [acceptanceId], references: [acceptanceId])

  @@index([subjectId])
  @@index([employerId])
  @@index([acceptanceId])
  @@index([startId])
}

model PsvReceipt {
  id                    String   @id @default(uuid()) @db.Uuid
  receiptId             String   @unique
  clinicianId           String
  sourceAuthority       String
  licenseId             String
  transactionId         String
  fetchedAt             DateTime
  responseHash          String
  ttlSeconds            Int
  revoked               Boolean  @default(false)
  lane                  String?
  verificationCheck     String?
  verificationOutcome   String?
  failureReason         String?
  source                String?
  attestorId            String?
  verificationRequestId String?
  createdAt             DateTime @default(now())

  @@index([clinicianId])
  @@index([receiptId])
}

model ClinicianIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  clinicianId String   @unique
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NpiDidBinding {
  id                String              @id @default(uuid()) @db.Uuid
  npi               String              @unique
  did               String              @unique
  sourceFingerprint String
  recipeVersion     String              @default("1.0.0")
  evidencePointers  Json
  status            NpiDidBindingStatus @default(ACTIVE)
  contestReason     String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([npi])
  @@index([did])
  @@map("npi_did_binding")
}

model CandidateCredential {
  id                    String   @id @default(uuid()) @db.Uuid
  candidateCredentialId String   @unique
  clinicianId           String
  data                  Json
  status                String   @default("UNVERIFIED")
  createdAt             DateTime @default(now())

  @@index([clinicianId])
}

model IngestConflict {
  id          String   @id @default(uuid()) @db.Uuid
  conflictId  String   @unique
  clinicianId String
  status      String   @default("UNRESOLVED")
  data        Json
  createdAt   DateTime @default(now())

  @@index([clinicianId])
}

model IdempotentResponse {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  auditRef  String
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([key])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  keyHash     String    @unique
  orgName     String
  orgId       String
  permissions String[]  @default(["write:recognitions", "write:acceptances", "write:starts", "write:ingest"])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([orgId])
}

model ParRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  requestUri          String   @unique
  requestType         String
  requestJson         Json
  clientId            String
  codeChallenge       String?
  codeChallengeMethod String?
  redirectUri         String?
  scope               String?
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([requestType])
  @@index([expiresAt])
  @@index([createdAt])
}

model JtiReplay {
  service   String
  jti       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([service, jti])
  @@index([expiresAt])
}

model RefreshToken {
  tokenId    String   @id
  clientId   String?
  userId     String?
  scope      String
  cnfJkt     String?
  clientCert String?
  issuedAt   DateTime
  expiresAt  DateTime
  rotated    Boolean  @default(false)
  rotatedTo  String?
}

model VerifierNonce {
  nonce     String   @id
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([used])
  @@index([expiresAt])
}

model VerificationRequest {
  requestId     String                    @id @default(uuid()) @db.Uuid
  clinicianId   String
  lane          String
  source        String
  attestorId    String?
  documentHash  String?
  subject       String
  status        VerificationRequestStatus @default(PENDING)
  createdAt     DateTime                  @default(now())
  completedAt   DateTime?
  receiptId     String?
  failureReason String?

  // Start Mission linkage. Nullable preserves every legacy manual PSV request.
  applicationId           String?  @map("application_id") @db.Uuid
  startActivationId       String?  @map("start_activation_id") @db.Uuid
  activationRequirementId String?  @map("activation_requirement_id") @db.Uuid
  organizationId          String?  @map("organization_id") @db.Uuid
  issuerId                String?  @map("issuer_id")
  requestedClaim          String?  @map("requested_claim")
  purpose                 String?
  authorizationConsentId  String?  @map("authorization_consent_id") @db.Uuid
  preferredChannel        String?  @map("preferred_channel")
  dueAt                   DateTime? @map("due_at")
  nextFollowUpAt          DateTime? @map("next_follow_up_at")
  attemptCount            Int      @default(0) @map("attempt_count")
  assignedTo              String?  @map("assigned_to")
  idempotencyKey          String?  @unique @map("idempotency_key")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([clinicianId])
  @@index([status])
  @@index([createdAt])
  @@index([applicationId, status])
  @@index([startActivationId, status])
  @@index([activationRequirementId])
  @@index([issuerId, status])
  @@index([nextFollowUpAt, status])
}

model ShareLink {
  id             String    @id @default(uuid()) @db.Uuid
  npi            String
  firstViewedAt  DateTime?
  createdAt      DateTime  @default(now())
  organizationId String?   @db.Uuid

  @@index([npi])
  @@index([organizationId])
  @@index([createdAt])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  opportunities Opportunity[]
  organizationProfile OrganizationProfile?
}

model Opportunity {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  title            String
  specialty        String
  hiringType       String   @map("hiring_type")
  state            String
  payRange         String?  @map("pay_range")
  // Structured matching inputs — the MATCHA engine scores comp (payMax vs the
  // clinician's desired minimum), urgency (startUrgency), and employer-fit
  // (employerType). Nullable so the mapper falls back to defaults for older
  // postings that predate these columns.
  payMin           Int?     @map("pay_min")
  payMax           Int?     @map("pay_max")
  employerType     String?  @map("employer_type")
  startUrgency     String?  @map("start_urgency")
  requirementLevel String   @default("L1") @map("requirement_level")
  description      String?
  remote           Boolean  @default(false)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  /// Where this listing came from. 'employer_posted' means an employer who
  /// claimed a Type 2 NPI wrote it; 'public_feed' means it was copied from a
  /// public feed and NOBODY at that employer has stated anything to VitalCV.
  /// The read path branches on this so feed rows never claim employer-backed
  /// provenance, and never publish derived guesses as employer requirements.
  listingSource    String    @default("employer_posted") @map("listing_source")
  sourceFeed       String?   @map("source_feed")
  sourceRef        String?   @map("source_ref")
  sourceUrl        String?   @map("source_url")
  /// When the feed was last read. A fetch time, never a verification time.
  fetchedAt        DateTime? @map("fetched_at")
  /// Weighted tsvector over title/specialty/description, GENERATED ALWAYS by
  /// Postgres (migration 20260802000000_opportunity_search). Prisma cannot
  /// express a generated column, so it is Unsupported and never written from
  /// application code — read via $queryRaw with websearch_to_tsquery.
  searchVector     Unsupported("tsvector")? @map("search_vector")
  applications     Application[]
  organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([specialty, state])
  @@index([status])
  /// The public board's real access path: WHERE status = 'ACTIVE'
  /// ORDER BY updated_at DESC, created_at DESC.
  @@index([status, updatedAt(sort: Desc), createdAt(sort: Desc)], map: "Opportunity_status_updated_at_idx")
  /// Idempotency key for ingestion — re-running a feed updates, never duplicates.
  /// Not partial: a partial unique index cannot serve Prisma's ON CONFLICT
  /// target (Postgres 42P10). Employer-posted rows hold (NULL, NULL) and NULLs
  /// are distinct in a unique index, so they never collide regardless.
  @@unique([sourceFeed, sourceRef], map: "Opportunity_source_feed_ref_key")
  @@index([status, listingSource], map: "Opportunity_status_listing_source_idx")
}

/// Linked profile for an individual clinician (Type 1 NPI)
model PersonProfile {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  npi               String?            @unique
  npiType           NpiType?           @default(TYPE_1) @map("npi_type")
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  specialty         String?
  stateOfPractice   String?            @map("state_of_practice")
  workAuthStatus    String?            @map("work_auth_status")
  resumeUrl         String?            @map("resume_url")
  linkedinUrl       String?            @map("linkedin_url")
  portfolioUrl      String?            @map("portfolio_url")
  // Self-attested onboarding claims — the clinician stated these; they are NOT
  // source-verified. Kept distinct from source-checked facts (readiness lane).
  profession          String?          @map("profession")
  attestedAt          DateTime?        @map("attested_at")
  attestationVersion  String?          @map("attestation_version")
  // Identity-binding corroboration: a work/institutional email the clinician
  // proved possession of via OTP. A possession SIGNAL that strengthens NPI→person
  // binding — not a license or identity verification on its own.
  verifiedEmail       String?          @map("verified_email")
  verifiedEmailAt     DateTime?        @map("verified_email_at")
  // Self-attested structured profile sections (contact, education, work
  // history, affiliations, career goals, research). The clinician typed these;
  // they are USER_ENTERED and NEVER source-verified. Stored as a single JSON
  // document so the whole self-attested layer moves as one edit. Source-checked
  // facts (NPPES / licensure / board) live elsewhere with their own receipts.
  selfAttested        Json?            @map("self_attested")
  completeness      Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  providerLocations ProviderLocation[]

  @@index([npi])
  @@index([userId])
  @@map("person_profiles")
}

/// One-time email verification challenge (identity-binding possession factor).
/// The code is never stored — only a salted hash. Short-lived, attempt-capped,
/// single-use. A verified challenge records a possession signal on the
/// PersonProfile (verified_email) and a hashed audit row.
model EmailOtp {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  email      String
  codeHash   String    @map("code_hash")
  salt       String
  purpose    String    @default("identity_email")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([email])
  @@map("email_otps")
}

/// Linked profile for an organization (Type 2 NPI or Org DID)
model OrganizationProfile {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @unique @map("organization_id") @db.Uuid
  organization          Organization         @relation(fields: [organizationId], references: [id])
  npi                   String?
  npiType               NpiType?             @default(TYPE_2) @map("npi_type")
  orgDid                String?              @map("org_did")
  facilityType          String?              @map("facility_type")
  specialties           String[]
  statesCovered         String[]             @map("states_covered")
  website               String?
  tagline               String?
  description           String?
  trustScore            Int                  @default(0) @map("trust_score")
  openRoles             Int                  @default(0) @map("open_roles")
  recentHires           Int                  @default(0) @map("recent_hires")
  hiringStatus          EmployerHiringStatus @default(NOT_HIRING) @map("hiring_status")
  hiringTypes           String[]             @map("hiring_types")
  timeToStart           String?              @map("time_to_start")
  timeToOnboard         String?              @map("time_to_onboard")
  clearToStartThreshold String?              @map("clear_to_start_threshold")
  payTransparency       Boolean              @default(false) @map("pay_transparency")
  payRange              String?              @map("pay_range")
  requirements          Json                 @default("[]")
  verifiedSince         DateTime?            @map("verified_since")
  verified              Boolean              @default(false)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  institution           Institution?

  @@index([npi])
  @@index([organizationId])
  @@index([hiringStatus])
  @@index([trustScore])
  @@map("organization_profiles")
}

model Institution {
  id                    String               @id @default(uuid()) @db.Uuid
  vcvEntityId           String?              @unique @map("vcv_entity_id") @db.Uuid
  organizationProfileId String?              @unique @map("organization_profile_id") @db.Uuid
  educationRecords      VcvEducationRecord[] @relation("EducationInstitution")
  canonicalName         String               @map("canonical_name")
  slug                  String               @unique
  rorId                 String?              @unique @map("ror_id")
  addressLine1          String?              @map("address_line1")
  addressLine2          String?              @map("address_line2")
  city                  String?
  stateCode             String?              @map("state_code")
  postalCode            String?              @map("postal_code")
  countryCode           String               @default("US") @map("country_code")
  latitude              Decimal?             @db.Decimal(9, 6)
  longitude             Decimal?             @db.Decimal(9, 6)
  geocodeStatus         GeocodeStatus        @default(PENDING) @map("geocode_status")
  geocodePrecision      GeocodePrecision     @default(UNRESOLVED) @map("geocode_precision")
  geocodeSource         String?              @map("geocode_source")
  geocodeAttempts       Int                  @default(0) @map("geocode_attempts")
  lastGeocodedAt        DateTime?            @map("last_geocoded_at")
  lastGeocodeError      String?              @map("last_geocode_error")
  metadata              Json                 @default("{}")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  organizationProfile   OrganizationProfile? @relation(fields: [organizationProfileId], references: [id])
  vcvEntity             VcvEntity?           @relation(fields: [vcvEntityId], references: [id])

  @@index([latitude, longitude])
  @@index([stateCode, postalCode])
  @@index([canonicalName])
  @@index([geocodeStatus, updatedAt])
  @@map("institutions")
}

model ProviderLocation {
  id                  String                       @id @default(uuid()) @db.Uuid
  subjectNpi          String                       @map("subject_npi")
  personProfileId     String?                      @map("person_profile_id") @db.Uuid
  claimRecordId       String?                      @unique @map("claim_record_id") @db.Uuid
  locationType        ProviderLocationType         @default(PRACTICE) @map("location_type")
  isCurrent           Boolean                      @default(true) @map("is_current")
  sourceId            String                       @map("source_id")
  trustTier           String                       @map("trust_tier")
  confidenceScore     Float                        @map("confidence_score")
  addressHash         String                       @map("address_hash")
  addressLine1        String?                      @map("address_line1")
  addressLine2        String?                      @map("address_line2")
  city                String?
  stateCode           String?                      @map("state_code")
