// Prisma schema for Chai VC Platform with database seeding support
// Defines User, Credential, and Job models for comprehensive GraphQL operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  passwordHash String?
  credentials Credential[]
  jobs        Job[]
  applications Application[]
}

model Credential {
  id       Int      @id @default(autoincrement())
  name     String
  issuer   String
  issuedAt DateTime @default(now())
  expiresAt DateTime?
  user     User     @relation(fields: [userId], references: [id])
  userId   Int
}

model AuditEvent {
  id           Int      @id @default(autoincrement())
  type         String
  hash         String
  credentialId String?
  userId       Int?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Job {
  id     Int    @id @default(autoincrement())
  title  String
  user   User   @relation(fields: [userId], references: [id])
  userId Int
  applications Application[]
}

model Application {
  id           Int                 @id @default(autoincrement())
  clinician    User                @relation(fields: [clinicianId], references: [id])
  clinicianId  Int
  job          Job                 @relation(fields: [jobId], references: [id])
  jobId        Int
  report       ApplicationReport?
  createdAt    DateTime            @default(now())
}

model ApplicationReport {
  id             String      @id @default(uuid())
  application    Application @relation(fields: [applicationId], references: [id])
  applicationId  Int         @unique
  summary        Json
  createdAt      DateTime    @default(now())
}
