# Production backend environment defaults.
# Deployment secrets should come from the runtime environment, not git.

# Required:
# DATABASE_URL=postgresql://db.example.com:5432/vitalcv
# CORS_ORIGIN=https://vitalcv.com
# API_KEYS=replace-with-production-key

# Anchor witness (optional — dark until set). When enabled, each 5-minute
# Merkle batch root is published to external append-only observers so
# VitalCV cannot rewrite or backdate its own receipt history.
# ANCHOR_WITNESS_ENABLED=true
# ANCHOR_WITNESS_SIGNING_KEY=-----BEGIN PRIVATE KEY-----...  (ES256/P-256 PKCS8; dedicated witness key, NOT the receipt key)
# ANCHOR_WITNESS_REKOR_URL=https://rekor.sigstore.dev
# ANCHOR_WITNESS_TSA_URL=http://timestamp.digicert.com
