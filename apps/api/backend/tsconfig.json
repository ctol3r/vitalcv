{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts", "routes/**/*.ts", "repositories/**/*.ts"],
  "exclude": ["__tests__", "src/blockchain", "src/graphql", "src/graph"]
}
