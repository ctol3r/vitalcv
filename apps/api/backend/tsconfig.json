{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "5.0",
    "strict": true,

    "rootDir": "../../..",
    "baseUrl": "../../..",

    "paths": {
      "@vitalcv/command-registry": ["packages/command-registry/src/index"],
      "@vitalcv/domain/*": ["packages/domain/*"],
      "@vitalcv/domain-common": ["packages/domain-common/src"],
      "@vitalcv/psv": ["packages/psv"],
      "@vitalcv/psv/*": ["packages/psv/*"],
      "@vitalcv/psv-adapters": ["packages/psv-adapters"],
      "@vitalcv/psv-adapters/*": ["packages/psv-adapters/*"],
      "@vitalcv/crs": ["packages/crs"],
      "@vitalcv/crs/*": ["packages/crs/*"],
      "@vitalcv/trust-state/*": ["packages/trust-state/*"],
      "@vitalcv/audit/*": ["packages/audit/*"],
      "@vitalcv/haip-config": ["packages/haip-config"],
      "@vitalcv/shared/*": ["packages/shared/*"]
    },

    "types": ["node", "jest"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["src", "jobs", "adapters", "types", "routes", "../../../packages/ingest/**/*.ts", "../../../packages/psv/**/*.ts", "../../../packages/psv-adapters/**/*.ts", "../../../packages/command-registry/**/*.ts", "../../../packages/crs/**/*.ts", "../../../packages/haip-config/**/*.ts", "../../../packages/shared/**/*.ts", "../../../packages/domain/**/*.ts", "../../../packages/domain-common/**/*.ts", "../../../packages/trust-state/**/*.ts", "../../../packages/audit/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/blockchain/**",
    "src/graphql/**",
    "routes/*.disabled.ts",
    "../../../packages/**/__tests__/**",
    "../../../packages/**/*.test.ts",
    "../../../packages/**/*.spec.ts"
  ]
}
