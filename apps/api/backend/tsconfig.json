{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "5.0",
    "strict": true,

    "rootDir": "../../..",
    "baseUrl": "../../..",

    "paths": {
      "@vitalcv/command-registry": ["packages/command-registry/src/index"],
      "@vitalcv/domain": ["packages/domain/index.ts"],
      "@vitalcv/domain/*": ["packages/domain/*"],
      "@vitalcv/domain-core": ["packages/domain-core/index.ts"],
      "@vitalcv/domain-events": ["packages/domain-events/index.ts"],
      "@vitalcv/domain-common": ["packages/domain-common/index.ts"],
      "@vitalcv/ingest": ["packages/ingest/index.ts"],
      "@vitalcv/psv": ["packages/psv"],
      "@vitalcv/psv/*": ["packages/psv/*"],
      "@vitalcv/psv-adapters": ["packages/psv-adapters"],
      "@vitalcv/psv-adapters/*": ["packages/psv-adapters/*"],
      "@vitalcv/crs": ["packages/crs"],
      "@vitalcv/crs/*": ["packages/crs/*"],
      "@vitalcv/trust-state": ["packages/trust-state/index.ts"],
      "@vitalcv/trust-state/*": ["packages/trust-state/*"],
      "@vitalcv/audit": ["packages/audit/index.ts"],
      "@vitalcv/audit/*": ["packages/audit/*"],
      "@vitalcv/haip-config": ["packages/haip-config"],
      "@vitalcv/shared/*": ["packages/shared/*"]
    },

    "types": ["node", "jest"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["src", "jobs", "adapters", "types", "routes"],
  "exclude": [
    "node_modules",
    "src/blockchain/**",
    "src/graphql/**",
    "routes/*.disabled.ts"
  ]
}
