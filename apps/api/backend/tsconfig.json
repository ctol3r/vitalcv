{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,

    "rootDir": "../../..",
    "baseUrl": "../../..",

    "paths": {
      "@vitalcv/domain/*": ["packages/domain/*"],
      "@vitalcv/domain-common": ["packages/domain-common/src"],
      "@vitalcv/psv/*": ["packages/psv/*"],
      "@vitalcv/crs/*": ["packages/crs/*"],
      "@vitalcv/trust-state/*": ["packages/trust-state/*"],
      "@vitalcv/audit/*": ["packages/audit/*"]
    },

    "types": ["node", "jest"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/blockchain/**",
    "src/graphql/**",
    "routes/*.disabled.ts"
  ]
}
