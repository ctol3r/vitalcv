# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vitalcv_dev

# Server
PORT=4000
NODE_ENV=development

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=http://localhost:3000

# API Keys (comma-separated, required in production)
API_KEYS=

# Controls enterprise diagnostics surfaces and internal enterprise endpoints.
ENTERPRISE_MODE=false

# Rate Limiting
TRUST_STATE_RATE_LIMIT_PER_MINUTE=120

# Sentry (optional)
SENTRY_DSN=
