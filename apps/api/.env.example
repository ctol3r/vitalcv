# PostgreSQL (Railway provides this automatically)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vitalcv_dev

# Server
PORT=4000
NODE_ENV=development

# CORS (comma-separated origins; must NOT be * in production)
CORS_ORIGIN=http://localhost:3000

# API Keys (comma-separated, required in production)
API_KEYS=

# ES256 Signing Keys (base64-encoded PKCS8/SPKI)
# Required for JWKS endpoint and artifact signing
VCV_PRIVATE_KEY=
VCV_PUBLIC_KEY=

# PSV Engine signing keys (falls back to VCV_PRIVATE_KEY/VCV_PUBLIC_KEY)
PSV_SIGNING_KEY=
PSV_PUBLIC_KEY=

# Feature Flags (required in production)
PILOT_MODE=false
YC_DEMO_MODE=false
ENTERPRISE_MODE=false

# Internal dashboard password (required in production)
INTERNAL_DASH_PASSWORD=

# Monitoring secret (required in production)
MONITORING_SECRET=

# Rate Limiting
TRUST_STATE_RATE_LIMIT_PER_MINUTE=120

# Sentry (optional)
SENTRY_DSN=
