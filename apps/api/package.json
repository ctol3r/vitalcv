{
  "name": "@vitalcv/api",
  "version": "1.0.0",
  "description": "End-to-end healthcare credentialing and hiring verification.",
  "main": "index.js",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "build": "pnpm exec prisma generate --schema backend/prisma/schema.prisma && tsc -p backend/tsconfig.json",
    "start": "npm --prefix backend run start",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy --schema backend/prisma/schema.prisma",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "test:did": "node --test backend/__tests__/cross_chain_did_resolver.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "prisma": "^6.19.2",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.8",
    "ethers": "^5.8.0",
    "hardhat": "^2.25.0",
    "solc": "^0.8.20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@vitalcv/haip-config": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.5.0",
    "@opentelemetry/core": "^2.5.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-trace-base": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@openzeppelin/contracts": "^5.3.0",
    "@sentry/node": "^10.38.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  }
}
