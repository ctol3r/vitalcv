# Chai VC Platform - Environment Variables
# Copy this file to .env.local and update values as needed

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
# For Docker Compose dev setup, use: postgresql://postgres:postgres@localhost:5432/chai_vc_dev?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chai_vc_dev?schema=public

# ============================================
# Redis Configuration
# ============================================
# Redis connection string for caching
# For Docker Compose dev setup, use: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# Server Configuration
# ============================================
# Port for the API server
PORT=4000

# Node environment: development, production, test
NODE_ENV=development

# CORS origin (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# ============================================
# Security & Signing
# ============================================
# JWT signing key (for credential signing, tokens, etc.)
# IMPORTANT: Change this to a secure random string in production!
# Generate with: openssl rand -hex 32
SIGNING_KEY=dev-signing-key-change-in-production-please-use-openssl-rand-hex-32

# ============================================
# Demo & Development Flags
# ============================================
# Enable demo mode (true/false)
# When true, enables demo features and relaxed validation
DEMO_MODE=true

# Enable demo seed on startup (true/false)
# When true, automatically seeds demo data when starting the server
ENABLE_DEMO_SEED=true

# ============================================
# External Services (Optional)
# ============================================
# NPPES API base URL (for NPI lookups)
NPPES_API_BASE=https://npiregistry.cms.hhs.gov

# NPPES proxy URL (optional, for internal proxy usage)
NPPES_PROXY_URL=

# ============================================
# OpenAI Configuration (Optional)
# ============================================
# OpenAI API key for agent features
# Leave empty to use fallback mode
OPENAI_API_KEY=

# OpenAI model for agent tasks
AGENT_MODEL=gpt-4o-mini

# Embedding model for vector search
EMBED_MODEL=text-embedding-3-small

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Log format: json, plain
# JSON format is recommended for production and structured logging
LOG_FORMAT=json

# ============================================
# Vector Store (Optional)
# ============================================
# Vector backend: memory, pgvector, qdrant
# memory = in-memory (not persistent)
# pgvector = PostgreSQL with pgvector extension
# qdrant = Qdrant vector database
MCP_VECTOR_BACKEND=memory

# PgVector dimensions (must match embedding model dimensions)
PGVECTOR_DIM=1536

# Qdrant configuration (if using Qdrant backend)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================
# Substrate/Blockchain (Optional)
# ============================================
# Substrate WebSocket endpoint
# Leave empty to disable blockchain features
SUBSTRATE_WS=

# ============================================
# Application-Specific
# ============================================
# Backend base URL (for generating absolute URLs in responses)
BACKEND_BASE_URL=http://localhost:4000

# Frontend base URL (for CORS and redirects)
FRONTEND_BASE_URL=http://localhost:3000
