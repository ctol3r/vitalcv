{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "../../../dist/apps/api",
    "tsBuildInfoFile": "../../../build-info/apps-api.tsbuildinfo",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/*"],
      "@packages/*": ["../../../packages/*/src", "../../../packages/*"],
      "@schemas/*": ["../../../packages/vc-schemas/src/*"],
      "@shared-utils/*": ["../../../packages/shared-utils/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "jobs/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__/**/*",
    "**/*.spec.ts"
  ]
}
