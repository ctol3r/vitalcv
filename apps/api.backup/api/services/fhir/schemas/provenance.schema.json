{
  "$id": "https://chai-vc.com/fhir/schemas/provenance",
  "type": "object",
  "required": ["resourceType", "id", "recorded", "target", "agent"],
  "properties": {
    "resourceType": {
      "const": "Provenance"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recorded": {
      "type": "string",
      "format": "date-time"
    },
    "occurredDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reference"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "display": { "type": "string" }
        }
      }
    },
    "activity": { "$ref": "#/definitions/codeableConcept" },
    "reason": {
      "type": "array",
      "items": { "$ref": "#/definitions/codeableConcept" }
    },
    "agent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["who"],
        "properties": {
          "type": { "$ref": "#/definitions/codeableConcept" },
          "role": {
            "type": "array",
            "items": { "$ref": "#/definitions/codeableConcept" }
          },
          "who": {
            "type": "object",
            "properties": {
              "reference": { "type": "string" },
              "display": { "type": "string" }
            },
            "anyOf": [
              { "required": ["reference"] },
              { "required": ["display"] }
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "coding": {
      "type": "object",
      "required": ["system", "code"],
      "properties": {
        "system": { "type": "string" },
        "code": { "type": "string" },
        "display": { "type": "string" }
      }
    },
    "codeableConcept": {
      "type": "object",
      "properties": {
        "coding": {
          "type": "array",
          "items": { "$ref": "#/definitions/coding" }
        },
        "text": { "type": "string" }
      }
    }
  }
}

