    "@types/nodemailer": "^7.0.3",
    "@vitalcv/messaging-guard": "workspace:*",
    "@vitalcv/shared-utils": "workspace:*",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dayjs": "^1.11.19",
    "express": "^4.18.2",
    "ics": "^3.7.2",
    "jose": "^6.1.0",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.10",
    "pg": "^8.11.3",
    "puppeteer": "^21.11.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.16.0",
    "zod": "^4.1.12"
