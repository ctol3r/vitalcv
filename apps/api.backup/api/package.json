    "@types/node-fetch": "^2.6.9",
    "@types/pg": "^8.10.9",
    "@types/ws": "^8.5.10",
    "chai": "^4.3.10",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
