  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "seed:compacts": "ts-node scripts/load_compacts.ts",
    "seed:rules": "ts-node scripts/load_state_rules.ts",
    "etl:residency": "ts-node scripts/etl_residency.ts",
    "etl:qa": "ts-node scripts/etl_residency_qa.ts",
    "pecos:ics": "ts-node scripts/pecos_calendar.ts",
    "pecos:slack": "ts-node scripts/pecos_slack.ts",
    "canary": "ts-node scripts/anchor_canary.ts",
    "cron:pecos": "ts-node src/cron/pecos_alerts.ts",
    "cron:nlc": "ts-node src/cron/nlc_alerts.ts",
    "smoke": "ts-node scripts/smoke_test.ts",
    "seed:sample": "ts-node scripts/seed_sample_data.ts",
    "seed:evidence": "ts-node scripts/seed_evidence.ts",
    "test": "jest",
