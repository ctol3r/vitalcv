{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["build:packages", "^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "build:packages": {
      "outputs": ["packages/**/dist/**", "build-info/**/*.tsbuildinfo"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}


