// VC2-004 — W3C VC StatusList v2.0 models for revocation
// StatusList v2 uses bitstring-based revocation (https://www.w3.org/TR/vc-status-list-2021/)
model CredentialStatusList {
  id              String   @id @default(cuid())
  issuerId        String   // Issuer organization ID
  purpose         String   // "revocation" | "suspension"
  statusListIndex Int      // Position in the bitstring
  bitstring       String   @db.Text // Base64-encoded bitstring (compressed)
  size            Int      // Total number of credentials in this list
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  entries         CredentialStatusEntry[]

  @@index([issuerId, purpose])
  @@index([statusListIndex])
  @@index([validFrom])
  @@unique([issuerId, purpose, statusListIndex])
}

model CredentialStatusEntry {
  id                String   @id @default(cuid())
  credentialId      String   // VC credential ID
  statusListId      String
  statusList        CredentialStatusList @relation(fields: [statusListId], references: [id], onDelete: Cascade)
  bitIndex          Int      // Position in the bitstring (0-based)
  revoked           Boolean  @default(false)
  revokedAt         DateTime?
  reason            String?   // Optional revocation reason
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([credentialId])
  @@index([statusListId, bitIndex])
  @@index([revoked])
  @@index([revokedAt])
  @@unique([credentialId, statusListId])
}

// Peppered hash records for GDPR-compliant on-chain anchoring (VC2-006)
model PepperedHash {
  id              String   @id @default(cuid())
  pepper          String   // High-entropy random value (32 bytes, base64url)
  targetHash      String   // SHA-256(identifier + pepper)
  identifierType  String   // "credentialId" | "subjectDid" | "npi" | "custom"
  identifier      String?  // Original identifier (encrypted or null for privacy)
  metadata        Json?
  createdAt       DateTime @default(now())
  deletedAt       DateTime? // GDPR erasure timestamp

  @@index([targetHash])
  @@index([identifierType])
  @@index([deletedAt])
  @@unique([targetHash, identifierType])
}
