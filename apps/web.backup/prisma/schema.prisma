model CommitteePacket {
  id                   String                @id @default(cuid())
  clinicianId          String
  clinician            ClinicianProfile      @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  packetId             String                @unique
  snapshotAt           DateTime              @default(now())
  status               CommitteePacketStatus @default(GENERATED)
  metadataHash         String
  storagePath          String
  snapshotSize         Int
  encryptionKeyVersion String                @default("v1")
  encryptionIv         String
  encryptionAuthTag    String
  anchorTxHash         String?
  anchoredAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([clinicianId, snapshotAt])
}

