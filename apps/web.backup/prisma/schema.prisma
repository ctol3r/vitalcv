model WorkforceSupplyNode {
  nodeId    String                 @id
  nodeType  WorkforceSupplyNodeType
  metadata  Json?
  createdAt DateTime               @default(now())

  outgoing WorkforceSupplyEdge[] @relation("WorkforceSupplyOutgoing")
  incoming WorkforceSupplyEdge[] @relation("WorkforceSupplyIncoming")

  @@index([nodeType])
}

model WorkforceSupplyEdge {
  sourceNodeId String
  targetNodeId String
  relationType WorkforceSupplyRelationType
  weight       Float    @default(1)
  metadata     Json?
  createdAt    DateTime @default(now())

  source WorkforceSupplyNode @relation("WorkforceSupplyOutgoing", fields: [sourceNodeId], references: [nodeId], onDelete: Cascade)
  target WorkforceSupplyNode @relation("WorkforceSupplyIncoming", fields: [targetNodeId], references: [nodeId], onDelete: Cascade)

  @@id([sourceNodeId, targetNodeId, relationType])
  @@index([relationType])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

