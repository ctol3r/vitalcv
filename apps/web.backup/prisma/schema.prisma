model PrivilegeSafetySignal {
  id                String                    @id @default(cuid())
  clinicianId       String
  clinician         ClinicianProfile          @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  signalType        PrivilegeSafetySignalType
  severity          PrivilegeSafetySeverity
  privilegeCodes    String[]                  @default([])
  summary           String                    @db.Text
  source            String
  sourceEventId     String?
  details           Json?
  recommendedAction String?
  detectedAt        DateTime                  @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([clinicianId, detectedAt])
  @@index([signalType])
  @@index([severity])
  @@index([resolvedAt])
  @@index([acknowledgedAt])
}

