enum TrustEntityType {
  ISSUER
  VERIFIER
  ORG
  STATE_BOARD
  PAYER
  COMPACT_AUTHORITY
}

enum AccreditationStatus {
  ACCREDITED
  PROBATION
  SUSPENDED
  REVOKED
  UNKNOWN
}

enum NCINodeType {
  CLINICIAN
  ISSUER
  VERIFIER
  STATE_BOARD
  PAYER
  ORG
  EHR_SYSTEM
  COMPACT_AUTHORITY
}

enum NCIVerifiableProofType {
  ISSUANCE
  VERIFICATION
  REVOCATION
}

// B200A-NCI: Node registry + trust anchors
model NCITrustAnchor {
  entityId         String              @id
  entityType       TrustEntityType
  publicKey        String
  certificateChain Json?
  accreditation    AccreditationStatus @default(UNKNOWN)
  jurisdiction     String?
  isActive         Boolean             @default(true)
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  nodes            NCINode[]

  @@index([entityType])
  @@index([jurisdiction])
  @@index([accreditation])
  @@index([isActive])
}

model NCINode {
  nodeId        String       @id @default(cuid())
  nodeType      NCINodeType
  did           String       @unique
  jurisdiction  String?
  metadata      Json?
  trustAnchorId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  trustAnchor   NCITrustAnchor? @relation(fields: [trustAnchorId], references: [entityId], onDelete: SetNull)
  proofs        NCIVerifiableProof[]

  @@index([nodeType])
  @@index([jurisdiction])
  @@index([trustAnchorId])
}

model NCIVerifiableProof {
  id           String                 @id @default(cuid())
  did          String
  proofType    NCIVerifiableProofType
  eventType    String
  payloadHash  String
  anchorTxHash String?
  chainId      String?
  metadata     Json?
  issuedFor    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  node         NCINode?               @relation(fields: [did], references: [did], onDelete: Cascade)

  @@unique([payloadHash, proofType])
  @@index([did])
  @@index([proofType])
  @@index([eventType])
  @@index([issuedFor])
}

