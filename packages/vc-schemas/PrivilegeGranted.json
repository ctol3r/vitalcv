{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitalcv.com/schemas/privilegeGranted/v1",
  "title": "Privilege Granted Credential",
  "description": "W3C Verifiable Credential schema for granted clinical privileges. Represents organizational approval for a clinician to perform specific procedures at a healthcare facility.",
  "type": "object",
  "required": [
    "@context",
    "type",
    "issuer",
    "issuanceDate",
    "credentialSubject",
    "proof"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "description": "JSON-LD context",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "contains": {
        "const": "https://www.w3.org/2018/credentials/v1"
      }
    },
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Unique identifier for this credential"
    },
    "type": {
      "type": "array",
      "description": "Credential type",
      "items": {
        "type": "string"
      },
      "contains": {
        "enum": ["VerifiableCredential", "PrivilegeGrantedCredential"]
      }
    },
    "issuer": {
      "description": "Organization DID that granted the privilege",
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "description": "Organization DID"
            },
            "name": {
              "type": "string",
              "description": "Organization name"
            },
            "npi": {
              "type": "string",
              "description": "Organization NPI (Type 2)"
            },
            "address": {
              "type": "object",
              "properties": {
                "street": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "zipCode": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "issuanceDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 date-time when the privilege was granted"
    },
    "expirationDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 date-time when the privilege expires (typically 1-2 years)"
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "privileges"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "description": "Clinician DID"
        },
        "name": {
          "type": "string",
          "description": "Clinician name"
        },
        "npi": {
          "type": "string",
          "description": "Clinician NPI (Type 1)",
          "pattern": "^[0-9]{10}$"
        },
        "privileges": {
          "type": "object",
          "required": ["privilegeSetId", "privilegeSetName", "department", "procedures"],
          "properties": {
            "privilegeSetId": {
              "type": "string",
              "description": "Unique ID of the privilege set"
            },
            "privilegeSetName": {
              "type": "string",
              "description": "Name of the privilege set (e.g., 'General Surgery Core Privileges')"
            },
            "department": {
              "type": "string",
              "description": "Clinical department (e.g., 'Surgery', 'Emergency Medicine')"
            },
            "procedures": {
              "type": "array",
              "description": "List of procedures the clinician is privileged to perform",
              "items": {
                "type": "object",
                "required": ["code", "name"],
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "Procedure code (CPT, ICD-10-PCS, or internal code)"
                  },
                  "name": {
                    "type": "string",
                    "description": "Procedure name"
                  },
                  "category": {
                    "type": "string",
                    "description": "Procedure category"
                  },
                  "restrictions": {
                    "type": "array",
                    "description": "Any restrictions or conditions on this procedure",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "restrictions": {
              "type": "array",
              "description": "General restrictions or conditions on privileges",
              "items": {
                "type": "string"
              }
            },
            "supervision": {
              "type": "object",
              "description": "Supervision requirements, if any",
              "properties": {
                "required": {
                  "type": "boolean",
                  "description": "Whether supervision is required"
                },
                "level": {
                  "type": "string",
                  "enum": ["direct", "indirect", "oversight"],
                  "description": "Level of supervision required"
                },
                "duration": {
                  "type": "string",
                  "description": "Duration of supervision requirement (e.g., '90 days', 'first 10 cases')"
                }
              }
            }
          }
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When privileges were granted"
        },
        "reviewedBy": {
          "type": "object",
          "description": "Reviewer information",
          "properties": {
            "did": {
              "type": "string",
              "format": "uri",
              "description": "Reviewer DID"
            },
            "name": {
              "type": "string",
              "description": "Reviewer name"
            },
            "title": {
              "type": "string",
              "description": "Reviewer title (e.g., 'Chief of Surgery')"
            }
          }
        },
        "fppeRequired": {
          "type": "boolean",
          "description": "Whether Focused Professional Practice Evaluation (FPPE) is required"
        },
        "oppeRequired": {
          "type": "boolean",
          "description": "Whether Ongoing Professional Practice Evaluation (OPPE) is required"
        },
        "oppeIntervalMonths": {
          "type": "integer",
          "description": "How often OPPE reviews occur (in months)",
          "minimum": 1,
          "maximum": 24
        },
        "timeline": {
          "type": "object",
          "description": "Timeline information",
          "properties": {
            "effectiveDate": {
              "type": "string",
              "format": "date",
              "description": "When privileges become effective"
            },
            "expirationDate": {
              "type": "string",
              "format": "date",
              "description": "When privileges expire"
            },
            "renewalDueDate": {
              "type": "string",
              "format": "date",
              "description": "When renewal application is due"
            }
          }
        },
        "requirements": {
          "type": "object",
          "description": "Requirements that were met to grant this privilege",
          "properties": {
            "boardCertification": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "board": { "type": "string" },
                  "specialty": { "type": "string" },
                  "certificationDate": { "type": "string", "format": "date" }
                }
              }
            },
            "trainingHours": {
              "type": "integer",
              "description": "Training hours completed"
            },
            "yearsExperience": {
              "type": "number",
              "description": "Years of experience in specialty"
            },
            "licenses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "state": { "type": "string" },
                  "licenseNumber": { "type": "string" },
                  "status": { "type": "string" },
                  "expirationDate": { "type": "string", "format": "date" }
                }
              }
            },
            "npdbClean": {
              "type": "boolean",
              "description": "NPDB check was clean"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Evidence credentials used to support this privilege grant",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uri",
            "description": "Evidence credential ID or URI"
          },
          "type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Type of evidence credential"
          },
          "hash": {
            "type": "string",
            "description": "SHA-256 hash of the evidence credential"
          }
        }
      }
    },
    "proof": {
      "description": "Cryptographic proof (signature) from the issuing organization",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "created", "proofPurpose", "verificationMethod", "jws"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["Ed25519Signature2020", "EcdsaSecp256k1Signature2019"]
            },
            "created": {
              "type": "string",
              "format": "date-time"
            },
            "proofPurpose": {
              "type": "string",
              "enum": ["assertionMethod"]
            },
            "verificationMethod": {
              "type": "string",
              "format": "uri",
              "description": "DID URL of the key used to sign"
            },
            "jws": {
              "type": "string",
              "description": "JWS detached signature"
            }
          }
        },
        {
          "type": "object",
          "description": "JWT proof",
          "required": ["type", "jwt"],
          "properties": {
            "type": {
              "const": "JwtProof2020"
            },
            "jwt": {
              "type": "string",
              "description": "JWT encoding of the credential"
            }
          }
        }
      ]
    },
    "chainAnchor": {
      "type": "object",
      "description": "Blockchain anchoring information",
      "properties": {
        "network": {
          "type": "string",
          "description": "Blockchain network (e.g., 'substrate', 'ethereum')"
        },
        "txHash": {
          "type": "string",
          "description": "Transaction hash where credential hash was anchored"
        },
        "blockNumber": {
          "type": "integer",
          "description": "Block number"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Block timestamp"
        }
      }
    },
    "refreshService": {
      "type": "object",
      "description": "Service endpoint for refreshing this credential",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "description": "URL to refresh the credential"
        },
        "type": {
          "const": "ManualRefreshService2018"
        }
      }
    },
    "termsOfUse": {
      "type": "array",
      "description": "Terms of use for this credential",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "examples": [
    {
      "@context": [
        "https://www.w3.org/2018/credentials/v1",
        "https://vitalcv.com/schemas/privilegeGranted/v1"
      ],
      "id": "https://hospital.example.org/credentials/privilege/12345",
      "type": ["VerifiableCredential", "PrivilegeGrantedCredential"],
      "issuer": {
        "id": "did:web:hospital.example.org",
        "name": "Example General Hospital",
        "npi": "1234567890"
      },
      "issuanceDate": "2025-01-15T10:00:00Z",
      "expirationDate": "2027-01-15T10:00:00Z",
      "credentialSubject": {
        "id": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK",
        "name": "Dr. Jane Smith",
        "npi": "9876543210",
        "privileges": {
          "privilegeSetId": "ps_abc123",
          "privilegeSetName": "General Surgery Core Privileges",
          "department": "Surgery",
          "procedures": [
            {
              "code": "44950",
              "name": "Appendectomy",
              "category": "General Surgery"
            },
            {
              "code": "49505",
              "name": "Inguinal Hernia Repair",
              "category": "General Surgery"
            }
          ]
        },
        "grantedAt": "2025-01-15T10:00:00Z",
        "fppeRequired": true,
        "oppeRequired": true,
        "oppeIntervalMonths": 12,
        "timeline": {
          "effectiveDate": "2025-01-20",
          "expirationDate": "2027-01-20",
          "renewalDueDate": "2026-10-20"
        }
      },
      "proof": {
        "type": "Ed25519Signature2020",
        "created": "2025-01-15T10:00:00Z",
        "proofPurpose": "assertionMethod",
        "verificationMethod": "did:web:hospital.example.org#key-1",
        "jws": "eyJhbGciOiJFZERTQSIsImI2NCI6ZmFsc2UsImNyaXQiOlsiYjY0Il19..example"
      }
    }
  ]
}

