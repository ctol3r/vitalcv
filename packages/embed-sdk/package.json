{
  "name": "@vitalcv/embed-sdk",
  "version": "1.0.0",
  "description": "VitalCV Embed SDK — mount the Apply with VitalCV widget on employer pages",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm,iife --global-name VitalCV --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["vitalcv", "embed", "widget", "hris", "ats"],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
