# local-host/.env.example
#
# Copy to local-host/.env and fill in values. See
# docs/architecture/production-env-requirements.md for the
# authoritative reference on each var.
#
# Required for production-shape startup:

RECEIPT_PRIVATE_KEY_JWK=
RECEIPT_KID=vcv-es256-1
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Recommended:

BACKEND_URL=
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_SENTRY_DSN=
VITALCV_ENV_LABEL=self-host

# Local Postgres (defaults work for the bundled service):

POSTGRES_USER=vitalcv
POSTGRES_PASSWORD=vitalcv
POSTGRES_DB=vitalcv
DATABASE_URL=postgresql://vitalcv:vitalcv@postgres:5432/vitalcv

# Optional — Cloudflare Tunnel (only if exposing via cloudflared):
# Get the token from `cloudflared tunnel create <name>` and the
# tunnel dashboard at https://one.dash.cloudflare.com → Access →
# Tunnels.

CLOUDFLARE_TUNNEL_TOKEN=
