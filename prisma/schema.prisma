// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with DID authentication support
model User {
  id            String   @id @default(uuid())
  did           String   @unique // Decentralized Identifier
  email         String?  @unique
  name          String?
  publicKey     String   // For DID verification
  walletAddress String?
  walletType    String?  // "metamask", "walletconnect", "universal-wallet"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  // Relations
  sessions          Session[]
  issuedCredentials Credential[] @relation("IssuerUser")
  ownedCredentials  Credential[] @relation("SubjectUser")
  verifications     Verification[]
  challenges        AuthChallenge[]

  @@index([did])
  @@index([email])
}

// Authentication challenges for DID authentication
model AuthChallenge {
  id         String   @id @default(uuid())
  userId     String
  challenge  String   @unique
  nonce      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challenge])
  @@index([expiresAt])
}

// Session management for authenticated users
model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  lastActive   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// Trusted issuer registry
model Issuer {
  id              String   @id @default(uuid())
  did             String   @unique
  name            String
  description     String?
  website         String?
  logoUrl         String?
  publicKey       String
  verified        Boolean  @default(false)
  trustLevel      String   @default("basic") // "basic", "verified", "trusted"
  supportedSchemas String[] // JSON array of supported credential types
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  credentials Credential[]

  @@index([did])
  @@index([verified])
}

// Credential schema/type definitions
model CredentialSchema {
  id          String   @id @default(uuid())
  type        String   @unique // "DriverLicense", "HealthPass", etc.
  name        String
  description String?
  version     String
  jsonSchema  Json     // JSON Schema definition
  privacy     String   @default("plain") // "plain", "bbs", "zkp"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  credentials Credential[]

  @@index([type])
  @@index([active])
}

// Verifiable credentials
model Credential {
  id                String   @id @default(uuid())
  credentialId      String   @unique // W3C VC ID
  schemaId          String
  issuerId          String
  issuerUserId      String?
  subjectId         String   // DID of credential subject
  subjectUserId     String?
  type              String   // Credential type
  credentialData    Json     // Full W3C VC JSON
  encryptedData     String?  // Encrypted sensitive fields
  proofType         String   // "Ed25519Signature2020", "BbsBlsSignature2020", etc.
  signatureValue    String
  issuedAt          DateTime
  expiresAt         DateTime?
  revoked           Boolean  @default(false)
  revokedAt         DateTime?
  revocationReason  String?
  statusListId      String?  // For status list credentials
  privacyMode       String   @default("plain") // "plain", "bbs", "zkp"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  schema        CredentialSchema @relation(fields: [schemaId], references: [id])
  issuer        Issuer           @relation(fields: [issuerId], references: [id])
  issuerUser    User?            @relation("IssuerUser", fields: [issuerUserId], references: [id])
  subjectUser   User?            @relation("SubjectUser", fields: [subjectUserId], references: [id])
  verifications Verification[]

  @@index([credentialId])
  @@index([schemaId])
  @@index([issuerId])
  @@index([subjectId])
  @@index([revoked])
  @@index([expiresAt])
}

// Verification audit trail
model Verification {
  id               String   @id @default(uuid())
  credentialId     String
  verifierId       String   // DID of verifier
  verifierUserId   String?
  challenge        String   // Verification challenge/nonce
  presentationType String   // "full", "selective", "zkp"
  revealedFields   String[] // Fields disclosed in selective disclosure
  result           String   // "valid", "invalid", "expired", "revoked"
  errorMessage     String?
  ipAddress        String?
  userAgent        String?
  location         Json?    // Geo data if available
  verifiedAt       DateTime @default(now())

  // Relations
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  verifierUser User?      @relation(fields: [verifierUserId], references: [id])

  @@index([credentialId])
  @@index([verifierId])
  @@index([verifiedAt])
  @@index([result])
}

// Performance metrics (Core Web Vitals)
model PerformanceMetric {
  id        String   @id @default(uuid())
  userId    String?
  metric    String   // "LCP", "FID", "CLS", "FCP", "TTFB"
  value     Float
  rating    String   // "good", "needs-improvement", "poor"
  url       String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([metric])
  @@index([createdAt])
  @@index([userId])
}

// Error tracking and monitoring
model ErrorLog {
  id         String   @id @default(uuid())
  userId     String?
  errorType  String   // "client", "server", "api", "validation"
  message    String
  stack      String?  @db.Text
  url        String?
  method     String?
  statusCode Int?
  userAgent  String?
  ipAddress  String?
  metadata   Json?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([errorType])
  @@index([createdAt])
  @@index([resolved])
}

// Rate limiting tracking
model RateLimit {
  id         String   @id @default(uuid())
  identifier String   // IP address or user ID
  endpoint   String
  count      Int      @default(1)
  windowStart DateTime
  windowEnd   DateTime
  blocked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([identifier, endpoint, windowStart])
  @@index([identifier])
  @@index([windowEnd])
}
