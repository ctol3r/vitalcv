{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marketing-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vitalcv/marketing", "dev"],
      "port": 3001
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-l", "-c", "pnpm --filter @vitalcv/web dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vitalcv/api", "dev"],
      "port": 4000
    },
    {
      "name": "web-dev-w12a",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-l", "-c", "cd /tmp/vitalcv-wave-12a && PORT=3010 pnpm --filter @vitalcv/web exec next dev -p 3010"],
      "port": 3010
    }
  ]
}
