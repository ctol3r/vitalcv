# Homepage layout-stability measurements. Regenerated by
# `tests/e2e/home-layout-stability.spec.ts`; the numbers are quoted in
# docs/design/home-evidence-v2-performance-report.md, which IS committed.
apps/web/artifacts/

# Generated review captures. Visual evidence lives in PR comments and CI
# artifacts, not in the repository.
# Root-only ON PURPOSE: the unanchored `artifacts/` matched at ANY depth,
# which included apps/web/components/artifacts — tracked application source.
# Git kept the files (tracked wins over ignore), but `railway up` walks the
# filesystem honoring these patterns and silently dropped them from the
# upload, so the preview build failed on modules that exist.
# `/artifacts/*` (children), NOT `/artifacts/` (the directory): gitignore
# cannot re-include anything inside an excluded directory, so the negations
# below only take effect if the directory itself stays unexcluded.
/artifacts/*

# Z0 review prototype SOURCE is tracked (small, reproducible); its rendered
# PNGs are not - they live on the never-merged review branch.
!/artifacts/zoox-fidelity-z0/
!/artifacts/zoox-fidelity-z0/**
/artifacts/zoox-fidelity-z0/**/*.png
/artifacts/zoox-fidelity-z0/**/*.woff2

# Tracked deploy-smoke evidence; same filesystem-walker exposure as above.
!/artifacts/audit/
!/artifacts/audit/**
