{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "../../dist/services",
    "tsBuildInfoFile": "../../build-info/services-compacts.tsbuildinfo"
  },
  "include": [
    "./**/*.ts",
    "../logging/**/*.ts",
    "../org/**/*.ts",
    "../common/**/*.ts",
    "../timeline/**/*.ts",
    "../credentialRisk/**/*.ts",
    "../notifications/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**/*",
    "**/*.spec.ts",
    "../**/__tests__/**/*"
  ]
}
