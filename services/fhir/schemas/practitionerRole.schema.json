{
  "$id": "https://schemas.vitalcv.health/fhir/r6/practitionerRole",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FHIR R6 PractitionerRole (Minimal Subset)",
  "type": "object",
  "required": ["resourceType", "id"],
  "properties": {
    "resourceType": { "const": "PractitionerRole" },
    "id": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" },
    "practitioner": {
      "type": "object",
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "display": { "type": "string" }
      },
      "additionalProperties": true
    },
    "organization": {
      "type": "object",
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "display": { "type": "string" }
      },
      "additionalProperties": true
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coding": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["system", "code"],
              "properties": {
                "system": { "type": "string" },
                "code": { "type": "string" },
                "display": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "text": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "specialty": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coding": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["system", "code"],
              "properties": {
                "system": { "type": "string" },
                "code": { "type": "string" },
                "display": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "text": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "location": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "display": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "telecom": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "value"],
        "properties": {
          "system": { "type": "string" },
          "value": { "type": "string" },
          "use": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "virtualService": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channelType": {
            "type": "object",
            "properties": {
              "coding": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "system": { "type": "string" },
                    "code": { "type": "string" },
                    "display": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "telecom": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "system": { "type": "string" },
                "value": { "type": "string" }
              },
              "required": ["system", "value"],
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "period": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}


